<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nextorm.examples.mssql.adventureworks</AssemblyName>
    <RootNamespace>NextORM.Examples.SqlServer.AdventureWorks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="linq2db.SqlServer" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Intentional exception to the other examples' published-package model (#232): this example
      demonstrates the current-checkout typed PIVOT/UNPIVOT surface, which is not in a published
      package yet, so it references the source projects instead of the `nextorm` NuGet metapackage.
    -->
    <ProjectReference Include="../../src/nextorm.core/nextorm.core.csproj" />
    <ProjectReference Include="../../src/nextorm.sqlserver/nextorm.sqlserver.csproj" />
    <ProjectReference Include="../../src/nextorm.core.sourcegenerator/nextorm.core.sourcegenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
