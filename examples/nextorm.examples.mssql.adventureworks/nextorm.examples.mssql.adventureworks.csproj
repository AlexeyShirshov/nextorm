<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nextorm.examples.mssql.adventureworks</AssemblyName>
    <RootNamespace>NextORM.Examples.SqlServer.AdventureWorks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="linq2db.SqlServer" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Intentional exception to the other examples' published-package model: this example tracks the
      current checkout so it exercises the PIVOT/UNPIVOT surface as it evolves. The typed overload
      itself has been shipped since 1.0.9 (issue #232, `nextorm.sqlserver`), so a published-package
      variant is possible now — see `examples/nextorm.aotexamples.mssql.adventureworks`.
    -->
    <ProjectReference Include="../../src/nextorm.core/nextorm.core.csproj" />
    <ProjectReference Include="../../src/nextorm.sqlserver/nextorm.sqlserver.csproj" />
    <ProjectReference Include="../../src/nextorm.core.sourcegenerator/nextorm.core.sourcegenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup><ProjectReference Include="../../src/nextorm.extensions/nextorm.extensions.csproj" /></ItemGroup>
</Project>
