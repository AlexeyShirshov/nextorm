<Project>

  <!--
    Nested Directory.Packages.props stops NuGet's upward search, so the repository-wide package
    versions must be imported explicitly.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Packages.props" />

  <PropertyGroup>
    <!--
      The runnable examples consume the published nextorm packages (not the source projects) so they
      double as a real consumer of what ships on nuget.org. Bump this after a release is published,
      to the version that was actually pushed (the git tag without the leading v).
    -->
    <NextOrmVersion>1.0.9-rc4</NextOrmVersion>
    <!-- Mirrors the `linq2db` version pinned in the repository-wide Directory.Packages.props. -->
    <Linq2DbVersion>6.5.0</Linq2DbVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="nextorm" Version="$(NextOrmVersion)" />
    <PackageVersion Include="nextorm.clickhouse" Version="$(NextOrmVersion)" />
    <PackageVersion Include="nextorm.postgres" Version="$(NextOrmVersion)" />
    <PackageVersion Include="nextorm.sqlserver" Version="$(NextOrmVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The comparison arm. The core `linq2db` and `BenchmarkDotNet` versions are pinned in the
      repository-wide Directory.Packages.props; only the provider packages are example-specific.
    -->
    <PackageVersion Include="linq2db.ClickHouse" Version="$(Linq2DbVersion)" />
    <PackageVersion Include="linq2db.PostgreSQL" Version="$(Linq2DbVersion)" />
    <PackageVersion Include="linq2db.SqlServer" Version="$(Linq2DbVersion)" />
  </ItemGroup>

</Project>
