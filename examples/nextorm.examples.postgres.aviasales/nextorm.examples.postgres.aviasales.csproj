<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nextorm.examples.postgres.aviasales</AssemblyName>
    <RootNamespace>NextORM.Examples.Postgres.Aviasales</RootNamespace>
    <NextormBenchmarkUseLocalProjects Condition="'$(NextormBenchmarkUseLocalProjects)' == ''">true</NextormBenchmarkUseLocalProjects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="linq2db.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="nextorm" Condition="'$(NextormBenchmarkUseLocalProjects)' != 'true'" />
    <PackageReference Include="nextorm.postgres" Condition="'$(NextormBenchmarkUseLocalProjects)' != 'true'" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/nextorm.extensions/nextorm.extensions.csproj" />
    <ProjectReference Include="../../src/nextorm.core/nextorm.core.csproj"
                      Condition="'$(NextormBenchmarkUseLocalProjects)' == 'true'" />
    <ProjectReference Include="../../src/nextorm.postgres/nextorm.postgres.csproj"
                      Condition="'$(NextormBenchmarkUseLocalProjects)' == 'true'" />
    <ProjectReference Include="../../src/nextorm.core.sourcegenerator/nextorm.core.sourcegenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="'$(NextormBenchmarkUseLocalProjects)' == 'true'" />
  </ItemGroup>
</Project>
