+                    builder.Append(alias).Append('.');
+            }
+
+            builder.Append(ctx.Dialect.QuoteIdentifier(selExp.PropertyName!));
+            return builder.ToString();
+        }
+        finally
+        {
+            StringBuilderPool.Shared.Return(builder);
+        }
+    }
