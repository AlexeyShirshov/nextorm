+using System.ComponentModel.DataAnnotations;
+using System.ComponentModel.DataAnnotations.Schema;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Postgres.Tests;
+
+[SqlTable("dyn_entity")]
+public sealed class DynamicEntity
+{
+    [Key]
+    [Column("id")]
+    public long Id { get; set; }
+
+    [Column("name")]
+    public string? Name { get; set; }
+
+    [DynamicColumns("Age", "City")]
+    public Dictionary<string, object?> Extra { get; set; } = new();
+}
+
+[SqlTable("dyn_other")]
+public sealed class DynamicOtherEntity
+{
+    [Key]
+    [Column("id")]
+    public long Id { get; set; }
+
+    [DynamicColumns("Score")]
+    public Dictionary<string, object?> Extra { get; set; } = new();
+}
+
+/// <summary>
+/// SQL generation of the dynamic-columns store on PostgreSQL (no database connection). Declared dynamic
+/// columns are always double-quoted, both in reads and in writes, regardless of
+/// <c>UseQuotedIdentifiers</c>.
+/// </summary>
+public class DynamicColumnsSqlGenerationTests
+{
+    private static string Normalize(string sql) => sql.Replace("\r\n", "\n");
+
+    private static string SelectSqlOf<T>(IDataContext ctx, QueryCommand<T> cmd)
+        => Normalize(((DbPreparedQueryCommand<T>)ctx.GetPreparedQueryCommand(cmd, false, false, CancellationToken.None)).DbCommand.CommandText);
+
+    private static DynamicEntity Row() => new()
+    {
+        Id = 1,
+        Name = "n",
+        Extra = new() { ["Age"] = 30, ["City"] = "NY" },
+    };
+
+    [Fact]
+    public void Select_DeclaredDynamicColumns_ShouldBeQuoted()
+    {
+        using var ctx = PostgresTestContext.Create();
+
+        SelectSqlOf(ctx, ctx.From<DynamicEntity>().ToCommand())
+            .Should().Be("select id, name, \"Age\", \"City\" from dyn_entity");
+    }
+
+    [Fact]
+    public void Insert_DeclaredDynamicColumns_ShouldBeQuotedAndParameterized()
+    {
+        using var ctx = PostgresTestContext.Create();
+
+        ctx.InsertInto<DynamicEntity>().Values(Row()).ToSql()
+            .Should().Be("insert into dyn_entity (id, name, \"Age\", \"City\") values (@p0, @p1, @p2, @p3)");
+    }
+
+    [Fact]
+    public void Update_SetEntity_ShouldWriteEveryDynamicColumnQuoted()
+    {
+        using var ctx = PostgresTestContext.Create();
+
+        ctx.Update<DynamicEntity>().Set(Row()).ToSql()
+            .Should().Be("update dyn_entity set name = @p0, \"Age\" = @p1, \"City\" = @p2");
+    }
+
+    [Fact]
+    public void TwoEntitiesWithDifferentDeclaredSets_ShouldProduceDifferentSql()
+    {
+        using var ctx = PostgresTestContext.Create();
+
+        var first = SelectSqlOf(ctx, ctx.From<DynamicEntity>().ToCommand());
+        var second = SelectSqlOf(ctx, ctx.From<DynamicOtherEntity>().ToCommand());
+
+        first.Should().Be("select id, name, \"Age\", \"City\" from dyn_entity");
+        second.Should().Be("select id, \"Score\" from dyn_other");
+        second.Should().NotBe(first);
+    }
+}
