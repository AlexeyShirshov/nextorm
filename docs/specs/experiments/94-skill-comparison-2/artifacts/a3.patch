@@ -0,0 +1,82 @@
+using System.ComponentModel.DataAnnotations;
+using System.ComponentModel.DataAnnotations.Schema;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Integration.Tests;
+
+public abstract partial class CommonTestSuite
+{
+    [SqlTable("dynamic_cols_it")]
+    public interface IDynamicColsProbe
+    {
+        [Key]
+        [Column("id")]
+        long Id { get; set; }
+
+        [Column("name")]
+        string? Name { get; set; }
+
+        [DynamicColumns("extra")]
+        Dictionary<string, object?> Extra { get; set; }
+    }
+
+    public sealed class DynamicColsProbe : IDynamicColsProbe
+    {
+        public long Id { get; set; }
+        public string? Name { get; set; }
+        public Dictionary<string, object?> Extra { get; set; } = new();
+    }
+
+    /// <summary>
+    /// Round-trips the dynamic-columns store on every provider: <c>extra</c> is a physical column with
+    /// no declared CLR member, written from the store's <c>extra</c> key on INSERT and drained back into
+    /// the store on read. The table is created from the dialect's text type so the test stays
+    /// provider-agnostic, and is dropped again at the end.
+    /// </summary>
+    [Fact]
+    public void DynamicColumns_ShouldRoundTrip() => DynamicColumnsRoundTrip(_sut.DataProvider);
+
+    /// <summary>
+    /// The round-trip body, shared with provider integration classes that do not inherit
+    /// <see cref="CommonTestSuite"/> (ClickHouse runs its own provider-specific suite).
+    /// </summary>
+    internal static void DynamicColumnsRoundTrip(IDataContext ctx)
+    {
+        var dialect = ((DataContext)ctx).Dialect;
+        var textType = ProbeTextType(dialect);
+        var engine = dialect.GetType().Name.Contains("ClickHouse", StringComparison.Ordinal) ? " engine = Memory" : string.Empty;
+
+        ExecuteDynamicColumns(ctx, "drop table if exists dynamic_cols_it");
+        ExecuteDynamicColumns(ctx, $"create table dynamic_cols_it (id bigint, name {textType}, extra {textType}){engine}");
+
+        try
+        {
+            ctx.InsertInto<DynamicColsProbe>()
+                .Values(new DynamicColsProbe
+                {
+                    Id = 1,
+                    Name = "mapped",
+                    Extra = new() { ["extra"] = "it-extra" },
+                })
+                .Insert();
+
+            var row = ctx.From<DynamicColsProbe>().Where(x => x.Id == 1).ToList().Single();
+
+            row.Name.Should().Be("mapped");
+            row.Extra.Should().ContainKey("extra");
+            row.Extra["extra"].Should().Be("it-extra");
+        }
+        finally
+        {
+            ExecuteDynamicColumns(ctx, "drop table if exists dynamic_cols_it");
+        }
+    }
+
+    private static void ExecuteDynamicColumns(IDataContext ctx, string sql)
+    {
+        ((DataContext)ctx).EnsureConnectionOpen();
+        using var cmd = ((DataContext)ctx).CreateCommand(sql);
+        cmd.ExecuteNonQuery();
+    }
+}
