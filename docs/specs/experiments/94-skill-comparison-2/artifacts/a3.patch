diff --git a/tests/nextorm.core.tests/DynamicColumnsWriteTests.cs b/tests/nextorm.core.tests/DynamicColumnsWriteTests.cs
new file mode 100644
index 0000000..2ce6262
--- /dev/null
+++ b/tests/nextorm.core.tests/DynamicColumnsWriteTests.cs
@@ -0,0 +1,286 @@
+using FluentAssertions;
+
+namespace NextORM.Core.Tests;
+
+/// <summary>
+/// Unit tests for the dynamic-columns write path: the INSERT, UPDATE and MERGE builders must append the
+/// store's keys as <see cref="DynamicColumnMetadata"/> columns (declared allow-list or the first-seen
+/// union), with <c>DEFAULT</c> for a missing key and runtime identifier validation. No database is
+/// involved; the SQL assertions live in the provider test streams.
+/// </summary>
+public class DynamicColumnsWriteTests
+{
+    [Fact]
+    public void Insert_WithDeclaredColumns_WritesAllowListAndDefaultsMissingKeys()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row1 = new AttributedDynamicColumnsEntity
+        {
+            Id = 1,
+            Extra = new() { ["Age"] = 30, ["City"] = "NY", ["Ignored"] = 99 },
+        };
+        var row2 = new AttributedDynamicColumnsEntity
+        {
+            Id = 2,
+            Extra = new() { ["Age"] = 40 },
+        };
+
+        var command = (InsertCommand)ctx.InsertInto<AttributedDynamicColumnsEntity>()
+            .Values([row1, row2])
+            .BuildBatchCommand();
+
+        var age = command.Columns.Single(c => c.Property.ColumnName == "Age");
+        age.Values[0].Constant.Should().Be(30);
+        age.Values[1].Constant.Should().Be(40);
+
+        var city = command.Columns.Single(c => c.Property.ColumnName == "City");
+        city.Values[0].Constant.Should().Be("NY");
+        city.Values[1].IsDefault.Should().BeTrue();
+
+        command.Columns.Should().NotContain(c => c.Property.ColumnName == "Ignored");
+    }
+
+    [Fact]
+    public void Insert_WithEmptyDeclaredList_WritesFirstSeenUnion()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row1 = new EmptyDynamicColumnsEntity { Id = 1, Extra = new() { ["B"] = 1, ["A"] = 2 } };
+        var row2 = new EmptyDynamicColumnsEntity { Id = 2, Extra = new() { ["A"] = 3, ["C"] = 4 } };
+
+        var command = (InsertCommand)ctx.InsertInto<EmptyDynamicColumnsEntity>()
+            .Values([row1, row2])
+            .BuildBatchCommand();
+
+        var dynamicColumns = command.Columns
+            .Where(c => c.Property is DynamicColumnMetadata)
+            .Select(c => c.Property.ColumnName)
+            .ToArray();
+
+        dynamicColumns.Should().Equal("B", "A", "C");
+
+        var cColumn = command.Columns.Single(c => c.Property.ColumnName == "C");
+        cColumn.Values[0].IsDefault.Should().BeTrue();
+        cColumn.Values[1].Constant.Should().Be(4);
+
+        var bColumn = command.Columns.Single(c => c.Property.ColumnName == "B");
+        bColumn.Values[0].Constant.Should().Be(1);
+        bColumn.Values[1].IsDefault.Should().BeTrue();
+    }
+
+    [Fact]
+    public void Insert_WithNullStore_WritesDeclaredKeysAsDefault()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row = new AttributedDynamicColumnsEntity { Id = 1, Extra = null! };
+
+        var command = (InsertCommand)ctx.InsertInto<AttributedDynamicColumnsEntity>()
+            .Values(row)
+            .BuildBatchCommand();
+
+        var age = command.Columns.Single(c => c.Property.ColumnName == "Age");
+        age.Values.Single().IsDefault.Should().BeTrue();
+    }
+
+    [Fact]
+    public void Insert_WithInvalidRuntimeKey_Throws()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row = new EmptyDynamicColumnsEntity { Id = 1, Extra = new() { ["bad-name"] = 1 } };
+
+        Action act = () => ctx.InsertInto<EmptyDynamicColumnsEntity>().Values(row).BuildBatchCommand();
+
+        act.Should().Throw<InvalidOperationException>().WithMessage("*plain SQL identifier*");
+    }
+
+    [Fact]
+    public void Update_SetEntity_WritesDeclaredKeysPresentOnly()
+    {
+        using var ctx = new InMemoryDataContext();
+        var entity = new AttributedDynamicColumnsEntity
+        {
+            Id = 1,
+            Extra = new() { ["Age"] = 30, ["Ignored"] = 1 },
+        };
+
+        var command = (UpdateCommand)ctx.Update<AttributedDynamicColumnsEntity>()
+            .Set(entity)
+            .BuildBatchCommand();
+
+        command.Assignments.Should().ContainSingle(a => a.Property.ColumnName == "Age")
+            .Which.Constant.Should().Be(30);
+        command.Assignments.Should().NotContain(a => a.Property.ColumnName == "City");
+        command.Assignments.Should().NotContain(a => a.Property.ColumnName == "Ignored");
+    }
+
+    [Fact]
+    public void Insert_WithEmptyDeclaredList_SkipsStoreKeysCollidingWithMappedColumns()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row = new EmptyDynamicColumnsEntity
+        {
+            Id = 1,
+            Extra = new() { ["Id"] = 999, ["IsAdmin"] = true, ["Age"] = 30 },
+        };
+
+        var command = (InsertCommand)ctx.InsertInto<EmptyDynamicColumnsEntity>()
+            .Values(row)
+            .BuildBatchCommand();
+
+        var dynamicColumns = command.Columns
+            .Where(c => c.Property is DynamicColumnMetadata)
+            .Select(c => c.Property.ColumnName)
+            .ToArray();
+
+        dynamicColumns.Should().Equal("IsAdmin", "Age");
+
+        // The mapped Id column is still written with its real value (1), never the hostile store value.
+        var idColumn = command.Columns.Single(c => c.Property.PropertyInfo?.Name == "Id");
+        idColumn.Property.Should().BeOfType<PropertyMetadata>();
+        idColumn.Values.Single().Constant.Should().Be(1);
+    }
+
+    [Fact]
+    public void Update_SetEntity_WithEmptyDeclaredList_SkipsStoreKeysCollidingWithMappedColumns()
+    {
+        using var ctx = new InMemoryDataContext();
+        var entity = new EmptyDynamicColumnsEntity
+        {
+            Id = 1,
+            Extra = new() { ["Id"] = 999, ["Age"] = 30 },
+        };
+
+        var command = (UpdateCommand)ctx.Update<EmptyDynamicColumnsEntity>()
+            .Set(entity)
+            .BuildBatchCommand();
+
+        command.Assignments.Should().NotContain(a => a.Property.ColumnName == "Id");
+        command.Assignments.Should().ContainSingle(a => a.Property.ColumnName == "Age")
+            .Which.Constant.Should().Be(30);
+    }
+
+    // Regression: a Range<T> property maps two physical columns (lower and upper); a store key equal to
+    // the upper column must be dropped like any other mapped-column collision, or INSERT would render a
+    // second column with that name.
+    [Fact]
+    public void Insert_StoreKeyCollidingWithRangeUpperColumn_IsSkipped()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row = new RangeDynamicColumnsEntity
+        {
+            Id = 1,
+            Span = new Range<int>(1, 10),
+            Extra = new() { ["hi"] = 999, ["lo"] = 888, ["Age"] = 30 },
+        };
+
+        var command = (InsertCommand)ctx.InsertInto<RangeDynamicColumnsEntity>()
+            .Values(row)
+            .BuildBatchCommand();
+
+        var dynamicColumns = command.Columns
+            .Where(c => c.Property is DynamicColumnMetadata)
+            .Select(c => c.Property.ColumnName)
+            .ToArray();
+
+        dynamicColumns.Should().Equal("Age");
+    }
+
+    [Fact]
+    public void Update_StoreKeyCollidingWithRangeUpperColumn_IsSkipped()
+    {
+        using var ctx = new InMemoryDataContext();
+        var entity = new RangeDynamicColumnsEntity
+        {
+            Id = 1,
+            Span = new Range<int>(1, 10),
+            Extra = new() { ["hi"] = 999, ["Age"] = 30 },
+        };
+
+        var command = (UpdateCommand)ctx.Update<RangeDynamicColumnsEntity>()
+            .Set(entity)
+            .BuildBatchCommand();
+
+        var dynamicNames = command.Assignments
+            .Where(a => a.Property is DynamicColumnMetadata)
+            .Select(a => a.Property.ColumnName)
+            .ToArray();
+
+        dynamicNames.Should().Equal("Age");
+        command.Assignments.Should().ContainSingle(a => a.Property.ColumnName == "Age")
+            .Which.Constant.Should().Be(30);
+    }
+
+    [Fact]
+    public void Merge_WithEmptyDeclaredList_SkipsStoreKeysCollidingWithMappedColumns()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row = new EmptyDynamicColumnsEntity
+        {
+            Id = 1,
+            Extra = new() { ["Id"] = 999, ["Age"] = 30 },
+        };
+
+        var command = (MergeCommand)ctx.MergeInto<EmptyDynamicColumnsEntity>()
+            .Using(row)
+            .OnKeys()
+            .WhenMatchedUpdate()
+            .WhenNotMatchedInsert()
+            .BuildReturningCommand([]);
+
+        var dynamicColumns = command.Columns
+            .Where(c => c.Property is DynamicColumnMetadata)
+            .Select(c => c.Property.ColumnName)
+            .ToArray();
+
+        dynamicColumns.Should().Equal("Age");
+    }
+
+    [Fact]
+    public void Insert_WithEmptyDeclaredList_DedupesRuntimeKeysCaseInsensitively()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row1 = new EmptyDynamicColumnsEntity { Id = 1, Extra = new() { ["Tag"] = "a" } };
+        var row2 = new EmptyDynamicColumnsEntity { Id = 2, Extra = new() { ["tag"] = "b" } };
+
+        var command = (InsertCommand)ctx.InsertInto<EmptyDynamicColumnsEntity>()
+            .Values([row1, row2])
+            .BuildBatchCommand();
+
+        var dynamicColumns = command.Columns
+            .Where(c => c.Property is DynamicColumnMetadata)
+            .Select(c => c.Property.ColumnName)
+            .ToArray();
+
+        dynamicColumns.Should().Equal("Tag");
+    }
+
+    [Fact]
+    public void Merge_WithDeclaredColumns_WritesAllowListAndDefaultsMissingKeys()
+    {
+        using var ctx = new InMemoryDataContext();
+        var row1 = new AttributedDynamicColumnsEntity
+        {
+            Id = 1,
+            Extra = new() { ["Age"] = 30, ["City"] = "NY" },
+        };
+        var row2 = new AttributedDynamicColumnsEntity
+        {
+            Id = 2,
+            Extra = new() { ["Age"] = 40 },
+        };
+
+        var command = (MergeCommand)ctx.MergeInto<AttributedDynamicColumnsEntity>()
+            .Using([row1, row2])
+            .OnKeys()
+            .WhenMatchedUpdate()
+            .WhenNotMatchedInsert()
+            .BuildReturningCommand([]);
+
+        var age = command.Columns.Single(c => c.Property.ColumnName == "Age");
+        age.Values[0].Constant.Should().Be(30);
+        age.Values[1].Constant.Should().Be(40);
+
+        var city = command.Columns.Single(c => c.Property.ColumnName == "City");
+        city.Values[0].Constant.Should().Be("NY");
+        city.Values[1].IsDefault.Should().BeTrue();
+    }
+}
