+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Core.Tests;
+
+public sealed class InMemoryDynamicColumnsEntity
+{
+    public int Id { get; set; }
+
+    [DynamicColumns("Age", "City")]
+    public Dictionary<string, object?> Extra { get; set; } = new();
+}
+
+/// <summary>
+/// The dynamic-columns store travels with an entity through the in-memory provider: the store is neither
+/// a mapped property nor a projection column, so seeding and querying the whole entity must return the
+/// original object and its dictionary contents unchanged.
+/// </summary>
+public class InMemoryDynamicColumnsTests
+{
+    [Fact]
+    public void Query_WholeEntity_ShouldCarryStoreContents()
+    {
+        using var ctx = new InMemoryDataContext();
+        var seed = new InMemoryDynamicColumnsEntity
+        {
+            Id = 1,
+            Extra = new() { ["Age"] = 30, ["City"] = "NY" },
+        };
+
+        ctx.From<InMemoryDynamicColumnsEntity>().WithData(new[] { seed });
+
+        var row = ctx.From<InMemoryDynamicColumnsEntity>().First();
+
+        row.Id.Should().Be(1);
+        row.Extra.Should().BeSameAs(seed.Extra);
+        row.Extra["Age"].Should().Be(30);
+        row.Extra["City"].Should().Be("NY");
+    }
+}
