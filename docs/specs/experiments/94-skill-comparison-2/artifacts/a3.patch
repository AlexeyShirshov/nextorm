+namespace NextORM.Core;
+
+/// <summary>
+/// Validates the physical column names drained into a dynamic-columns store. The name is rendered as a
+/// quoted identifier by the read/write paths, and this guard is the single allow-list check that keeps
+/// an untrusted name from reaching SQL.
+/// </summary>
+internal static class DynamicColumnName
+{
+    /// <summary>
+    /// Throws when <paramref name="name"/> is not a plain SQL identifier (letters, digits and
+    /// underscore, not starting with a digit).
+    /// </summary>
+    /// <param name="name">The dynamic column name to validate.</param>
+    /// <exception cref="InvalidOperationException"><paramref name="name"/> is null, empty or not a plain SQL identifier.</exception>
+    internal static void Validate(string name)
+    {
+        if (!IsValid(name))
+            throw new InvalidOperationException(
+                $"'{name}' is not a valid dynamic column name; a dynamic column name must be a plain SQL identifier (letters, digits and underscore, not starting with a digit).");
+    }
+
+    /// <summary>Whether <paramref name="name"/> is a plain SQL identifier.</summary>
+    /// <param name="name">The candidate name.</param>
+    /// <returns><see langword="true"/> when the name matches <c>^[A-Za-z_][A-Za-z0-9_]*$</c>.</returns>
+    internal static bool IsValid(string? name)
+    {
+        if (string.IsNullOrEmpty(name))
+            return false;
+
+        var first = name![0];
+        if (first != '_' && (first < 'A' || first > 'Z') && (first < 'a' || first > 'z'))
+            return false;
+
+        for (var i = 1; i < name.Length; i++)
+        {
+            var c = name[i];
+            if (c != '_' && (c < 'A' || c > 'Z') && (c < 'a' || c > 'z') && (c < '0' || c > '9'))
+                return false;
+        }
+
+        return true;
+    }
+}
