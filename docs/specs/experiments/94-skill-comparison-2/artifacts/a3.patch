@@ -0,0 +1,31 @@
+namespace NextORM.Core;
+
+/// <summary>
+/// Declares that the annotated property is the dynamic-columns store of its entity. The declared
+/// physical column names are projected into the store on read and rendered from the store's keys on
+/// write; nothing is discovered from the database schema at runtime. The names act as the allow-list of
+/// identifiers that may be read or written.
+/// </summary>
+/// <remarks>
+/// The annotated property must be assignable from <see cref="System.Collections.Generic.IDictionary{TKey, TValue}"/>
+/// with <see cref="string"/> keys and <see cref="object"/> values. A property mapped with this
+/// attribute cannot be combined with the ordinary column mappings (<c>Column</c>, key, identity,
+/// computed, converters or range columns).
+/// </remarks>
+[AttributeUsage(AttributeTargets.Property, AllowMultiple = false, Inherited = true)]
+public sealed class DynamicColumnsAttribute : Attribute
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="DynamicColumnsAttribute"/> class with the declared
+    /// physical column names drained into the store.
+    /// </summary>
+    /// <param name="columns">
+    /// The declared physical column names. Each name must be a plain SQL identifier. An empty set
+    /// declares a store that projects no extra columns and, on write, renders every store key that is
+    /// not a mapped column of the entity.
+    /// </param>
+    public DynamicColumnsAttribute(params string[] columns) => Columns = columns?.ToArray() ?? Array.Empty<string>();
+
+    /// <summary>Declared physical column names drained into the store; empty when no columns were declared.</summary>
+    public IReadOnlyList<string> Columns { get; }
+}
