new file mode 100644
index 0000000..7998bb5
--- /dev/null
+++ b/src/nextorm.core/Query/Mutations/DynamicColumnSet.cs
@@ -0,0 +1,221 @@
+namespace NextORM.Core;
+
+/// <summary>
+/// Resolves the dynamic columns a write mutation (INSERT, UPDATE, MERGE) renders from an entity's
+/// dynamic-columns store. The written set is the declared allow-list when one is present, otherwise the
+/// first-seen union of the store keys across the written rows. Every runtime key is validated with
+/// <see cref="DynamicColumnName.Validate"/>; a store property absent from the mapping or a
+/// <see langword="null"/> store value contributes no dynamic column.
+/// <para>
+/// No path may write a column the entity already maps (its key, identity, computed or ordinary
+/// columns) or a second column of a mapped <c>Range&lt;T&gt;</c> property: a runtime store key that
+/// collides with one of those is silently skipped, so a hostile <c>store["Id"]</c> can never be
+/// rendered. The store property itself is not a mapped column, so its CLR name is not reserved. A
+/// declared allow-list entry that collides with a mapped column is a configuration error and throws
+/// <see cref="InvalidOperationException"/>.
+/// </para>
+/// </summary>
+internal static class DynamicColumnSet
+{
+    /// <summary>One resolved dynamic column and its per-row INSERT/MERGE values, shaped for the renderers.</summary>
+    internal readonly struct Column
+    {
+        /// <summary>Creates a resolved dynamic column.</summary>
+        /// <param name="property">The column mapping (<see cref="DynamicColumnMetadata"/>).</param>
+        /// <param name="values">One value per written row, in row order.</param>
+        internal Column(IPropertyMetadata property, IReadOnlyList<InsertValue> values)
+        {
+            Property = property;
+            Values = values;
+        }
+
+        /// <summary>The resolved column mapping.</summary>
+        internal IPropertyMetadata Property { get; }
+
+        /// <summary>The per-row values, in row order.</summary>
+        internal IReadOnlyList<InsertValue> Values { get; }
+    }
+
+    /// <summary>
+    /// Reads the store value of every entity, or an empty list when the entity declares no store property.
+    /// A <see langword="null"/> entry means that row has no store (and therefore no dynamic values).
+    /// </summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="metadata">The entity mapping.</param>
+    /// <param name="entities">The written rows.</param>
+    /// <returns>One store per entity, in row order, or an empty list when the entity has no store.</returns>
+    internal static IReadOnlyList<IDictionary<string, object>?> ReadStores<TEntity>(IEntityMetadata metadata, IReadOnlyList<TEntity> entities)
+    {
+        if (metadata.DynamicColumnsProperty is not { } property)
+            return Array.Empty<IDictionary<string, object>?>();
+
+        var stores = new IDictionary<string, object>?[entities.Count];
+        for (var i = 0; i < entities.Count; i++)
+            stores[i] = (IDictionary<string, object>?)property.GetValue(entities[i]);
+
+        return stores;
+    }
+
+    /// <summary>Reads a single entity's store value, or <see langword="null"/> when it has no store or the store is null.</summary>
+    /// <param name="metadata">The entity mapping.</param>
+    /// <param name="entity">The written entity.</param>
+    /// <returns>The store dictionary, or <see langword="null"/>.</returns>
+    internal static IDictionary<string, object>? ReadStore(IEntityMetadata metadata, object entity)
+        => metadata.DynamicColumnsProperty is { } property
+            ? (IDictionary<string, object>?)property.GetValue(entity)
+            : null;
+
+    /// <summary>
+    /// Builds the dynamic columns of a multi-row INSERT or MERGE. The column set is exactly the declared
+    /// allow-list when it is non-empty, otherwise the first-seen union of the store keys that are not
+    /// mapped columns. A missing key on a row is written as <c>DEFAULT</c>. Returns an empty list when the
+    /// entity declares no store.
+    /// </summary>
+    /// <param name="metadata">The entity mapping.</param>
+    /// <param name="stores">One store per written row, in row order.</param>
+    /// <param name="namingConvention">The active naming convention, or <see langword="null"/>; used to resolve auto-mapped column names before the collision check.</param>
+    /// <returns>The resolved dynamic columns, in write order.</returns>
+    /// <exception cref="InvalidOperationException">A runtime store key is not a plain SQL identifier, or a declared allow-list entry collides with a mapped column.</exception>
+    internal static IReadOnlyList<Column> BuildInsertColumns(IEntityMetadata metadata, IReadOnlyList<IDictionary<string, object>?> stores, INamingConvention? namingConvention)
+    {
+        if (metadata.DynamicColumnsProperty is null)
+            return Array.Empty<Column>();
+
+        var keys = ResolveKeys(metadata, stores, namingConvention);
+        if (keys.Count == 0)
+            return Array.Empty<Column>();
+
+        var columns = new Column[keys.Count];
+        for (var k = 0; k < keys.Count; k++)
+        {
+            var key = keys[k];
+            var values = new InsertValue[stores.Count];
+            for (var i = 0; i < stores.Count; i++)
+            {
+                values[i] = stores[i] is { } store && store.TryGetValue(key, out var value)
+                    ? InsertValue.FromConstant(value)
+                    : InsertValue.FromDefault();
+            }
+
+            columns[k] = new Column(new DynamicColumnMetadata(key), values);
+        }
+
+        return columns;
+    }
+
+    /// <summary>
+    /// Resolves the dynamic columns an UPDATE writes. With a declared allow-list only the listed keys that
+    /// are present in the store are written (a missing key is skipped, not defaulted); otherwise every
+    /// store key that is not a mapped column is written. Returns an empty list when the entity declares no
+    /// store or the store is null.
+    /// </summary>
+    /// <param name="metadata">The entity mapping.</param>
+    /// <param name="store">The entity's store value, or <see langword="null"/>.</param>
+    /// <param name="namingConvention">The active naming convention, or <see langword="null"/>; used to resolve auto-mapped column names before the collision check.</param>
+    /// <returns>The resolved column name/value pairs, in write order.</returns>
+    /// <exception cref="InvalidOperationException">A runtime store key is not a plain SQL identifier, or a declared allow-list entry collides with a mapped column.</exception>
+    internal static IReadOnlyList<KeyValuePair<string, object?>> ResolveUpdateValues(IEntityMetadata metadata, IDictionary<string, object>? store, INamingConvention? namingConvention)
+    {
+        var values = new List<KeyValuePair<string, object?>>();
+        if (metadata.DynamicColumnsProperty is null)
+            return values;
+
+        var reserved = BuildReservedNames(metadata, namingConvention);
+        var declared = metadata.DynamicColumns;
+        if (declared.Count > 0)
+        {
+            ValidateDeclaredNames(metadata, declared, reserved);
+            foreach (var name in declared)
+            {
+                if (store is not null && store.TryGetValue(name, out var value))
+                    values.Add(new KeyValuePair<string, object?>(name, value));
+            }
+
+            return values;
+        }
+
+        if (store is not null)
+        {
+            foreach (var pair in store)
+            {
+                DynamicColumnName.Validate(pair.Key);
+                if (reserved.Contains(pair.Key))
+                    continue;
+
+                values.Add(new KeyValuePair<string, object?>(pair.Key, pair.Value));
+            }
+        }
+
+        return values;
+    }
+
+    // The physical columns the entity maps. A dynamic write must never emit one of these: a collision
+    // would write a mapped column twice (mass assignment). The store property itself is NOT a physical
+    // column — it is excluded from IEntityMetadata.Properties — so its own CLR name is deliberately not
+    // reserved: a normal mapping like `Extra` + [DynamicColumns("extra")] is valid and writes `extra`.
+    // Compared case-insensitively, matching how an unquoted SQL identifier resolves.
+    private static HashSet<string> BuildReservedNames(IEntityMetadata metadata, INamingConvention? namingConvention)
+    {
+        var reserved = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var property in metadata.Properties)
+        {
+            reserved.Add(SqlMutationBuilder.ResolveColumnName(property, namingConvention));
+
+            // A Range<T> property maps two physical columns: the resolved name above is its lower
+            // column, but the upper column is a mapped, writable column too. Reserving only the
+            // resolved name would let a store key equal to the upper column survive and emit a second
+            // physical column with the same name on INSERT/UPDATE/MERGE.
+            if (property.RangeColumns is { } range)
+            {
+                reserved.Add(range.LowerColumn);
+                reserved.Add(range.UpperColumn);
+            }
+        }
+
+        return reserved;
+    }
+
+    // A declared allow-list entry is configuration, so a collision with a mapped column is a hard error.
+    // The metadata builder rejects this too; the guard is repeated here for metadata supplied by an
+    // external IEntityMetadata implementation.
+    private static void ValidateDeclaredNames(IEntityMetadata metadata, IReadOnlyList<string> declared, HashSet<string> reserved)
+    {
+        foreach (var name in declared)
+        {
+            DynamicColumnName.Validate(name);
+            if (reserved.Contains(name))
+                throw new InvalidOperationException(
+                    $"The declared dynamic column '{name}' of entity {metadata.DynamicColumnsProperty!.DeclaringType?.Name} collides with a mapped column; a dynamic column must not duplicate a mapped column.");
+        }
+    }
+
+    private static IReadOnlyList<string> ResolveKeys(IEntityMetadata metadata, IReadOnlyList<IDictionary<string, object>?> stores, INamingConvention? namingConvention)
+    {
+        var declared = metadata.DynamicColumns;
+        var reserved = BuildReservedNames(metadata, namingConvention);
+        if (declared.Count > 0)
+        {
+            ValidateDeclaredNames(metadata, declared, reserved);
+            return declared;
+        }
+
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        var keys = new List<string>();
+        foreach (var store in stores)
+        {
+            if (store is null)
+                continue;
+
+            foreach (var key in store.Keys)
+            {
+                DynamicColumnName.Validate(key);
+                if (reserved.Contains(key))
+                    continue;
+                if (seen.Add(key))
+                    keys.Add(key);
+            }
+        }
+
+        return keys;
+    }
+}
