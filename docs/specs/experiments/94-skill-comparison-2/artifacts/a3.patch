+using System.ComponentModel.DataAnnotations;
+using System.ComponentModel.DataAnnotations.Schema;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Sqlite.Tests;
+
+[SqlTable("dyn_entity")]
+public sealed class DynamicEntity
+{
+    [Key]
+    [Column("id")]
+    public long Id { get; set; }
+
+    [Column("name")]
+    public string? Name { get; set; }
+
+    [DynamicColumns("Age", "City")]
+    public Dictionary<string, object?> Extra { get; set; } = new();
+}
+
+[SqlTable("dyn_other")]
+public sealed class DynamicOtherEntity
+{
+    [Key]
+    [Column("id")]
+    public long Id { get; set; }
+
+    [DynamicColumns("Score")]
+    public Dictionary<string, object?> Extra { get; set; } = new();
+}
+
+/// <summary>
+/// An entity whose mapped column names are all auto-derived (no <c>[Column]</c>), so an
+/// <see cref="INamingConvention"/> rewrites them. Used to prove the dynamic-column guard resolves
+/// mapped names through the convention before comparing them with a runtime store key.
+/// </summary>
+public sealed class DynamicConventionEntity
+{
+    [Key]
+    public long Id { get; set; }
+
+    public string? UserId { get; set; }
+
+    [DynamicColumns]
+    public Dictionary<string, object?> Extra { get; set; } = new();
+}
+
+/// <summary>
+/// An entity that combines a <see cref="Range{T}"/> column pair with a dynamic-columns store. A store
+/// key equal to the range's upper column must be dropped as a mapped-column collision.
+/// </summary>
+[SqlTable("dyn_range")]
+public sealed class RangeDynamicEntity
+{
+    [Key]
+    [Column("id")]
+    public long Id { get; set; }
+
+    [RangeColumns("lo", "hi")]
+    public Range<int> Span { get; set; }
+
+    [DynamicColumns]
+    public Dictionary<string, object?> Extra { get; set; } = new();
+}
+
+/// <summary>
+/// SQL generation of the dynamic-columns store on SQLite (no database connection). Declared dynamic
+/// columns are always double-quoted, both in reads and in writes, regardless of
+/// <c>UseQuotedIdentifiers</c>.
+/// </summary>
+public class DynamicColumnsSqlGenerationTests
+{
+    private static string Normalize(string sql) => sql.Replace("\r\n", "\n");
+
+    private static string SelectSqlOf<T>(IDataContext ctx, QueryCommand<T> cmd)
+        => Normalize(((DbPreparedQueryCommand<T>)ctx.GetPreparedQueryCommand(cmd, false, false, CancellationToken.None)).DbCommand.CommandText);
+
+    private static DynamicEntity Row() => new()
+    {
+        Id = 1,
+        Name = "n",
+        Extra = new() { ["Age"] = 30, ["City"] = "NY" },
+    };
+
+    [Fact]
+    public void Select_DeclaredDynamicColumns_ShouldBeQuoted()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        SelectSqlOf(ctx, ctx.From<DynamicEntity>().ToCommand())
+            .Should().Be("select id, name, \"Age\", \"City\" from dyn_entity");
+    }
+
+    [Fact]
+    public void Insert_DeclaredDynamicColumns_ShouldBeQuotedAndParameterized()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        ctx.InsertInto<DynamicEntity>().Values(Row()).ToSql()
+            .Should().Be("insert into dyn_entity (id, name, \"Age\", \"City\") values ($p0, $p1, $p2, $p3)");
+    }
+
+    [Fact]
+    public void Update_SetEntity_ShouldWriteEveryDynamicColumnQuoted()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        ctx.Update<DynamicEntity>().Set(Row()).ToSql()
+            .Should().Be("update dyn_entity set name = $p0, \"Age\" = $p1, \"City\" = $p2");
+    }
+
+    [Fact]
+    public void TwoEntitiesWithDifferentDeclaredSets_ShouldProduceDifferentSql()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var first = SelectSqlOf(ctx, ctx.From<DynamicEntity>().ToCommand());
+        var second = SelectSqlOf(ctx, ctx.From<DynamicOtherEntity>().ToCommand());
+
+        first.Should().Be("select id, name, \"Age\", \"City\" from dyn_entity");
+        second.Should().Be("select id, \"Score\" from dyn_other");
+        second.Should().NotBe(first);
+    }
+
+    private static DynamicConventionEntity ConventionRow() => new()
+    {
+        Id = 1,
+        UserId = "u",
+        Extra = new() { ["user_id"] = "evil", ["Tag"] = "t" },
+    };
+
+    // Regression: under a snake_case convention the auto-named mapped property UserId becomes the
+    // physical column user_id. A hostile store key user_id must be treated as the mapped column (not a
+    // dynamic one), while a genuine extra key is still written. Without resolving names through the
+    // convention the guard compares user_id against "UserId" and renders the hostile key as a dynamic
+    // column (a mass-assignment through the dynamic write path).
+    [Fact]
+    public void Insert_StoreKeyCollidingWithConventionResolvedMappedColumn_IsSkipped()
+    {
+        using var ctx = SqliteTestContext.CreateSnakeCase();
+
+        ctx.InsertInto<DynamicConventionEntity>().Values(ConventionRow()).ToSql()
+            .Should().Be("insert into dynamic_convention_entity (id, user_id, \"Tag\") values ($p0, $p1, $p2)");
+    }
+
+    [Fact]
+    public void Update_StoreKeyCollidingWithConventionResolvedMappedColumn_IsSkipped()
+    {
+        using var ctx = SqliteTestContext.CreateSnakeCase();
+
+        ctx.Update<DynamicConventionEntity>().Set(ConventionRow()).ToSql()
+            .Should().Be("update dynamic_convention_entity set user_id = $p0, \"Tag\" = $p1");
+    }
+
+    [Fact]
+    public void Merge_StoreKeyCollidingWithConventionResolvedMappedColumn_IsSkipped()
+    {
+        using var ctx = SqliteTestContext.CreateSnakeCase();
+
+        var sql = ctx.MergeInto<DynamicConventionEntity>()
+            .Using(ConventionRow())
+            .OnKeys()
+            .WhenMatchedUpdate()
+            .WhenNotMatchedInsert()
+            .ToSql();
+
+        sql.Should().Contain("(id, user_id, \"Tag\")");
+        sql.Should().NotContain("\"user_id\"");
+    }
+
+    // Regression: a Range<T> property maps two physical columns; the upper one must be reserved too,
+    // or a store key equal to it would be rendered as a second, duplicate physical column.
+    [Fact]
+    public void Insert_StoreKeyCollidingWithRangeUpperColumn_IsSkipped()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var row = new RangeDynamicEntity
+        {
+            Id = 1,
+            Span = new Range<int>(1, 10),
+            Extra = new() { ["hi"] = 999, ["Tag"] = "t" },
+        };
+
+        ctx.InsertInto<RangeDynamicEntity>().Values(row).ToSql()
+            .Should().Be("insert into dyn_range (id, lo, hi, \"Tag\") values ($p0, $p1, $p2, $p3)");
+    }
+
+    [Fact]
+    public void Update_StoreKeyCollidingWithRangeUpperColumn_IsSkipped()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var entity = new RangeDynamicEntity
+        {
+            Id = 1,
+            Span = new Range<int>(1, 10),
+            Extra = new() { ["hi"] = 999, ["Tag"] = "t" },
+        };
+
+        // A dynamic column is always quoted; a mapped range column is not. The store key "hi" must
+        // therefore never appear as a quoted dynamic assignment (which would duplicate the mapped hi).
+        var sql = ctx.Update<RangeDynamicEntity>().Set(entity).ToSql();
+
+        sql.Should().NotContain("\"hi\"");
+        sql.Should().Contain("\"Tag\" = $p1");
+    }
+}
