diff --git a/tests/nextorm.sqlite.tests/DynamicColumnsTests.cs b/tests/nextorm.sqlite.tests/DynamicColumnsTests.cs
new file mode 100644
index 0000000..4d6a84b
--- /dev/null
+++ b/tests/nextorm.sqlite.tests/DynamicColumnsTests.cs
@@ -0,0 +1,238 @@
+using FluentAssertions;
+using Microsoft.Data.Sqlite;
+using NextORM.Core;
+
+namespace NextORM.Sqlite.Tests;
+
+/// <summary>
+/// Dynamic-columns store coverage against a real SQLite database and against SQL generation: the store
+/// is filled from the result set's extra columns on read, written back as (always quoted) columns on
+/// insert/update/merge, and the runtime column names are part of the command/plan key.
+/// </summary>
+public class DynamicColumnsTests
+{
+    [SqlTable("dyn_entity")]
+    private sealed class DynEntity
+    {
+        public int Id { get; set; }
+        public string? Name { get; set; }
+
+        [DynamicColumns]
+        public Dictionary<string, object?> Extra { get; set; } = new();
+    }
+
+    private static (IDataContext Context, string Path) CreateDb()
+    {
+        var path = Path.Combine(AppContext.BaseDirectory, $"nextorm-dyn-{Guid.NewGuid():N}.db");
+        using (var connection = new SqliteConnection($"Data Source={path}"))
+        {
+            connection.Open();
+            using var command = connection.CreateCommand();
+            command.CommandText =
+                "create table dyn_entity (id integer primary key, name text, extra_int integer, extra_text text);" +
+                "insert into dyn_entity (id, name, extra_int, extra_text) values (1, 'alpha', 7, 'note');" +
+                "insert into dyn_entity (id, name, extra_int, extra_text) values (2, 'beta', 8, null);";
+            command.ExecuteNonQuery();
+        }
+
+        return (new SqliteDataContext($"Data Source={path}", new DataContextBuilder()), path);
+    }
+
+    [Fact]
+    public void LinqRead_FillsStoreFromExtraColumns()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var rows = ctx.From<DynEntity>().Where(x => x.Id == 1).ToList();
+
+            rows.Should().HaveCount(1);
+            rows[0].Name.Should().Be("alpha");
+            rows[0].Extra.Should().ContainKey("extra_int").WhoseValue.Should().Be(7L);
+            rows[0].Extra.Should().ContainKey("extra_text").WhoseValue.Should().Be("note");
+            rows[0].Extra.Should().NotContainKey("id");
+            rows[0].Extra.Should().NotContainKey("name");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void RawRead_FillsStoreFromUnmatchedColumns()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            _ = ctx.From<DynEntity>();
+
+            using var result = ctx.ExecuteRaw("select id, name, extra_text from dyn_entity where id = 2");
+            var rows = result.Read<DynEntity>();
+
+            rows.Should().HaveCount(1);
+            rows[0].Name.Should().Be("beta");
+            rows[0].Extra.Should().ContainKey("extra_text").WhoseValue.Should().BeNull();
+            rows[0].Extra.Should().NotContainKey("extra_int");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void Insert_ThenRead_RoundTripsDynamicColumns()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            ctx.InsertInto<DynEntity>()
+                .Values(new DynEntity
+                {
+                    Id = 3,
+                    Name = "gamma",
+                    Extra = new Dictionary<string, object?> { ["extra_int"] = 9, ["extra_text"] = "inserted" },
+                })
+                .Insert();
+
+            var row = ctx.From<DynEntity>().Where(x => x.Id == 3).ToList().Single();
+
+            row.Name.Should().Be("gamma");
+            row.Extra["extra_int"].Should().Be(9L);
+            row.Extra["extra_text"].Should().Be("inserted");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void Insert_ToSql_RendersAlwaysQuotedDynamicColumns()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var sql = ctx.InsertInto<DynEntity>()
+            .Values(new DynEntity
+            {
+                Id = 3,
+                Name = "gamma",
+                Extra = new Dictionary<string, object?> { ["extra_int"] = 9, ["extra_text"] = "inserted" },
+            })
+            .ToSql();
+
+        sql.Should().Contain("\"extra_int\"").And.Contain("\"extra_text\"");
+        sql.Should().Contain("insert into dyn_entity");
+    }
+
+    [Fact]
+    public void Update_ToSql_RendersAlwaysQuotedDynamicColumns()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var sql = ctx.Update<DynEntity>()
+            .Set(new DynEntity
+            {
+                Id = 3,
+                Name = "gamma",
+                Extra = new Dictionary<string, object?> { ["extra_text"] = "updated" },
+            })
+            .Where(x => x.Id == 3)
+            .ToSql();
+
+        sql.Should().Contain("\"extra_text\"").And.Contain("update dyn_entity set");
+    }
+
+    [Fact]
+    public void Merge_ToSql_RendersAlwaysQuotedDynamicColumns()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var sql = ctx.MergeInto<DynEntity>()
+            .Using(new DynEntity
+            {
+                Id = 3,
+                Name = "gamma",
+                Extra = new Dictionary<string, object?> { ["extra_int"] = 9 },
+            })
+            .OnKeys()
+            .WhenMatchedUpdate()
+            .WhenNotMatchedInsert()
+            .ToSql();
+
+        sql.Should().Contain("\"extra_int\"");
+        sql.ToLowerInvariant().Should().Contain("on conflict (id) do update set");
+    }
+
+    [Fact]
+    public void DynamicColumnName_IsQuotedAndEscaped()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var sql = ctx.InsertInto<DynEntity>()
+            .Values(new DynEntity
+            {
+                Id = 3,
+                Name = "gamma",
+                Extra = new Dictionary<string, object?> { ["x\"; drop table dyn_entity; --"] = 1 },
+            })
+            .ToSql();
+
+        // The embedded quote is doubled by the dialect quoter, so the name cannot terminate the identifier.
+        sql.Should().Contain("\"x\"\"; drop table dyn_entity; --\"");
+        sql.Should().NotContain("x\"; drop table dyn_entity; --");
+    }
+
+    [Fact]
+    public void InvalidDynamicColumnName_Throws()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var act = () => ctx.InsertInto<DynEntity>()
+            .Values(new DynEntity
+            {
+                Id = 3,
+                Extra = new Dictionary<string, object?> { ["bad\u0001name"] = 1 },
+            })
+            .ToSql();
+
+        act.Should().Throw<BuildSqlCommandException>();
+    }
+
+    [Fact]
+    public void DynamicColumnName_CollidingWithMappedColumn_Throws()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var act = () => ctx.InsertInto<DynEntity>()
+            .Values(new DynEntity
+            {
+                Id = 3,
+                Extra = new Dictionary<string, object?> { ["Name"] = "clash" },
+            })
+            .ToSql();
+
+        act.Should().Throw<BuildSqlCommandException>();
+    }
+
+    [Fact]
+    public void DifferentKeySets_ProduceDifferentSql()
+    {
+        using var ctx = SqliteTestContext.Create();
+
+        var first = ctx.InsertInto<DynEntity>()
+            .Values(new DynEntity { Id = 1, Extra = new Dictionary<string, object?> { ["a"] = 1 } })
+            .ToSql();
+        var second = ctx.InsertInto<DynEntity>()
+            .Values(new DynEntity { Id = 1, Extra = new Dictionary<string, object?> { ["b"] = 1 } })
+            .ToSql();
+
+        first.Should().NotBe(second);
+        first.Should().Contain("\"a\"").And.NotContain("\"b\"");
+        second.Should().Contain("\"b\"").And.NotContain("\"a\"");
+    }
+}
