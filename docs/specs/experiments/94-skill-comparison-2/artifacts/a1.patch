@@ -0,0 +1,150 @@
+using FluentAssertions;
+
+namespace NextORM.Core.Tests;
+
+/// <summary>
+/// Core-level coverage for the dynamic-columns store mapping: metadata discovery (attribute and
+/// fluent), validation, the plan-key contribution and the in-memory read behaviour.
+/// </summary>
+public class DynamicColumnsTests
+{
+    [SqlTable("dc_attr_entity")]
+    private sealed class AttrEntity
+    {
+        public int Id { get; set; }
+        public string? Name { get; set; }
+
+        [DynamicColumns]
+        public Dictionary<string, object?> Extra { get; set; } = new();
+    }
+
+    [SqlTable("dc_fluent_entity")]
+    private sealed class FluentEntity
+    {
+        public int Id { get; set; }
+        public Dictionary<string, object?> Extra { get; set; } = new();
+    }
+
+    [SqlTable("dc_bad_entity")]
+    private sealed class BadStoreEntity
+    {
+        public int Id { get; set; }
+
+        [DynamicColumns]
+        public string? NotADictionary { get; set; }
+    }
+
+    [SqlTable("dc_dupe_entity")]
+    private sealed class DuplicateStoreEntity
+    {
+        public int Id { get; set; }
+
+        [DynamicColumns]
+        public Dictionary<string, object?> First { get; set; } = new();
+
+        [DynamicColumns]
+        public Dictionary<string, object?> Second { get; set; } = new();
+    }
+
+    [Fact]
+    public void Attribute_MarksStore_AndKeepsOtherColumns()
+    {
+        var metadata = new EntityMetadataBuilder<AttrEntity>().Build();
+
+        metadata.Properties.Should().Contain(p => p.PropertyInfo.Name == nameof(AttrEntity.Id) && !p.IsDynamicColumnsStore);
+        metadata.Properties.Should().Contain(p => p.PropertyInfo.Name == nameof(AttrEntity.Name) && !p.IsDynamicColumnsStore);
+        metadata.Properties.Should().ContainSingle(p => p.IsDynamicColumnsStore)
+            .Which.PropertyInfo.Name.Should().Be(nameof(AttrEntity.Extra));
+    }
+
+    [Fact]
+    public void Fluent_MarksStore()
+    {
+        var builder = new EntityMetadataBuilder<FluentEntity>();
+        builder.Property(x => x.Extra).DynamicColumns();
+        var metadata = builder.Build();
+
+        metadata.Properties.Should().ContainSingle(p => p.IsDynamicColumnsStore)
+            .Which.PropertyInfo.Name.Should().Be(nameof(FluentEntity.Extra));
+    }
+
+    [Fact]
+    public void NonDictionaryStore_Throws()
+    {
+        var act = () => new EntityMetadataBuilder<BadStoreEntity>().Build();
+
+        act.Should().Throw<InvalidOperationException>()
+            .WithMessage("*dynamic-columns store*");
+    }
+
+    [Fact]
+    public void MultipleStores_Throw()
+    {
+        var act = () => new EntityMetadataBuilder<DuplicateStoreEntity>().Build();
+
+        act.Should().Throw<InvalidOperationException>()
+            .WithMessage("*more than one dynamic-columns store*");
+    }
+
+    [Fact]
+    public void PlanComparer_DistinguishesStoreFlag()
+    {
+        var comparer = new SelectExpressionPlanEqualityComparer(new QueryProvider());
+
+        var plain = new SelectExpression(typeof(object)) { Index = 2, PropertyName = "Extra" };
+        var store = new SelectExpression(typeof(object)) { Index = 2, PropertyName = "Extra", IsDynamicColumnsStore = true };
+
+        comparer.Equals(plain, store).Should().BeFalse();
+        comparer.GetHashCode(plain).Should().NotBe(comparer.GetHashCode(store));
+    }
+
+    [Fact]
+    public void PlanComparer_DistinguishesRawOrdinals()
+    {
+        var comparer = new SelectExpressionPlanEqualityComparer(new QueryProvider());
+
+        var first = new SelectExpression(typeof(object))
+        {
+            Index = 1,
+            PropertyName = "Extra",
+            IsDynamicColumnsStore = true,
+            DynamicColumnOrdinals = [2, 3],
+        };
+        var second = new SelectExpression(typeof(object))
+        {
+            Index = 1,
+            PropertyName = "Extra",
+            IsDynamicColumnsStore = true,
+            DynamicColumnOrdinals = [2, 4],
+        };
+        var same = new SelectExpression(typeof(object))
+        {
+            Index = 1,
+            PropertyName = "Extra",
+            IsDynamicColumnsStore = true,
+            DynamicColumnOrdinals = [2, 3],
+        };
+
+        comparer.Equals(first, second).Should().BeFalse();
+        comparer.Equals(first, same).Should().BeTrue();
+        comparer.GetHashCode(first).Should().Be(comparer.GetHashCode(same));
+    }
+
+    [Fact]
+    public void InMemory_Read_PreservesStoreDictionary()
+    {
+        using var context = new InMemoryDataContext();
+        var entity = new AttrEntity
+        {
+            Id = 1,
+            Name = "alpha",
+            Extra = new Dictionary<string, object?> { ["runtime_col"] = 42 },
+        };
+        context.Data[typeof(AttrEntity)] = new List<AttrEntity> { entity };
+
+        var rows = context.From<AttrEntity>().ToList();
+
+        rows.Should().HaveCount(1);
+        rows[0].Extra.Should().ContainKey("runtime_col").WhoseValue.Should().Be(42);
+    }
+}
