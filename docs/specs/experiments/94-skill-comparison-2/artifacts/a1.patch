+using System.Reflection;
+
+namespace NextORM.Core;
+
+/// <summary>
+/// Helpers for the dynamic-columns store mapping: validation, discovery of the store property and the
+/// synthetic per-key column metadata used by the mutation builders.
+/// </summary>
+internal static class DynamicColumnsStore
+{
+    /// <summary>The CLR contract a dynamic-columns store property must satisfy.</summary>
+    internal static readonly Type StoreType = typeof(IDictionary<string, object?>);
+
+    private const int MaxNameLength = 128;
+
+    /// <summary>Whether <paramref name="type"/> can hold a dynamic-columns store.</summary>
+    internal static bool IsStoreType(Type type) => StoreType.IsAssignableFrom(type);
+
+    /// <summary>Validates that <paramref name="property"/> can be used as a dynamic-columns store.</summary>
+    /// <param name="property">The store property.</param>
+    /// <exception cref="InvalidOperationException">The property type is not assignable to <c>IDictionary&lt;string, object?&gt;</c>.</exception>
+    internal static void ValidateStoreProperty(PropertyInfo property)
+    {
+        if (!IsStoreType(property.PropertyType))
+            throw new InvalidOperationException(
+                $"Property '{property.Name}' is mapped as a dynamic-columns store but its type {property.PropertyType} "
+                + $"is not assignable to {StoreType}. Use IDictionary<string, object?> or Dictionary<string, object?>.");
+    }
+
+    /// <summary>
+    /// Validates a runtime column name before it is rendered. The name still reaches the dialect's
+    /// identifier quoter, so this only rejects values that cannot be a column name at all.
+    /// </summary>
+    /// <param name="name">The column name read from a dictionary key.</param>
+    /// <exception cref="BuildSqlCommandException">The name is null, empty, whitespace, too long or contains a control character.</exception>
+    internal static void ValidateName(string name)
+    {
+        if (string.IsNullOrWhiteSpace(name))
+            throw new BuildSqlCommandException("A dynamic column name cannot be null, empty or whitespace.");
+        if (name.Length > MaxNameLength)
+            throw new BuildSqlCommandException($"A dynamic column name cannot exceed {MaxNameLength} characters.");
+        for (var i = 0; i < name.Length; i++)
+        {
+            if (char.IsControl(name[i]))
+                throw new BuildSqlCommandException($"The dynamic column name '{name}' contains a control character.");
+        }
+    }
+
+    /// <summary>
+    /// Validates a runtime column name before it is written: it must be a valid identifier and must not
+    /// collide with a declared mapped column (which would render two columns with the same name).
+    /// </summary>
+    /// <param name="metadata">The entity mapping.</param>
+    /// <param name="name">The column name read from a dictionary key.</param>
+    /// <exception cref="BuildSqlCommandException">The name is invalid or collides with a mapped column.</exception>
+    internal static void ValidateWritableName(IEntityMetadata metadata, string name)
+    {
+        ValidateName(name);
+
+        foreach (var property in metadata.Properties)
+        {
+            if (!property.IsDynamicColumnsStore && string.Equals(property.ColumnName, name, StringComparison.OrdinalIgnoreCase))
+                throw new BuildSqlCommandException(
+                    $"Dynamic column '{name}' collides with the mapped column '{property.ColumnName}' of {metadata.TableName ?? "the entity"}.");
+        }
+    }
+
+    /// <summary>Returns the entity's dynamic-columns store property, or <see langword="null"/> when it declares none.</summary>
+    /// <param name="metadata">The entity mapping.</param>
+    internal static IPropertyMetadata? FindStore(IEntityMetadata metadata)
+    {
+        foreach (var property in metadata.Properties)
+        {
+            if (property.IsDynamicColumnsStore)
+                return property;
+        }
+
+        return null;
+    }
+
+    /// <summary>Creates the synthetic column metadata that renders the dictionary entry <paramref name="name"/>.</summary>
+    /// <param name="store">The store property the column belongs to.</param>
+    /// <param name="name">The validated physical column name.</param>
+    internal static IPropertyMetadata CreateColumn(IPropertyMetadata store, string name)
+        => new DynamicColumnMetadata(store.PropertyInfo, name);
+
+    /// <summary>
+    /// Reads the store dictionary of <paramref name="entity"/>, or <see langword="null"/> when it is unset.
+    /// </summary>
+    /// <param name="store">The store property.</param>
+    /// <param name="entity">The entity instance.</param>
+    internal static IDictionary<string, object?>? ReadStore(IPropertyMetadata store, object entity)
+        => store.PropertyInfo.GetValue(entity) as IDictionary<string, object?>;
+
+    /// <summary>
+    /// Enumerates the key/name pairs of <paramref name="entity"/>'s store, validating each name.
+    /// </summary>
+    /// <param name="metadata">The entity mapping, used to reject a collision with a mapped column.</param>
+    /// <param name="store">The store property.</param>
+    /// <param name="entity">The entity instance.</param>
+    /// <returns>The validated pairs, in dictionary order; empty when the store is unset.</returns>
+    internal static IEnumerable<KeyValuePair<string, object?>> Enumerate(IEntityMetadata metadata, IPropertyMetadata store, object entity)
+    {
+        var values = ReadStore(store, entity);
+        if (values is null)
+            yield break;
+
+        foreach (var pair in values)
+        {
+            ValidateWritableName(metadata, pair.Key);
+            yield return pair;
+        }
+    }
+
+    /// <summary>
+    /// Returns the union of the store keys across <paramref name="entities"/>, in first-seen order, so a
+    /// multi-row insert/merge renders one column per key.
+    /// </summary>
+    /// <param name="metadata">The entity mapping, used to reject a collision with a mapped column.</param>
+    /// <param name="store">The store property.</param>
+    /// <param name="entities">The rows whose stores are unioned.</param>
+    internal static IReadOnlyList<string> UnionKeys<TEntity>(IEntityMetadata metadata, IPropertyMetadata store, IReadOnlyList<TEntity> entities)
+    {
+        var keys = new List<string>();
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+        foreach (var entity in entities)
+        {
+            var values = ReadStore(store, entity!);
+            if (values is null)
+                continue;
+
+            foreach (var key in values.Keys)
+            {
+                ValidateWritableName(metadata, key);
+                if (seen.Add(key))
+                    keys.Add(key);
+            }
+        }
+
+        return keys;
+    }
+
+    /// <summary>Reads a single keyed value from an entity's store, or <see langword="null"/> when absent/unset.</summary>
+    /// <param name="store">The store property.</param>
+    /// <param name="entity">The entity instance.</param>
+    /// <param name="key">The dictionary key.</param>
+    internal static object? GetValue(IPropertyMetadata store, object entity, string key)
+    {
+        var values = ReadStore(store, entity);
+        return values is not null && values.TryGetValue(key, out var value) ? value : null;
+    }
+}
+
+/// <summary>
+/// The synthetic <see cref="IPropertyMetadata"/> of one dynamically named write column. It shares the
+/// store property's <see cref="PropertyInfo"/> (so no CLR member is invented) but carries the runtime
+/// column name; <see cref="SqlMutationBuilder"/> renders it always quoted.
+/// </summary>
+internal sealed class DynamicColumnMetadata(PropertyInfo propertyInfo, string columnName) : IPropertyMetadata
+{
+    /// <inheritdoc/>
+    public PropertyInfo PropertyInfo { get; } = propertyInfo;
+
+    /// <inheritdoc/>
+    public string ColumnName { get; } = columnName;
+
+    /// <inheritdoc/>
+    public bool IsColumnNameAuto => false;
+}
