--- /dev/null
+++ b/src/nextorm.core/DynamicColumnsAttribute.cs
@@ -0,0 +1,17 @@
+namespace NextORM.Core;
+
+/// <summary>
+/// Declares that a property holds the entity's <b>dynamic columns</b>: a dictionary of the row columns
+/// that are not mapped to a declared member. The keys are the physical column names of the result set,
+/// so the set of columns is defined by the schema at run time rather than by the CLR type.
+/// </summary>
+/// <remarks>
+/// The property must be assignable to <see cref="IDictionary{TKey,TValue}"/> of
+/// <see cref="string"/>/<see cref="object"/> (typically <c>IDictionary&lt;string, object?&gt;</c> or
+/// <c>Dictionary&lt;string, object?&gt;</c>) and writable. On read every column of the result set that
+/// does not map to a declared member is added to the dictionary; on insert/update/merge the dictionary
+/// keys are rendered as (always quoted) columns. The mapping can also be declared fluently with
+/// <see cref="EntityPropertyBuilder{T}.DynamicColumns"/>.
+/// </remarks>
+[AttributeUsage(AttributeTargets.Property, AllowMultiple = false, Inherited = true)]
+public sealed class DynamicColumnsAttribute : Attribute;
