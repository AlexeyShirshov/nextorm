--- /dev/null
+++ b/src/nextorm.core/DataContext/DynamicColumnsReader.cs
@@ -0,0 +1,67 @@
+using System.Data;
+using System.Reflection;
+
+namespace NextORM.Core;
+
+/// <summary>
+/// Reads the "extra" columns of a result set into a dynamic-columns store. Used by the compiled row
+/// mapper: a store column has no physical ordinal of its own, so its value is materialised from the
+/// reader's columns at execution time.
+/// </summary>
+internal static class DynamicColumnsReader
+{
+    internal static readonly MethodInfo ReadRangeMI = typeof(DynamicColumnsReader).GetMethod(nameof(ReadRange), BindingFlags.Public | BindingFlags.Static)!;
+    internal static readonly MethodInfo ReadIndicesMI = typeof(DynamicColumnsReader).GetMethod(nameof(ReadIndices), BindingFlags.Public | BindingFlags.Static)!;
+
+    /// <summary>
+    /// Reads the contiguous wildcard region that follows the mapped columns of an entity query. The
+    /// mapped columns occupy the reader ordinals <c>[0, mappedCount)</c>; every later column whose name
+    /// does not match one of them is an extra dynamic column.
+    /// </summary>
+    /// <param name="record">The data record positioned on the current row.</param>
+    /// <param name="mappedCount">The number of explicitly selected (mapped) columns before the wildcard.</param>
+    /// <returns>The extra columns, keyed by name (case-insensitive).</returns>
+    public static Dictionary<string, object?> ReadRange(IDataRecord record, int mappedCount)
+    {
+        var result = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
+        var fieldCount = record.FieldCount;
+
+        for (var i = mappedCount; i < fieldCount; i++)
+        {
+            var name = record.GetName(i);
