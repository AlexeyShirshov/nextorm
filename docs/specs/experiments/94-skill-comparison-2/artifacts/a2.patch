+using System.ComponentModel.DataAnnotations;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.ClickHouse.Tests;
+
+[SqlTable("dynamic_event")]
+public class DynamicEvent
+{
+    [Key]
+    public int Id { get; set; }
+    public string? Name { get; set; }
+    [DynamicColumns]
+    public IDictionary<string, object?> Extra { get; set; } = new Dictionary<string, object?>();
+}
+
+public class DynamicColumnsSqlGenerationTests
+{
+    private static string Normalize(string sql) => sql.Replace("\r\n", "\n");
+
+    private static string SqlOf<T>(IDataContext ctx, QueryCommand<T> cmd)
+        => Normalize(((DbPreparedQueryCommand<T>)ctx.GetPreparedQueryCommand(cmd, false, false, CancellationToken.None)).DbCommand.CommandText);
+
+    [Fact]
+    public void Select_DynamicColumns_UseBacktickQuoting()
+    {
+        using var ctx = ClickHouseTestContext.Create();
+
+        SqlOf(ctx, ctx.From<DynamicEvent>().WithDynamicColumns("region").ToCommand())
+            .Should().Be("select Id, Name, `region` from dynamic_event");
+    }
+
+    [Fact]
+    public void Insert_DynamicColumns_UseBacktickQuoting()
+    {
+        using var ctx = ClickHouseTestContext.Create();
+        var entity = new DynamicEvent
+        {
+            Id = 1,
+            Name = "n",
+            Extra = new Dictionary<string, object?> { ["region"] = "eu" },
+        };
+
+        Normalize(ctx.InsertInto<DynamicEvent>().Values(entity).ToSql())
+            .Should().Contain("(Id, Name, `region`)");
+    }
+}
