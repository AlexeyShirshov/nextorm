+namespace NextORM.Core;
+
+/// <summary>
+/// Declares that a property holds the dynamic-columns store of the entity: the columns of the row that
+/// are not mapped to declared properties. The property type must implement
+/// <see cref="IDictionary{TKey,TValue}"/> of <see cref="string"/> to <see cref="object"/>.
+/// </summary>
+/// <remarks>
+/// On read the columns named by <see cref="EntityBuilder{TEntity}.WithDynamicColumns(string[])"/> are
+/// materialized into the store instead of a CLR property; on write the store's keys are rendered as
+/// columns. The key set participates in the query plan, so two queries with different dynamic-column
+/// sets never share a cached plan. The fluent equivalent is
