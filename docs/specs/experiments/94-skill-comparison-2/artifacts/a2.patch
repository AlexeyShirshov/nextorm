@@ -0,0 +1,66 @@
+using FluentAssertions;
+
+namespace NextORM.Core.Tests;
+
+public class DynamicEntity
+{
+    public int Id { get; set; }
+    [DynamicColumns]
+    public IDictionary<string, object?> Extra { get; set; } = new Dictionary<string, object?>();
+}
+
+public class NoStoreEntity
+{
+    public int Id { get; set; }
+}
+
+public class DynamicColumnsTests
+{
+    [Fact]
+    public void InMemoryRead_ReturnsTheEntityStore()
+    {
+        using var ctx = new InMemoryDataContext();
+        var store = new Dictionary<string, object?> { ["region"] = "eu" };
+        ctx.Data[typeof(DynamicEntity)] = new[] { new DynamicEntity { Id = 1, Extra = store } };
+
+        var row = ctx.From<DynamicEntity>().WithDynamicColumns("region").ToList().Single();
+
+        row.Extra.Should().BeSameAs(store);
+    }
+
+    [Fact]
+    public void InMemoryRead_WithoutStore_ShouldThrow()
+    {
+        using var ctx = new InMemoryDataContext();
+        ctx.Data[typeof(NoStoreEntity)] = new[] { new NoStoreEntity { Id = 1 } };
+
+        var act = () => ctx.From<NoStoreEntity>().WithDynamicColumns("region").ToList();
+
+        act.Should().Throw<QueryPreparationException>().WithMessage("*dynamic-columns store*");
+    }
+
+    [Fact]
+    public void InMemoryRead_ExplicitProjectionWithStore_ShouldThrow()
+    {
+        using var ctx = new InMemoryDataContext();
+        ctx.Data[typeof(DynamicEntity)] = new[] { new DynamicEntity { Id = 1 } };
+
+        var act = () => ctx.From<DynamicEntity>().WithDynamicColumns("region").Select(x => new { x.Id }).ToList();
+
+        act.Should().Throw<NotSupportedException>().WithMessage("*without an explicit Select*");
+    }
+
+    [Fact]
+    public void FluentMapping_DeclaresTheStore()
+    {
+        using var ctx = new InMemoryDataContext();
+        ctx.Data[typeof(DynamicEntity)] = new[] { new DynamicEntity { Id = 1 } };
+
+        var row = ctx.From<DynamicEntity>(b => b.Property(x => x.Extra).DynamicColumns())
+            .WithDynamicColumns("region")
+            .ToList()
+            .Single();
+
+        row.Extra.Should().BeEmpty();
+    }
+}
