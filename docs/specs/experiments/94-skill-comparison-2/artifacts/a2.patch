+namespace NextORM.Core;
+
+/// <summary>
+/// Shared facts about the dynamic-columns store property: which CLR types can hold it and the
+/// actionable error raised for the rest. Used by both the attribute (reflection) and the fluent
+/// mapping path so the two cannot drift apart.
+/// </summary>
+internal static class DynamicColumnsFacts
+{
+    /// <summary>
+    /// Whether <paramref name="type"/> can receive the materialized
+    /// <see cref="Dictionary{TKey,TValue}"/> of <see cref="string"/> to <see cref="object"/>:
+    /// <see cref="IDictionary{TKey,TValue}"/> or a type implementing it.
+    /// </summary>
+    internal static bool IsStoreType(Type type)
+        => typeof(IDictionary<string, object?>).IsAssignableFrom(type);
+
