+using System.ComponentModel.DataAnnotations;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Postgres.Tests;
+
+[SqlTable("dynamic_event")]
+public class DynamicEvent
+{
+    [Key]
+    public int Id { get; set; }
+    public string? Name { get; set; }
+    [DynamicColumns]
+    public IDictionary<string, object?> Extra { get; set; } = new Dictionary<string, object?>();
+}
+
+[SqlTable("no_store_entity")]
+public class NoStoreEntity
+{
+    [Key]
+    public int Id { get; set; }
+}
+
+public class DynamicColumnsSqlGenerationTests
+{
+    private static string Normalize(string sql) => sql.Replace("\r\n", "\n");
+
+    private static string SqlOf<T>(IDataContext ctx, QueryCommand<T> cmd)
+        => Normalize(((DbPreparedQueryCommand<T>)ctx.GetPreparedQueryCommand(cmd, false, false, CancellationToken.None)).DbCommand.CommandText);
+
+    [Fact]
+    public void Select_DynamicColumns_AppendsQuotedIdentifiers()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var e = ctx.From<DynamicEvent>();
+
+        SqlOf(ctx, e.WithDynamicColumns("region", "score").ToCommand())
+            .Should().Be("select Id, Name, \"region\", \"score\" from dynamic_event");
+    }
+
+    [Fact]
+    public void Select_DynamicColumns_AreQuotedEvenWhenContextIsNot()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var e = ctx.From<DynamicEvent>();
+
+        var sql = SqlOf(ctx, e.WithDynamicColumns("weird \"name\"").ToCommand());
+
+        sql.Should().Contain("\"weird \"\"name\"\"\"");
+    }
+
+    [Fact]
+    public void Select_NoDynamicColumns_DoesNotProjectTheStore()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var e = ctx.From<DynamicEvent>();
+
+        SqlOf(ctx, e.ToCommand()).Should().Be("select Id, Name from dynamic_event");
+    }
+
+    [Fact]
+    public void Select_DifferentDynamicSets_ProduceDifferentPlans()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var e = ctx.From<DynamicEvent>();
+
+        var first = SqlOfCached(ctx, e.WithDynamicColumns("a").ToCommand());
+        var second = SqlOfCached(ctx, e.WithDynamicColumns("a", "b").ToCommand());
+        var firstAgain = SqlOfCached(ctx, e.WithDynamicColumns("a").ToCommand());
+
+        first.Should().Be("select Id, Name, \"a\" from dynamic_event");
+        second.Should().Be("select Id, Name, \"a\", \"b\" from dynamic_event");
+        firstAgain.Should().Be("select Id, Name, \"a\" from dynamic_event");
+    }
+
+    private static string SqlOfCached<T>(IDataContext ctx, QueryCommand<T> cmd)
+        => Normalize(((DbPreparedQueryCommand<T>)ctx.GetPreparedQueryCommand(cmd, false, true, CancellationToken.None)).DbCommand.CommandText);
+
+    [Fact]
+    public void Select_WithoutAStore_ShouldThrow()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var act = () => SqlOf(ctx, ctx.From<NoStoreEntity>().WithDynamicColumns("a").ToCommand());
+
+        act.Should().Throw<QueryPreparationException>().WithMessage("*dynamic-columns store*");
+    }
+
+    [Fact]
+    public void WithDynamicColumns_ExplicitProjection_ShouldThrow()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var act = () => SqlOf(ctx, ctx.From<DynamicEvent>().WithDynamicColumns("a").Select(x => new { x.Id }));
+
+        act.Should().Throw<NotSupportedException>().WithMessage("*without an explicit Select*");
+    }
+
+    [Fact]
+    public void WithDynamicColumns_DuplicateName_ShouldThrow()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var act = () => ctx.From<DynamicEvent>().WithDynamicColumns("a", "a");
+
+        act.Should().Throw<ArgumentException>().WithMessage("*more than once*");
+    }
+
+    [Fact]
+    public void Insert_Entity_StoreKeysBecomeQuotedColumns()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var entity = new DynamicEvent
+        {
+            Id = 1,
+            Name = "n",
+            Extra = new Dictionary<string, object?> { ["region"] = "eu", ["score"] = 5 },
+        };
+
+        var sql = ctx.InsertInto<DynamicEvent>().Values(entity).ToSql();
+
+        Normalize(sql).Should().Be("insert into dynamic_event (Id, Name, \"region\", \"score\") values (@p0, @p1, @p2, @p3)");
+    }
+
+    [Fact]
+    public void Update_Entity_StoreKeysBecomeQuotedSetColumns()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var entity = new DynamicEvent
+        {
+            Id = 1,
+            Extra = new Dictionary<string, object?> { ["region"] = "eu" },
+        };
+
+        var sql = ctx.Update<DynamicEvent>().Set(entity).Where(x => x.Id == 1).ToSql();
+
+        Normalize(sql).Should().Be("update dynamic_event set Name = @p0, \"region\" = @p1 where Id = 1");
+    }
+
+    [Fact]
+    public void Merge_Entity_StoreKeysBecomeQuotedColumns()
+    {
+        using var ctx = PostgresTestContext.Create();
+        var entity = new DynamicEvent
+        {
+            Id = 1,
+            Name = "n",
+            Extra = new Dictionary<string, object?> { ["region"] = "eu" },
+        };
+
+        var sql = ctx.MergeInto<DynamicEvent>()
+            .Using(entity)
+            .OnKeys()
+            .WhenMatchedUpdate()
+            .WhenNotMatchedInsert()
+            .ToSql();
+
+        Normalize(sql).Should().Contain("\"region\"");
+    }
+}
