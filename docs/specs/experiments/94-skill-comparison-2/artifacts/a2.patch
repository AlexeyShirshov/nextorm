@@ -0,0 +1,72 @@
+using System.ComponentModel.DataAnnotations;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Integration.Tests;
+
+[SqlTable("dynamic_event")]
+public class DynamicEvent
+{
+    [Key]
+    public int Id { get; set; }
+    public string? Name { get; set; }
+    [DynamicColumns]
+    public IDictionary<string, object?> Extra { get; set; } = new Dictionary<string, object?>();
+}
+
+/// <summary>
+/// Round-trips the dynamic-columns store against a real database. SQLite is the provider that needs no
+/// container, so the test always runs; the SQL-generation tests cover the other providers' quoting.
+/// </summary>
+[Collection("Sqlite")]
+public sealed class DynamicColumnsIntegrationTests : ProviderTestSuite
+{
+    protected override ITestProvider Provider => SqliteTestProvider.Instance;
+
+    [Fact]
+    public void Read_DynamicColumns_FillsTheStore()
+    {
+        var row = _sut.DataProvider.From<DynamicEvent>()
+            .Where(x => x.Id == 1)
+            .WithDynamicColumns("region", "score")
+            .ToList()
+            .Single();
+
+        row.Name.Should().Be("a");
+        row.Extra.Should().ContainKey("region").WhoseValue.Should().Be("eu");
+        row.Extra["score"].Should().Be(5L);
+    }
+
+    [Fact]
+    public void Read_WithoutDynamicColumns_LeavesTheStoreEmpty()
+    {
+        var row = _sut.DataProvider.From<DynamicEvent>()
+            .Where(x => x.Id == 1)
+            .ToList()
+            .Single();
+
+        row.Extra.Should().BeEmpty();
+    }
+
+    [Fact]
+    public void Insert_Entity_WritesStoreKeysAsColumns()
+    {
+        var entity = new DynamicEvent
+        {
+            Id = 3,
+            Name = "c",
+            Extra = new Dictionary<string, object?> { ["region"] = "ap", ["score"] = 1 },
+        };
+
+        _sut.DataProvider.InsertInto<DynamicEvent>().Values(entity).Insert().Should().Be(1);
+
+        var row = _sut.DataProvider.From<DynamicEvent>()
+            .Where(x => x.Id == 3)
+            .WithDynamicColumns("region", "score")
+            .ToList()
+            .Single();
+
+        row.Extra["region"].Should().Be("ap");
+        row.Extra["score"].Should().Be(1L);
+    }
+}
