--- /dev/null
+++ b/src/nextorm.core/Query/CsvExtensions.cs
@@ -0,0 +1,88 @@
+namespace NextORM.Core;
+
+/// <summary>
+/// Terminal operators that stream a query to RFC 4180 CSV. Available on relational providers only;
+/// the in-memory provider throws <see cref="NotSupportedException"/> because it has no <see cref="System.Data.Common.DbDataReader"/>.
+/// </summary>
+public static class CsvExtensions
+{
+    /// <summary>Writes the command's rows as RFC 4180 CSV to <paramref name="output"/>.</summary>
+    /// <typeparam name="TResult">The projected result type.</typeparam>
+    /// <param name="command">The command to run.</param>
+    /// <param name="output">The writable stream that receives the CSV; it is left open.</param>
+    /// <param name="includeHeader">Whether to write a header line built from the reader's column names.</param>
+    /// <param name="cancellationToken">A token that cancels the read.</param>
+    /// <remarks>Relational providers only; the in-memory provider throws <see cref="NotSupportedException"/>.</remarks>
+    public static void ToCsv<TResult>(this QueryCommand<TResult> command, Stream output, bool includeHeader = true, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+        ArgumentNullException.ThrowIfNull(output);
+        EnsureWritable(output);
+
+        if (command.DataContext is not DataContext db)
+            throw new NotSupportedException("CSV export requires a database provider; the in-memory provider has no DbDataReader.");
+
+        using var reader = new LobDataReader(db.OpenQueryReader(command, ReadOnlySpan<object?>.Empty, cancellationToken), cancellationToken);
+        CsvWriter.Write(reader, output, includeHeader, cancellationToken);
+    }
+
+    /// <summary>Asynchronously writes the command's rows as RFC 4180 CSV to <paramref name="output"/>.</summary>
+    /// <typeparam name="TResult">The projected result type.</typeparam>
+    /// <param name="command">The command to run.</param>
+    /// <param name="output">The writable stream that receives the CSV; it is left open.</param>
+    /// <param name="includeHeader">Whether to write a header line built from the reader's column names.</param>
+    /// <param name="cancellationToken">A token that cancels the read.</param>
+    /// <returns>A task that completes when all rows are written.</returns>
+    /// <remarks>Relational providers only; the in-memory provider throws <see cref="NotSupportedException"/>.</remarks>
+    public static async Task ToCsvAsync<TResult>(this QueryCommand<TResult> command, Stream output, bool includeHeader = true, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+        ArgumentNullException.ThrowIfNull(output);
+        EnsureWritable(output);
+
+        if (command.DataContext is not DataContext db)
+            throw new NotSupportedException("CSV export requires a database provider; the in-memory provider has no DbDataReader.");
+
+        await using var reader = new LobDataReader(await db.OpenQueryReaderAsync(command, null, cancellationToken).ConfigureAwait(false), cancellationToken);
+        await CsvWriter.WriteAsync(reader, output, includeHeader, cancellationToken).ConfigureAwait(false);
+    }
+
+    /// <summary>Writes the entity builder's rows as RFC 4180 CSV to <paramref name="output"/>.</summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="builder">The builder whose command is run.</param>
+    /// <param name="output">The writable stream that receives the CSV; it is left open.</param>
+    /// <param name="includeHeader">Whether to write a header line built from the reader's column names.</param>
+    /// <param name="cancellationToken">A token that cancels the read.</param>
+    /// <remarks>Relational providers only; the in-memory provider throws <see cref="NotSupportedException"/>.</remarks>
+    public static void ToCsv<TEntity>(this EntityBuilder<TEntity> builder, Stream output, bool includeHeader = true, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(builder);
+        ArgumentNullException.ThrowIfNull(output);
+        EnsureWritable(output);
+
+        builder.ToCommand().ToCsv(output, includeHeader, cancellationToken);
+    }
+
+    /// <summary>Asynchronously writes the entity builder's rows as RFC 4180 CSV to <paramref name="output"/>.</summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="builder">The builder whose command is run.</param>
+    /// <param name="output">The writable stream that receives the CSV; it is left open.</param>
+    /// <param name="includeHeader">Whether to write a header line built from the reader's column names.</param>
+    /// <param name="cancellationToken">A token that cancels the read.</param>
+    /// <returns>A task that completes when all rows are written.</returns>
+    /// <remarks>Relational providers only; the in-memory provider throws <see cref="NotSupportedException"/>.</remarks>
+    public static async Task ToCsvAsync<TEntity>(this EntityBuilder<TEntity> builder, Stream output, bool includeHeader = true, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(builder);
+        ArgumentNullException.ThrowIfNull(output);
+        EnsureWritable(output);
+
+        await builder.ToCommand().ToCsvAsync(output, includeHeader, cancellationToken).ConfigureAwait(false);
+    }
+
+    private static void EnsureWritable(Stream output)
+    {
+        if (!output.CanWrite)
+            throw new ArgumentException("The output stream must be writable.", nameof(output));
+    }
+}
