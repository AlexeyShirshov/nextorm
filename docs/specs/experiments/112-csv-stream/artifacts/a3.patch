+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        var prepared = PrepareQueryReaderCommand(queryCommand, cancellationToken);
+        return _executor.OpenLobReader(prepared, parameters);
+    }
+
+    /// <summary>Asynchronously prepares <paramref name="queryCommand"/> without sequential access and opens a reader over it.</summary>
+    /// <typeparam name="TResult">The projected result type.</typeparam>
+    /// <param name="queryCommand">The command to prepare and execute.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <param name="cancellationToken">Cancels preparation and opening the reader.</param>
+    /// <returns>A task producing an owner of the open reader and its per-call command.</returns>
+    internal async Task<CommandReaderOwner> OpenQueryReaderAsync<TResult>(QueryCommand<TResult> queryCommand, object[]? parameters, CancellationToken cancellationToken)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        var prepared = PrepareQueryReaderCommand(queryCommand, cancellationToken);
+        return await _executor.OpenLobReaderAsync(prepared, parameters, cancellationToken).ConfigureAwait(false);
+    }
+
+    private DbPreparedQueryCommand<TResult> PrepareQueryReaderCommand<TResult>(QueryCommand<TResult> queryCommand, CancellationToken cancellationToken)
+    {
+        ObjectDisposedException.ThrowIf(_disposed, nameof(DataContext));
