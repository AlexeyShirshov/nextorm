+        // access off: the SQL gains no locator column and the reader behavior stays Default.
+        return (DbPreparedQueryCommand<TResult>)GetPreparedQueryCommand(queryCommand, createEnumerator: false, storeInCache: false, streamingRows: false, cancellationToken);
