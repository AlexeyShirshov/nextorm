+using System.Data.Common;
+using System.Globalization;
+using System.Reflection;
+using System.Text;
+
+namespace NextORM.Core;
+
+/// <summary>
+/// Streams a <see cref="DbDataReader"/> to RFC 4180 CSV without materializing the rows. Fields are
+/// CRLF terminated, quoted only when needed, and the output stream is left open.
+/// </summary>
+internal static class CsvWriter
+{
+    /// <summary>Writes every row of <paramref name="reader"/> to <paramref name="output"/> as CSV.</summary>
+    internal static void Write(DbDataReader reader, Stream output, bool includeHeader, CancellationToken cancellationToken)
+    {
+        ArgumentNullException.ThrowIfNull(reader);
+        ArgumentNullException.ThrowIfNull(output);
+
+        using var writer = CreateWriter(output);
+        WriteCore(reader, writer, includeHeader, cancellationToken);
+    }
+
+    /// <summary>Asynchronously writes every row of <paramref name="reader"/> to <paramref name="output"/> as CSV.</summary>
+    internal static async Task WriteAsync(DbDataReader reader, Stream output, bool includeHeader, CancellationToken cancellationToken)
+    {
+        ArgumentNullException.ThrowIfNull(reader);
+        ArgumentNullException.ThrowIfNull(output);
+
+        await using var writer = CreateWriter(output);
+        await WriteCoreAsync(reader, writer, includeHeader, cancellationToken).ConfigureAwait(false);
+    }
+
+    private static void WriteCore(DbDataReader reader, TextWriter writer, bool includeHeader, CancellationToken cancellationToken)
+    {
+        var fieldCount = reader.FieldCount;
+        var formatters = CreateFormatters(reader, fieldCount);
+
+        if (includeHeader)
+        {
+            for (var i = 0; i < fieldCount; i++)
+            {
+                if (i > 0)
+                    writer.Write(',');
+                WriteField(writer, reader.GetName(i));
+            }
+
+            writer.Write("\r\n");
+        }
+
+        while (reader.Read())
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+
+            for (var i = 0; i < fieldCount; i++)
+            {
+                if (i > 0)
+                    writer.Write(',');
+
+                if (reader.IsDBNull(i))
+                    continue;
+
+                WriteField(writer, formatters[i].Format(reader, i));
+            }
+
+            writer.Write("\r\n");
+        }
+    }
+
+    private static async Task WriteCoreAsync(DbDataReader reader, TextWriter writer, bool includeHeader, CancellationToken cancellationToken)
+    {
+        var fieldCount = reader.FieldCount;
+        var formatters = CreateFormatters(reader, fieldCount);
+
+        if (includeHeader)
+        {
+            for (var i = 0; i < fieldCount; i++)
+            {
+                if (i > 0)
+                    await writer.WriteAsync(',').ConfigureAwait(false);
+                await WriteFieldAsync(writer, reader.GetName(i)).ConfigureAwait(false);
+            }
+
+            await writer.WriteAsync("\r\n").ConfigureAwait(false);
+        }
+
+        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+
+            for (var i = 0; i < fieldCount; i++)
+            {
+                if (i > 0)
+                    await writer.WriteAsync(',').ConfigureAwait(false);
+
+                if (await reader.IsDBNullAsync(i, cancellationToken).ConfigureAwait(false))
+                    continue;
+
+                await WriteFieldAsync(writer, formatters[i].Format(reader, i)).ConfigureAwait(false);
+            }
+
+            await writer.WriteAsync("\r\n").ConfigureAwait(false);
+        }
+    }
+
+    private static ICsvFieldFormatter[] CreateFormatters(DbDataReader reader, int fieldCount)
+    {
+        var formatters = new ICsvFieldFormatter[fieldCount];
+        for (var i = 0; i < fieldCount; i++)
+            formatters[i] = CreateFormatter(reader.GetFieldType(i));
+
+        return formatters;
+    }
+
+    private static ICsvFieldFormatter CreateFormatter(Type fieldType)
+        => (ICsvFieldFormatter)Activator.CreateInstance(typeof(CsvFieldFormatter<>).MakeGenericType(fieldType))!;
+
+    private static StreamWriter CreateWriter(Stream output)
+        => new(output, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false), bufferSize: 1024, leaveOpen: true);
+
+    private static void WriteField(TextWriter writer, string value)
+    {
+        if (value.Length == 0)
+            return;
+
+        if (!NeedsQuoting(value))
+        {
+            writer.Write(value);
+            return;
+        }
+
+        writer.Write('"');
+        writer.Write(value.Replace("\"", "\"\""));
+        writer.Write('"');
+    }
+
+    private static async Task WriteFieldAsync(TextWriter writer, string value)
+    {
+        if (value.Length == 0)
+            return;
+
+        if (!NeedsQuoting(value))
+        {
+            await writer.WriteAsync(value).ConfigureAwait(false);
+            return;
+        }
+
+        await writer.WriteAsync('"').ConfigureAwait(false);
+        await writer.WriteAsync(value.Replace("\"", "\"\"")).ConfigureAwait(false);
+        await writer.WriteAsync('"').ConfigureAwait(false);
+    }
+
+    private static bool NeedsQuoting(string value)
+        => value.AsSpan().IndexOfAny([',', '"', '\r', '\n']) >= 0;
+}
+
+/// <summary>Formats one column of a <see cref="DbDataReader"/> row into its CSV text representation.</summary>
+internal interface ICsvFieldFormatter
+{
+    /// <summary>Formats the value at <paramref name="ordinal"/>, which the caller has already checked for NULL.</summary>
+    string Format(DbDataReader reader, int ordinal);
+}
+
+/// <summary>Typed <see cref="ICsvFieldFormatter"/> that reads a column without boxing or per-row reflection.</summary>
+internal sealed class CsvFieldFormatter<T> : ICsvFieldFormatter
+{
+    /// <inheritdoc/>
+    public string Format(DbDataReader reader, int ordinal)
+        => CsvValueFormatter<T>.Format(reader.GetFieldValue<T>(ordinal));
+}
+
+/// <summary>
+/// Closed-generic per-column-type formatter. The <see cref="ISpanFormattable"/> check and the delegate
+/// binding happen once per closed <typeparamref name="T"/> in the static initializer; the per-row path
+/// goes through the strongly-typed <see cref="Formatter"/> delegate, so value types are never boxed.
+/// </summary>
+internal static class CsvValueFormatter<T>
+{
+    private static readonly Func<T, string> Formatter = CreateFormatter();
+
+    public static string Format(T value) => Formatter(value);
+
+    private static Func<T, string> CreateFormatter()
+    {
+        if (typeof(T) == typeof(string))
+            return static v => (string)(object)v!;
+        if (typeof(T) == typeof(byte[]))
+            return static v => Convert.ToBase64String((byte[])(object)v!);
+        if (typeof(ISpanFormattable).IsAssignableFrom(typeof(T)))
+        {
+            var method = typeof(CsvValueFormatter<T>).GetMethod(
+                nameof(FormatSpan), BindingFlags.NonPublic | BindingFlags.Static)!.MakeGenericMethod(typeof(T));
+            return (Func<T, string>)method.CreateDelegate(typeof(Func<T, string>));
+        }
+
+        return static v => v?.ToString() ?? string.Empty;
+    }
+
+    private static string FormatSpan<TValue>(TValue value)
+        where TValue : ISpanFormattable
+    {
+        Span<char> buffer = stackalloc char[128];
+        if (value.TryFormat(buffer, out int written, default, CultureInfo.InvariantCulture))
+            return new string(buffer[..written]);
+
+        return value.ToString(null, CultureInfo.InvariantCulture) ?? string.Empty;
+    }
+}
