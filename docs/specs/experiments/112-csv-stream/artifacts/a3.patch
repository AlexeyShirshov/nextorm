+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Core.Tests;
+
+/// <summary>
+/// The <c>ToCsv</c>/<c>ToCsvAsync</c> terminals. The in-memory provider has no
+/// <see cref="System.Data.Common.DbDataReader"/>, so every overload fails closed with
+/// <see cref="NotSupportedException"/>; argument validation happens before the provider seam.
+/// </summary>
+public class CsvExtensionsTests
+{
+    private static InMemoryDataContext ContextWithRow()
+    {
+        var ctx = new InMemoryDataContext();
+        ctx.From<SimpleEntity>().WithData(new[] { new SimpleEntity { Id = 1 } });
+        return ctx;
+    }
+
+    // --- In-memory provider: no reader, so every overload is rejected. ---
+
+    [Fact]
+    public void QueryCommand_ToCsv_InMemory_ShouldThrowNotSupported()
+    {
+        using var ctx = ContextWithRow();
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+        using var output = new MemoryStream();
+
+        var act = () => command.ToCsv(output);
+
+        act.Should().Throw<NotSupportedException>();
+    }
+
+    [Fact]
+    public async Task QueryCommand_ToCsvAsync_InMemory_ShouldThrowNotSupported()
+    {
+        using var ctx = ContextWithRow();
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+        using var output = new MemoryStream();
+
+        var act = async () => await command.ToCsvAsync(output);
+
+        await act.Should().ThrowAsync<NotSupportedException>();
+    }
+
+    [Fact]
+    public void EntityBuilder_ToCsv_InMemory_ShouldThrowNotSupported()
+    {
+        using var ctx = ContextWithRow();
+        using var output = new MemoryStream();
+
+        var act = () => ctx.From<SimpleEntity>().ToCsv(output);
+
+        act.Should().Throw<NotSupportedException>();
+    }
+
+    [Fact]
+    public async Task EntityBuilder_ToCsvAsync_InMemory_ShouldThrowNotSupported()
+    {
+        using var ctx = ContextWithRow();
+        using var output = new MemoryStream();
+
+        var act = async () => await ctx.From<SimpleEntity>().ToCsvAsync(output);
+
+        await act.Should().ThrowAsync<NotSupportedException>();
+    }
+
+    // --- Argument validation: null output / non-writable output precede execution. ---
+
+    [Fact]
+    public void QueryCommand_ToCsv_NullOutput_ShouldThrowArgumentNull()
+    {
+        using var ctx = ContextWithRow();
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+
+        var act = () => command.ToCsv(null!);
+
+        act.Should().Throw<ArgumentNullException>();
+    }
+
+    [Fact]
+    public async Task QueryCommand_ToCsvAsync_NullOutput_ShouldThrowArgumentNull()
+    {
+        using var ctx = ContextWithRow();
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+
+        var act = async () => await command.ToCsvAsync(null!);
+
+        await act.Should().ThrowAsync<ArgumentNullException>();
+    }
+
+    [Fact]
+    public void EntityBuilder_ToCsv_NullOutput_ShouldThrowArgumentNull()
+    {
+        using var ctx = ContextWithRow();
+
+        var act = () => ctx.From<SimpleEntity>().ToCsv(null!);
+
+        act.Should().Throw<ArgumentNullException>();
+    }
+
+    [Fact]
+    public async Task EntityBuilder_ToCsvAsync_NullOutput_ShouldThrowArgumentNull()
+    {
+        using var ctx = ContextWithRow();
+
+        var act = async () => await ctx.From<SimpleEntity>().ToCsvAsync(null!);
+
+        await act.Should().ThrowAsync<ArgumentNullException>();
+    }
+
+    [Fact]
+    public void QueryCommand_ToCsv_NonWritableOutput_ShouldThrowArgument()
+    {
+        using var ctx = ContextWithRow();
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+        using var output = new MemoryStream(new byte[0], writable: false);
+
+        var act = () => command.ToCsv(output);
+
+        act.Should().Throw<ArgumentException>();
+    }
+
+    [Fact]
+    public async Task QueryCommand_ToCsvAsync_NonWritableOutput_ShouldThrowArgument()
+    {
+        using var ctx = ContextWithRow();
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+        using var output = new MemoryStream(new byte[0], writable: false);
+
+        var act = async () => await command.ToCsvAsync(output);
+
+        await act.Should().ThrowAsync<ArgumentException>();
+    }
+
+    [Fact]
+    public void EntityBuilder_ToCsv_NonWritableOutput_ShouldThrowArgument()
+    {
+        using var ctx = ContextWithRow();
+        using var output = new MemoryStream(new byte[0], writable: false);
+
+        var act = () => ctx.From<SimpleEntity>().ToCsv(output);
+
+        act.Should().Throw<ArgumentException>();
+    }
+
+    [Fact]
+    public async Task EntityBuilder_ToCsvAsync_NonWritableOutput_ShouldThrowArgument()
+    {
+        using var ctx = ContextWithRow();
+        using var output = new MemoryStream(new byte[0], writable: false);
+
+        var act = async () => await ctx.From<SimpleEntity>().ToCsvAsync(output);
+
+        await act.Should().ThrowAsync<ArgumentException>();
+    }
+}
diff --git a/tests/nextorm.core.tests/CsvWriterTests.cs b/tests/nextorm.core.tests/CsvWriterTests.cs
new file mode 100644
index 0000000..14d27e0
--- /dev/null
+++ b/tests/nextorm.core.tests/CsvWriterTests.cs
@@ -0,0 +1,197 @@
+using System.Data;
+using System.Globalization;
+using System.Text;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Core.Tests;
+
+/// <summary>
+/// Coverage for the internal <see cref="CsvWriter"/> streaming formatter. A real
+/// <see cref="DataTableReader"/> stands in for a provider reader, so the RFC 4180 rules, the
+/// invariant formatting and the sync/async parity are pinned without a database.
+/// </summary>
+public class CsvWriterTests
+{
+    private static string Write(DataTable table, bool includeHeader = true)
+    {
+        using var output = new MemoryStream();
+        using var reader = new DataTableReader(table);
+        CsvWriter.Write(reader, output, includeHeader, CancellationToken.None);
+        return Encoding.UTF8.GetString(output.ToArray());
+    }
+
+    private static async Task<string> WriteAsync(DataTable table, bool includeHeader = true)
+    {
+        using var output = new MemoryStream();
+        using var reader = new DataTableReader(table);
+        await CsvWriter.WriteAsync(reader, output, includeHeader, CancellationToken.None);
+        return Encoding.UTF8.GetString(output.ToArray());
+    }
+
+    private static DataTable Table(params (string Name, Type Type, object? Value)[] columns)
+    {
+        var table = new DataTable();
+        foreach (var column in columns)
+            table.Columns.Add(column.Name, column.Type);
+        table.Rows.Add(columns.Select(c => c.Value ?? DBNull.Value).ToArray());
+        return table;
+    }
+
+    [Fact]
+    public void Types_ShouldFormatExactCsvWithHeaderAndCrlf()
+    {
+        var table = Table(
+            ("S", typeof(string), "hello"),
+            ("I", typeof(int), 42),
+            ("D", typeof(decimal), 12.34m),
+            ("F", typeof(double), 2.5),
+            ("T", typeof(DateTime), new DateTime(2026, 1, 2, 3, 4, 5)),
+            ("G", typeof(Guid), new Guid("11111111-2222-3333-4444-555555555555")),
+            ("B", typeof(bool), true),
+            ("Y", typeof(byte[]), new byte[] { 1, 2, 3 }));
+
+        var csv = Write(table);
+
+        csv.Should().Be(
+            "S,I,D,F,T,G,B,Y\r\n" +
+            "hello,42,12.34,2.5,01/02/2026 03:04:05,11111111-2222-3333-4444-555555555555,True,AQID\r\n");
+    }
+
+    [Fact]
+    public void DBNull_ShouldProduceEmptyFields()
+    {
+        var table = Table(
+            ("A", typeof(int), null),
+            ("B", typeof(string), null),
+            ("C", typeof(decimal), null));
+
+        var csv = Write(table);
+
+        csv.Should().Be("A,B,C\r\n,,\r\n");
+    }
+
+    [Fact]
+    public void SpecialCharacters_ShouldQuoteAndEscapePerRfc4180()
+    {
+        var table = Table(
+            ("H1", typeof(string), "a,b"),
+            ("H2", typeof(string), "a\"b"),
+            ("H3", typeof(string), "a\rb"),
+            ("H4", typeof(string), "a\nb"));
+
+        var csv = Write(table);
+
+        csv.Should().Be("H1,H2,H3,H4\r\n\"a,b\",\"a\"\"b\",\"a\rb\",\"a\nb\"\r\n");
+    }
+
+    [Fact]
+    public void EmptyStringAndNull_ShouldBothBeEmptyFields()
+    {
+        var table = Table(
+            ("V1", typeof(string), ""),
+            ("V2", typeof(string), null));
+
+        var csv = Write(table);
+
+        csv.Should().Be("V1,V2\r\n,\r\n");
+    }
+
+    [Fact]
+    public void IncludeHeaderFalse_ShouldStartWithDataLine()
+    {
+        var table = Table(
+            ("S", typeof(string), "hello"),
+            ("I", typeof(int), 42));
+
+        var csv = Write(table, includeHeader: false);
+
+        csv.Should().Be("hello,42\r\n");
+    }
+
+    [Fact]
+    public void NoBom_AndAllLinesCrlfTerminated()
+    {
+        var table = Table(("S", typeof(string), "x"), ("I", typeof(int), 1));
+
+        using var output = new MemoryStream();
+        using var reader = new DataTableReader(table);
+        CsvWriter.Write(reader, output, includeHeader: true, CancellationToken.None);
+
+        output.ToArray()[0].Should().NotBe(0xEF);
+        Encoding.UTF8.GetString(output.ToArray()).Should().Be("S,I\r\nx,1\r\n");
+    }
+
+    [Fact]
+    public async Task SyncAndAsync_ShouldBeByteIdentical()
+    {
+        var table = Table(
+            ("S", typeof(string), "a,b"),
+            ("I", typeof(int), 7),
+            ("N", typeof(string), null));
+
+        var sync = Write(table);
+        var async = await WriteAsync(table);
+
+        async.Should().Be(sync);
+    }
+
+    [Fact]
+    public void OutputStream_ShouldRemainOpenAndWritable()
+    {
+        var table = Table(("S", typeof(string), "hello"));
+        using var output = new MemoryStream();
+        using (var reader = new DataTableReader(table))
+        {
+            CsvWriter.Write(reader, output, includeHeader: true, CancellationToken.None);
+        }
+
+        output.CanWrite.Should().BeTrue();
+        var lengthAfterWrite = output.Length;
+        output.WriteByte(0x21);
+
+        output.Length.Should().Be(lengthAfterWrite + 1);
+    }
+
+    [Fact]
+    public void InvariantCulture_Decimal_ShouldUsePeriodUnderDeDe()
+    {
+        var original = CultureInfo.CurrentCulture;
+        var originalDefault = CultureInfo.DefaultThreadCurrentCulture;
+        try
+        {
+            CultureInfo.CurrentCulture = new CultureInfo("de-DE");
+            CultureInfo.DefaultThreadCurrentCulture = new CultureInfo("de-DE");
+
+            var csv = Write(Table(("D", typeof(decimal), 12.34m)));
+
+            csv.Should().Be("D\r\n12.34\r\n");
+        }
+        finally
+        {
+            CultureInfo.CurrentCulture = original;
+            CultureInfo.DefaultThreadCurrentCulture = originalDefault;
+        }
+    }
+
+    [Fact]
+    public void InvariantCulture_Double_ShouldUsePeriodUnderDeDe()
+    {
+        var original = CultureInfo.CurrentCulture;
+        var originalDefault = CultureInfo.DefaultThreadCurrentCulture;
+        try
+        {
+            CultureInfo.CurrentCulture = new CultureInfo("de-DE");
+            CultureInfo.DefaultThreadCurrentCulture = new CultureInfo("de-DE");
+
+            var csv = Write(Table(("F", typeof(double), 2.5)));
+
+            csv.Should().Be("F\r\n2.5\r\n");
+        }
+        finally
+        {
+            CultureInfo.CurrentCulture = original;
+            CultureInfo.DefaultThreadCurrentCulture = originalDefault;
+        }
+    }
+}
diff --git a/tests/nextorm.integration.tests/CommonTestSuite.Csv.cs b/tests/nextorm.integration.tests/CommonTestSuite.Csv.cs
new file mode 100644
index 0000000..aa55679
--- /dev/null
+++ b/tests/nextorm.integration.tests/CommonTestSuite.Csv.cs
@@ -0,0 +1,153 @@
+using System.Text;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Integration.Tests;
+
+/// <summary>
+/// Shared coverage for the CSV streaming terminal (<c>ToCsv</c>/<c>ToCsvAsync</c>). The terminal
+/// streams any relational query as RFC 4180 CSV: header on by default, CRLF-separated lines, UTF-8
+/// without a BOM, invariant value formatting, <c>DBNull</c> rendered as an empty field and the
+/// output stream left open. Unlike the LOB terminals it is available on every relational provider;
+/// only the in-memory provider rejects it with <see cref="NotSupportedException"/>.
+/// </summary>
+/// <remarks>
+/// The facts run against the <c>complex_entity</c> fixture because every CommonTestSuite provider
+/// (SQLite, PostgreSQL, SQL Server and MySQL) creates and seeds it. Rows 1/2 carry the non-null
+/// strings <c>dadfasd</c>/<c>xxx</c>, and row 3's <c>somestring</c> is NULL for the empty-field check.
+/// </remarks>
+public abstract partial class CommonTestSuite
+{
+    private const long CsvIdA = 1;
+    private const long CsvIdB = 2;
+    private const long CsvNullId = 3;
+    private const string CsvTextA = "dadfasd";
+    private const string CsvTextB = "xxx";
+
+    private static string CsvText(MemoryStream stream) => Encoding.UTF8.GetString(stream.ToArray());
+
+    private static string[] CsvLines(string csv)
+        => csv.Split("\r\n", StringSplitOptions.RemoveEmptyEntries);
+
+    [Fact]
+    public void Csv_Projection_ShouldWriteHeaderAndRows()
+    {
+        using var ms = new MemoryStream();
+
+        _sut.ComplexEntity
+            .Where(it => it.Id >= CsvIdA && it.Id <= CsvIdB)
+            .OrderBy(it => it.Id)
+            .Select(it => new { it.Id, it.String })
+            .ToCsv(ms, cancellationToken: TestContext.Current.CancellationToken);
+
+        var bytes = ms.ToArray();
+        var text = CsvText(ms);
+
+        // UTF-8 without a BOM: the first bytes must not be the EF BB BF preamble.
+        var hasBom = bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF;
+        hasBom.Should().BeFalse("the CSV output must be UTF-8 without a BOM");
+
+        // CRLF line endings.
+        text.Should().Contain("\r\n");
+        text.Replace("\r\n", string.Empty).Should().NotContain("\n");
+
+        // Header + one line per seeded row.
+        var lines = CsvLines(text);
+        lines.Should().HaveCount(3);
+
+        // The header has one non-empty (possibly provider-aliased) name per projected column.
+        var header = lines[0].Split(',');
+        header.Should().HaveCount(2);
+        header.Should().OnlyContain(name => name.Length > 0);
+
+        text.Should().Contain(CsvTextA);
+        text.Should().Contain(CsvTextB);
+    }
+
+    [Fact]
+    public async Task Csv_SyncAndAsync_ShouldBeIdentical()
+    {
+        using var syncStream = new MemoryStream();
+        _sut.ComplexEntity
+            .Where(it => it.Id >= CsvIdA && it.Id <= CsvIdB)
+            .OrderBy(it => it.Id)
+            .Select(it => new { it.Id, it.String })
+            .ToCsv(syncStream, cancellationToken: TestContext.Current.CancellationToken);
+
+        using var asyncStream = new MemoryStream();
+        await _sut.ComplexEntity
+            .Where(it => it.Id >= CsvIdA && it.Id <= CsvIdB)
+            .OrderBy(it => it.Id)
+            .Select(it => new { it.Id, it.String })
+            .ToCsvAsync(asyncStream, cancellationToken: TestContext.Current.CancellationToken);
+
+        asyncStream.ToArray().Should().Equal(syncStream.ToArray());
+    }
+
+    [Fact]
+    public void Csv_Null_ShouldBeEmptyField()
+    {
+        using var ms = new MemoryStream();
+
+        _sut.ComplexEntity
+            .Where(it => it.Id == CsvNullId)
+            .Select(it => new { it.Id, it.String })
+            .ToCsv(ms, cancellationToken: TestContext.Current.CancellationToken);
+
+        var lines = CsvLines(CsvText(ms));
+        lines.Should().HaveCount(2);
+
+        var fields = lines[1].Split(',');
+        fields.Should().HaveCount(2);
+        fields.Should().Contain(field => field.Length == 0, "a DBNull column must render as an empty field");
+    }
+
+    [Fact]
+    public void Csv_IncludeHeaderFalse_ShouldOmitHeader()
+    {
+        using var ms = new MemoryStream();
+
+        _sut.ComplexEntity
+            .Where(it => it.Id >= CsvIdA && it.Id <= CsvIdB)
+            .OrderBy(it => it.Id)
+            .Select(it => new { it.Id, it.String })
+            .ToCsv(ms, includeHeader: false, cancellationToken: TestContext.Current.CancellationToken);
+
+        // Exactly one line per row: no header line, and the first line already carries data.
+        var lines = CsvLines(CsvText(ms));
+        lines.Should().HaveCount(2);
+        lines[0].Should().Contain(CsvTextA);
+        lines[1].Should().Contain(CsvTextB);
+    }
+
+    [Fact]
