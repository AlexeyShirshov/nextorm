+++ b/tests/nextorm.sqlite.tests/CsvExportTests.cs
@@ -0,0 +1,312 @@
+using System.ComponentModel.DataAnnotations;
+using System.ComponentModel.DataAnnotations.Schema;
+using System.Text;
+using FluentAssertions;
+using Microsoft.Data.Sqlite;
+using NextORM.Core;
+
+namespace NextORM.Sqlite.Tests;
+
+/// <summary>
+/// End-to-end coverage of the CSV export terminals (<c>ToCsv</c>/<c>ToCsvAsync</c>) against a real
+/// SQLite database: the header, the RFC 4180 escaping, <c>NULL</c>, the options, the entity builder
+/// overload, the encoding/ownership knobs and the guards (in-memory/temporary-table sources).
+/// </summary>
+public class CsvExportTests
+{
+    [SqlTable("csv_entity")]
+    public class CsvEntity
+    {
+        [Key]
+        [Column("id")]
+        public int Id { get; set; }
+        [Column("name")]
+        public string? Name { get; set; }
+        [Column("price")]
+        public double? Price { get; set; }
+        [Column("note")]
+        public string? Note { get; set; }
+    }
+
+    private static (SqliteDataContext Ctx, string Path) CreateDb()
+    {
+        var path = Path.Combine(Path.GetTempPath(), $"nextorm-csv-{Guid.NewGuid():N}.db");
+        using (var conn = new SqliteConnection($"Data Source={path}"))
+        {
+            conn.Open();
+            using var cmd = conn.CreateCommand();
+            cmd.CommandText =
+                "create table csv_entity (id integer primary key, name text, price real, note text);" +
+                "insert into csv_entity (id, name, price, note) values (1, 'alpha', 1.5, 'plain');" +
+                "insert into csv_entity (id, name, price, note) values (2, 'a,b', 2.5, null);" +
+                "insert into csv_entity (id, name, price, note) values (3, 'he\"llo', 3.25, 'line1' || char(10) || 'line2');";
+            cmd.ExecuteNonQuery();
+        }
+
+        var ctx = new SqliteDataContext($"Data Source={path}", new DataContextBuilder());
+        ctx.EnsureConnectionOpen();
+        return (ctx, path);
+    }
+
+    private static string Text(MemoryStream stream) => Encoding.UTF8.GetString(stream.ToArray());
+
+    [Fact]
+    public void ToCsv_ShouldWriteHeaderAndRows()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var output = new MemoryStream();
+
+            var count = ctx.From<CsvEntity>().OrderBy(1).ToCsv(output);
+
+            count.Should().Be(3);
+            Text(output).Should().Be(
+                "id,name,price,note\r\n"
+                + "1,alpha,1.5,plain\r\n"
+                + "2,\"a,b\",2.5,\r\n"
+                + "3,\"he\"\"llo\",3.25,\"line1\nline2\"\r\n");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void ToCsv_WithOptions_ShouldHonorDelimiterHeaderAndNullText()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var output = new MemoryStream();
+
+            ctx.From<CsvEntity>().OrderBy(1).ToCsv(output, new CsvOptions
+            {
+                Delimiter = ';',
+                IncludeHeader = false,
+                NullText = "NULL",
+            });
+
+            Text(output).Should().Be("1;alpha;1.5;plain\r\n2;a,b;2.5;NULL\r\n3;\"he\"\"llo\";3.25;\"line1\nline2\"\r\n");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public async Task ToCsvAsync_ShouldMatchSync()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var sync = new MemoryStream();
+            ctx.From<CsvEntity>().OrderBy(1).ToCsv(sync);
+
+            using var asyncOutput = new MemoryStream();
+            var count = await ctx.From<CsvEntity>().OrderBy(1).ToCsvAsync(asyncOutput, TestContext.Current.CancellationToken);
+
+            count.Should().Be(3);
+            Text(asyncOutput).Should().Be(Text(sync));
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public async Task ToCsvAsync_WithOptions_ShouldMatchSync()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var options = new CsvOptions { QuoteAll = true, LineEnding = "\n" };
+
+            using var sync = new MemoryStream();
+            ctx.From<CsvEntity>().OrderBy(1).ToCsv(sync, options);
+
+            using var asyncOutput = new MemoryStream();
+            await ctx.From<CsvEntity>().OrderBy(1).ToCsvAsync(asyncOutput, options, TestContext.Current.CancellationToken);
+
+            Text(asyncOutput).Should().Be(Text(sync));
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void ToCsv_OnEntityBuilder_ShouldExportWholeEntity()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var output = new MemoryStream();
+
+            var count = ctx.From<CsvEntity>().OrderBy(1).ToCsv(output, new CsvOptions { IncludeHeader = false });
+
+            count.Should().Be(3);
+            Text(output).Should().StartWith("1,alpha,1.5,plain\r\n");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public async Task ToCsvAsync_OnEntityBuilder_ShouldExportWholeEntity()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var output = new MemoryStream();
+
+            var count = await ctx.From<CsvEntity>().OrderBy(1).ToCsvAsync(output, new CsvOptions { IncludeHeader = false }, TestContext.Current.CancellationToken);
+
+            count.Should().Be(3);
+            Text(output).Should().StartWith("1,alpha,1.5,plain\r\n");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void ToCsv_ProjectionOfValueType_ShouldWriteSingleColumnWithoutHeader()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var output = new MemoryStream();
+
+            ctx.From<CsvEntity>().Where(x => x.Id > SqlFunctions.Parameter<int>(0)).OrderBy(1)
+                .Select(x => x.Id)
+                .ToCsv(output, new CsvOptions { IncludeHeader = false }, 1);
+
+            Text(output).Should().Be("2\r\n3\r\n");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void ToCsv_ShouldLeaveOutputOpenByDefault()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var output = new MemoryStream();
+
+            ctx.From<CsvEntity>().OrderBy(1).ToCsv(output);
+
+            output.CanWrite.Should().BeTrue();
+            output.Position.Should().BeGreaterThan(0);
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void ToCsv_WithLeaveOpenFalse_ShouldDisposeOutput()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var output = new MemoryStream();
+
+            ctx.From<CsvEntity>().OrderBy(1).ToCsv(output, new CsvOptions { LeaveOpen = false });
+
+            var act = () => _ = output.Length;
+            act.Should().Throw<ObjectDisposedException>();
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void ToCsv_WithBomEncoding_ShouldEmitByteOrderMark()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var output = new MemoryStream();
+
+            ctx.From<CsvEntity>().OrderBy(1).ToCsv(output, new CsvOptions { Encoding = Encoding.UTF8 });
+
+            output.ToArray()[..3].Should().Equal(0xEF, 0xBB, 0xBF);
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void ToCsv_OnTemporaryTableSource_ShouldThrowNotSupported()
+    {
+        using var ctx = SqliteTestContext.Create();
+        using var output = new MemoryStream();
+
+        var source = ctx.From<ISimpleEntity>().Select(x => new { x.Id }).AsTempTable();
+
+        var act = () => ctx.From(source).Select(t => new { Id = t.GetInt32("id") }).ToCsv(output);
+
+        act.Should().Throw<NotSupportedException>();
+    }
+
+    [Fact]
+    public void ToCsv_ShouldBeRepeatable_AndNotBreakBufferedTerminals()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var command = ctx.From<CsvEntity>().OrderBy(1).Select(x => new { x.Id, x.Name });
+
+            // A buffered terminal first: the plan cache then holds a mapped plan for this shape, and the
+            // CSV export must not pick it up (it prepares with storeInCache: false + suppressMapper).
+            command.ToList().Should().HaveCount(3);
+
+            using (var first = new MemoryStream())
+            {
+                command.ToCsv(first, new CsvOptions { IncludeHeader = false });
+                Text(first).Should().StartWith("1,alpha\r\n");
+            }
+
+            using (var second = new MemoryStream())
+            {
+                command.ToCsv(second, new CsvOptions { IncludeHeader = false });
+                Text(second).Should().StartWith("1,alpha\r\n");
+            }
+
+            command.ToList().Should().HaveCount(3);
+            command.ToList()[0].Should().Be(new { Id = 1, Name = "alpha" });
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
+}
