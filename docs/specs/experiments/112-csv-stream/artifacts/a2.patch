+using System.Data;
+using System.Data.Common;
+using System.Globalization;
+using System.Text;
+using FluentAssertions;
+using NextORM.Core;
+
+namespace NextORM.Core.Tests;
+
+/// <summary>
+/// Exercises the internal <see cref="CsvWriter"/> directly over a <see cref="DataTableReader"/>: the
+/// RFC 4180 quoting, the typed formatting (invariant culture), the <c>NULL</c> handling and the
+/// configurable options, without a database. The provider round trip is covered by the SQLite and the
+/// shared integration suites.
+/// </summary>
+public class CsvWriterTests
+{
+    private static string Write(DbDataReader reader, CsvOptions? options = null)
+    {
+        var builder = new StringBuilder();
+        using var text = new StringWriter(builder);
+        new CsvWriter(text, options ?? CsvOptions.Default).Write(reader, CancellationToken.None);
+        return builder.ToString();
+    }
+
+    private static DataTable Table()
+    {
+        var table = new DataTable();
+        table.Columns.Add("id", typeof(int));
+        table.Columns.Add("name", typeof(string));
+        return table;
+    }
+
+    [Fact]
+    public void Write_ShouldEmitHeaderAndRows()
+    {
+        var table = Table();
+        table.Rows.Add(1, "alpha");
+        table.Rows.Add(2, "beta");
+
+        Write(table.CreateDataReader()).Should().Be("id,name\r\n1,alpha\r\n2,beta\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldReturnDataRowCount()
+    {
+        var table = Table();
+        table.Rows.Add(1, "alpha");
+        table.Rows.Add(2, "beta");
+
+        var builder = new StringBuilder();
+        using var text = new StringWriter(builder);
+
+        new CsvWriter(text, CsvOptions.Default).Write(table.CreateDataReader(), CancellationToken.None).Should().Be(2);
+    }
+
+    [Fact]
+    public void Write_ShouldQuoteDelimiterQuoteAndLineBreaks()
+    {
+        var table = Table();
+        table.Rows.Add(1, "a,b");
+        table.Rows.Add(2, "he\"llo");
+        table.Rows.Add(3, "line1\r\nline2");
+
+        Write(table.CreateDataReader()).Should().Be("id,name\r\n1,\"a,b\"\r\n2,\"he\"\"llo\"\r\n3,\"line1\r\nline2\"\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldWriteNullText()
+    {
+        var table = Table();
+        table.Rows.Add(1, DBNull.Value);
+
+        Write(table.CreateDataReader()).Should().Be("id,name\r\n1,\r\n");
+        Write(table.CreateDataReader(), new CsvOptions { NullText = "NULL" }).Should().Be("id,name\r\n1,NULL\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldEscapeNullTextWhenItContainsSpecialCharacters()
+    {
+        var table = Table();
+        table.Rows.Add(1, DBNull.Value);
+
+        Write(table.CreateDataReader(), new CsvOptions { NullText = "a,b" }).Should().Be("id,name\r\n1,\"a,b\"\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldQuoteEveryFieldWhenQuoteAll()
+    {
+        var table = Table();
+        table.Rows.Add(1, "alpha");
+
+        Write(table.CreateDataReader(), new CsvOptions { QuoteAll = true }).Should().Be("\"id\",\"name\"\r\n\"1\",\"alpha\"\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldOmitHeaderWhenDisabled()
+    {
+        var table = Table();
+        table.Rows.Add(1, "alpha");
+
+        Write(table.CreateDataReader(), new CsvOptions { IncludeHeader = false }).Should().Be("1,alpha\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldHonorCustomDelimiterAndLineEnding()
+    {
+        var table = Table();
+        table.Rows.Add(1, "alpha");
+
+        Write(table.CreateDataReader(), new CsvOptions { Delimiter = ';', LineEnding = "\n" }).Should().Be("id;name\n1;alpha\n");
+    }
+
+    [Fact]
+    public void Write_ShouldBase64EncodeBinaryColumns()
+    {
+        var table = new DataTable();
+        table.Columns.Add("data", typeof(byte[]));
+        table.Rows.Add(new byte[] { 1, 2, 3, 4 });
+
+        Write(table.CreateDataReader()).Should().Be("data\r\nAQIDBA==\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldFormatValuesWithInvariantCulture()
+    {
+        var previous = CultureInfo.CurrentCulture;
+        CultureInfo.CurrentCulture = new CultureInfo("de-DE");
+        try
+        {
+            var table = new DataTable();
+            table.Columns.Add("d", typeof(decimal));
+            table.Columns.Add("f", typeof(double));
+            table.Columns.Add("date", typeof(DateTime));
+            table.Rows.Add(1.5m, 2.25d, new DateTime(2023, 1, 2, 3, 4, 5, DateTimeKind.Utc));
+
+            Write(table.CreateDataReader()).Should().Be("d,f,date\r\n1.5,2.25,2023-01-02T03:04:05.0000000\r\n");
+        }
+        finally
+        {
+            CultureInfo.CurrentCulture = previous;
+        }
+    }
+
+    [Fact]
+    public void Write_ShouldFormatBooleanAsLowerCase()
+    {
+        var table = new DataTable();
+        table.Columns.Add("flag", typeof(bool));
+        table.Rows.Add(true);
+        table.Rows.Add(false);
+
+        Write(table.CreateDataReader()).Should().Be("flag\r\ntrue\r\nfalse\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldFormatGuidWithDefaultFormat()
+    {
+        var table = new DataTable();
+        table.Columns.Add("id", typeof(Guid));
+        table.Rows.Add(new Guid("00000000-0000-0000-0000-0000000000ab"));
+
+        Write(table.CreateDataReader()).Should().Be("id\r\n00000000-0000-0000-0000-0000000000ab\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldFormatTypesWithoutDedicatedReaderGetters()
+    {
+        var table = new DataTable();
+        table.Columns.Add("sb", typeof(sbyte));
+        table.Columns.Add("us", typeof(ushort));
+        table.Columns.Add("ui", typeof(uint));
+        table.Columns.Add("ul", typeof(ulong));
+        table.Columns.Add("f", typeof(float));
+        table.Columns.Add("c", typeof(char));
+        table.Columns.Add("ts", typeof(TimeSpan));
+        table.Rows.Add((sbyte)-5, (ushort)7, 8u, 9ul, 1.25f, 'x', new TimeSpan(1, 2, 3));
+
+        Write(table.CreateDataReader()).Should().Be("sb,us,ui,ul,f,c,ts\r\n-5,7,8,9,1.25,x,01:02:03\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldFormatRemainingNumericAndTemporalBranches()
+    {
+        var table = new DataTable();
+        table.Columns.Add("b", typeof(byte));
+        table.Columns.Add("s", typeof(short));
+        table.Columns.Add("l", typeof(long));
+        table.Columns.Add("dto", typeof(DateTimeOffset));
+        table.Rows.Add((byte)3, (short)-4, 5L, new DateTimeOffset(2023, 1, 2, 3, 4, 5, TimeSpan.Zero));
+
+        Write(table.CreateDataReader()).Should().Be("b,s,l,dto\r\n3,-4,5,2023-01-02T03:04:05.0000000+00:00\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldFallBackToGetValueForUnknownColumnTypes()
+    {
+        var table = new DataTable();
+        table.Columns.Add("value", typeof(object));
+        table.Rows.Add(new object());
+        table.Rows.Add(42);
+
+        Write(table.CreateDataReader()).Should().Be("value\r\nSystem.Object\r\n42\r\n");
+    }
+
+    [Fact]
+    public void Write_ShouldEmitOnlyHeaderForEmptyResult()
+    {
+        Write(Table().CreateDataReader()).Should().Be("id,name\r\n");
+    }
+
+    [Fact]
+    public async Task WriteAsync_ShouldMatchSync()
+    {
+        var table = Table();
+        table.Rows.Add(1, "a,b");
+        table.Rows.Add(2, "line1\r\nline2");
+
+        var expected = Write(table.CreateDataReader());
+
+        var builder = new StringBuilder();
+        await using (var text = new StringWriter(builder))
+        {
+            var count = await new CsvWriter(text, CsvOptions.Default).WriteAsync(table.CreateDataReader(), TestContext.Current.CancellationToken);
+            count.Should().Be(2);
+        }
+
+        builder.ToString().Should().Be(expected);
+    }
+
+    [Theory]
+    [InlineData('"')]
+    [InlineData('\r')]
+    [InlineData('\n')]
+    public void Constructor_ShouldRejectDelimiterThatCollidesWithQuotingOrLineBreaks(char delimiter)
+    {
+        var act = () => new CsvWriter(new StringWriter(), new CsvOptions { Delimiter = delimiter });
+
+        act.Should().Throw<ArgumentException>();
+    }
+
+    [Fact]
+    public void Constructor_ShouldRejectEmptyLineEnding()
+    {
+        var act = () => new CsvWriter(new StringWriter(), new CsvOptions { LineEnding = "" });
+
+        act.Should().Throw<ArgumentException>();
+    }
+
+    [Fact]
+    public void ToCsv_OnInMemoryProvider_ShouldThrowNotSupported()
+    {
+        using var context = new InMemoryDataContext();
+        using var output = new MemoryStream();
+
+        var act = () => context.From<SimpleEntity>().Select(x => x.Id).ToCsv(output);
+
+        act.Should().Throw<NotSupportedException>();
+    }
+
+    [Fact]
+    public async Task ToCsvAsync_OnInMemoryProvider_ShouldThrowNotSupported()
+    {
+        using var context = new InMemoryDataContext();
+        using var output = new MemoryStream();
+
+        var act = () => context.From<SimpleEntity>().Select(x => x.Id).ToCsvAsync(output);
+
+        await act.Should().ThrowAsync<NotSupportedException>();
+    }
+}
