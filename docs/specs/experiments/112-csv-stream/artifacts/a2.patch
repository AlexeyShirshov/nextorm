+++ b/src/nextorm.core/Query/CsvOptions.cs
@@ -0,0 +1,49 @@
+using System.Text;
+
+namespace NextORM.Core;
+
+/// <summary>
+/// Formatting options for the CSV export terminals (<c>ToCsv</c>/<c>ToCsvAsync</c>). All properties are
+/// optional; <see cref="Default"/> carries the standard RFC 4180 shape (comma delimiter, CRLF line
+/// ending, quoted only when needed, UTF-8 without BOM, the caller's stream left open).
+/// </summary>
+public sealed class CsvOptions
+{
+    /// <summary>The shared default options instance.</summary>
+    public static CsvOptions Default { get; } = new();
+
+    /// <summary>The field separator. Defaults to <c>,</c> (comma).</summary>
+    public char Delimiter { get; init; } = ',';
+
+    /// <summary>Whether the column names are written as the first row. Defaults to <see langword="true"/>.</summary>
+    public bool IncludeHeader { get; init; } = true;
+
+    /// <summary>
+    /// The text written for a SQL <c>NULL</c> value. Defaults to the empty string. The text is escaped
+    /// like any other field when it contains the delimiter, a quote or a line break.
+    /// </summary>
+    public string NullText { get; init; } = "";
+
+    /// <summary>
+    /// Whether every field is wrapped in quotes even when it does not need them. Defaults to
+    /// <see langword="false"/> (RFC 4180 minimum quoting).
+    /// </summary>
+    public bool QuoteAll { get; init; } = false;
+
+    /// <summary>The line terminator written after every record. Defaults to <c>\r\n</c> (RFC 4180).</summary>
+    public string LineEnding { get; init; } = "\r\n";
+
+    /// <summary>
+    /// The character encoding of the output. Defaults to UTF-8 without a byte-order mark. The encoding
+    /// is only read when the terminal creates its own writer; a caller that already opened a
+    /// <see cref="System.IO.StreamWriter"/> controls the encoding itself.
+    /// </summary>
+    public Encoding Encoding { get; init; } = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false);
+
+    /// <summary>
+    /// Whether the output stream is left open after the export. Defaults to <see langword="true"/>, so
+    /// a caller that owns the stream keeps ownership; set it to <see langword="false"/> to have the
+    /// terminal dispose (and flush) the stream.
+    /// </summary>
+    public bool LeaveOpen { get; init; } = true;
+}
