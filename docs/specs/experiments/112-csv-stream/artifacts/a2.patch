+namespace NextORM.Core;
+
+/// <summary>
+/// Terminal operators that stream a query's result to a CSV stream without materialising it: the
+/// <c>ToCsv</c>/<c>ToCsvAsync</c> methods write the projection of a <see cref="QueryCommand{TResult}"/>
+/// (or the whole entity of an <see cref="EntityBuilder{TEntity}"/>) directly from the provider reader,
+/// column by column, through the reader's typed getters. No row object is created, and no value is
+/// boxed for the field types the provider exposes through a typed accessor (a provider-specific field
+/// type without a dedicated getter is read through <c>GetFieldValue&lt;T&gt;</c> or, failing that,
+/// <c>GetValue</c>). See the guide page "Exporting a query to CSV".
+/// </summary>
+public static class QueryCommandCsvExtensions
+{
+    private const int DefaultBufferSize = 4096;
+
+    /// <summary>Writes the query result as CSV to <paramref name="output"/> using the default options.</summary>
+    /// <typeparam name="TResult">The projected result type; it is not materialised on this path.</typeparam>
+    /// <param name="command">The command whose projection is exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>The number of data rows written (the header is not counted).</returns>
+    public static int ToCsv<TResult>(this QueryCommand<TResult> command, Stream output, params ReadOnlySpan<object?> parameters)
+        => ToCsvCore(command, output, CsvOptions.Default, parameters);
+
+    /// <summary>Writes the query result as CSV to <paramref name="output"/> using the supplied options.</summary>
+    /// <typeparam name="TResult">The projected result type; it is not materialised on this path.</typeparam>
+    /// <param name="command">The command whose projection is exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="options">The CSV formatting options.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>The number of data rows written (the header is not counted).</returns>
+    public static int ToCsv<TResult>(this QueryCommand<TResult> command, Stream output, CsvOptions options, params ReadOnlySpan<object?> parameters)
+        => ToCsvCore(command, output, options, parameters);
+
+    /// <summary>Asynchronously writes the query result as CSV to <paramref name="output"/> using the default options.</summary>
+    /// <typeparam name="TResult">The projected result type; it is not materialised on this path.</typeparam>
+    /// <param name="command">The command whose projection is exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of data rows written (the header is not counted).</returns>
+    public static Task<int> ToCsvAsync<TResult>(this QueryCommand<TResult> command, Stream output, params object?[] parameters)
+        => ToCsvCoreAsync(command, output, CsvOptions.Default, (object[]?)parameters, CancellationToken.None);
+
+    /// <summary>Asynchronously writes the query result as CSV to <paramref name="output"/> using the default options.</summary>
+    /// <typeparam name="TResult">The projected result type; it is not materialised on this path.</typeparam>
+    /// <param name="command">The command whose projection is exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="cancellationToken">Cancels awaiting the provider reader and the output writer.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of data rows written (the header is not counted).</returns>
+    public static Task<int> ToCsvAsync<TResult>(this QueryCommand<TResult> command, Stream output, CancellationToken cancellationToken, params object?[] parameters)
+        => ToCsvCoreAsync(command, output, CsvOptions.Default, (object[]?)parameters, cancellationToken);
+
+    /// <summary>Asynchronously writes the query result as CSV to <paramref name="output"/> using the supplied options.</summary>
+    /// <typeparam name="TResult">The projected result type; it is not materialised on this path.</typeparam>
+    /// <param name="command">The command whose projection is exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="options">The CSV formatting options.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of data rows written (the header is not counted).</returns>
+    public static Task<int> ToCsvAsync<TResult>(this QueryCommand<TResult> command, Stream output, CsvOptions options, params object?[] parameters)
+        => ToCsvCoreAsync(command, output, options, (object[]?)parameters, CancellationToken.None);
+
+    /// <summary>Asynchronously writes the query result as CSV to <paramref name="output"/> using the supplied options.</summary>
+    /// <typeparam name="TResult">The projected result type; it is not materialised on this path.</typeparam>
+    /// <param name="command">The command whose projection is exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="options">The CSV formatting options.</param>
+    /// <param name="cancellationToken">Cancels awaiting the provider reader and the output writer.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of data rows written (the header is not counted).</returns>
+    public static Task<int> ToCsvAsync<TResult>(this QueryCommand<TResult> command, Stream output, CsvOptions options, CancellationToken cancellationToken, params object?[] parameters)
+        => ToCsvCoreAsync(command, output, options, (object[]?)parameters, cancellationToken);
+
+    /// <summary>Writes the whole entity result of the builder as CSV to <paramref name="output"/> using the default options.</summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="builder">The entity builder whose projected rows are exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>The number of data rows written (the header is not counted).</returns>
+    public static int ToCsv<TEntity>(this EntityBuilder<TEntity> builder, Stream output, params ReadOnlySpan<object?> parameters)
+        => ToCsvCore(RequireBuilder(builder).ToCommand(), output, CsvOptions.Default, parameters);
+
+    /// <summary>Writes the whole entity result of the builder as CSV to <paramref name="output"/> using the supplied options.</summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="builder">The entity builder whose projected rows are exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="options">The CSV formatting options.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>The number of data rows written (the header is not counted).</returns>
+    public static int ToCsv<TEntity>(this EntityBuilder<TEntity> builder, Stream output, CsvOptions options, params ReadOnlySpan<object?> parameters)
+        => ToCsvCore(RequireBuilder(builder).ToCommand(), output, options, parameters);
+
+    /// <summary>Asynchronously writes the whole entity result of the builder as CSV to <paramref name="output"/> using the default options.</summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="builder">The entity builder whose projected rows are exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of data rows written (the header is not counted).</returns>
+    public static Task<int> ToCsvAsync<TEntity>(this EntityBuilder<TEntity> builder, Stream output, params object?[] parameters)
+        => ToCsvCoreAsync(RequireBuilder(builder).ToCommand(), output, CsvOptions.Default, (object[]?)parameters, CancellationToken.None);
+
+    /// <summary>Asynchronously writes the whole entity result of the builder as CSV to <paramref name="output"/> using the default options.</summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="builder">The entity builder whose projected rows are exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="cancellationToken">Cancels awaiting the provider reader and the output writer.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of data rows written (the header is not counted).</returns>
+    public static Task<int> ToCsvAsync<TEntity>(this EntityBuilder<TEntity> builder, Stream output, CancellationToken cancellationToken, params object?[] parameters)
+        => ToCsvCoreAsync(RequireBuilder(builder).ToCommand(), output, CsvOptions.Default, (object[]?)parameters, cancellationToken);
+
+    /// <summary>Asynchronously writes the whole entity result of the builder as CSV to <paramref name="output"/> using the supplied options.</summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="builder">The entity builder whose projected rows are exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="options">The CSV formatting options.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of data rows written (the header is not counted).</returns>
+    public static Task<int> ToCsvAsync<TEntity>(this EntityBuilder<TEntity> builder, Stream output, CsvOptions options, params object?[] parameters)
+        => ToCsvCoreAsync(RequireBuilder(builder).ToCommand(), output, options, (object[]?)parameters, CancellationToken.None);
+
+    /// <summary>Asynchronously writes the whole entity result of the builder as CSV to <paramref name="output"/> using the supplied options.</summary>
+    /// <typeparam name="TEntity">The entity type.</typeparam>
+    /// <param name="builder">The entity builder whose projected rows are exported.</param>
+    /// <param name="output">The stream that receives the CSV text; it is left open unless <see cref="CsvOptions.LeaveOpen"/> is <see langword="false"/>.</param>
+    /// <param name="options">The CSV formatting options.</param>
+    /// <param name="cancellationToken">Cancels awaiting the provider reader and the output writer.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of data rows written (the header is not counted).</returns>
+    public static Task<int> ToCsvAsync<TEntity>(this EntityBuilder<TEntity> builder, Stream output, CsvOptions options, CancellationToken cancellationToken, params object?[] parameters)
+        => ToCsvCoreAsync(RequireBuilder(builder).ToCommand(), output, options, (object[]?)parameters, cancellationToken);
+
+    private static EntityBuilder<TEntity> RequireBuilder<TEntity>(EntityBuilder<TEntity> builder)
+        => builder ?? throw new ArgumentNullException(nameof(builder));
+
+    private static int ToCsvCore<TResult>(QueryCommand<TResult> command, Stream output, CsvOptions options, ReadOnlySpan<object?> parameters)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+        ArgumentNullException.ThrowIfNull(output);
+        ArgumentNullException.ThrowIfNull(options);
+        ArgumentNullException.ThrowIfNull(options.Encoding);
+
+        var context = RequireRelationalContext(command);
+        var owner = context.OpenCsvReader(command, parameters, CancellationToken.None);
+        try
+        {
+            using var writer = new StreamWriter(output, options.Encoding, DefaultBufferSize, options.LeaveOpen);
+            var count = new CsvWriter(writer, options).Write(owner.Reader, CancellationToken.None);
+            writer.Flush();
+            return count;
+        }
+        finally
+        {
+            owner.Dispose();
+        }
+    }
+
+    private static async Task<int> ToCsvCoreAsync<TResult>(QueryCommand<TResult> command, Stream output, CsvOptions options, object[]? parameters, CancellationToken cancellationToken)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+        ArgumentNullException.ThrowIfNull(output);
+        ArgumentNullException.ThrowIfNull(options);
+        ArgumentNullException.ThrowIfNull(options.Encoding);
+
+        var context = RequireRelationalContext(command);
+        var owner = await context.OpenCsvReaderAsync(command, parameters, cancellationToken).ConfigureAwait(false);
+        try
+        {
+            var writer = new StreamWriter(output, options.Encoding, DefaultBufferSize, options.LeaveOpen);
+            try
+            {
+                var count = await new CsvWriter(writer, options).WriteAsync(owner.Reader, cancellationToken).ConfigureAwait(false);
+                await writer.FlushAsync(cancellationToken).ConfigureAwait(false);
+                return count;
+            }
+            finally
+            {
+                await writer.DisposeAsync().ConfigureAwait(false);
+            }
+        }
+        finally
+        {
+            await owner.DisposeAsync().ConfigureAwait(false);
+        }
+    }
+
+    private static DataContext RequireRelationalContext(QueryCommand command)
+    {
+        QueryCommandExtensions.ThrowIfDisposed(command.DataContext);
+
+        return command.DataContext as DataContext
+            ?? throw new NotSupportedException(
+                "CSV export requires a database provider with a DbDataReader; the in-memory provider does not support ToCsv/ToCsvAsync.");
+    }
+}
