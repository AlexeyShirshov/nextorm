new file mode 100644
index 0000000..effa6d9
--- /dev/null
+++ b/src/nextorm.core/Query/CsvWriter.cs
@@ -0,0 +1,309 @@
+using System.Buffers;
+using System.Data.Common;
+using System.Globalization;
+
+namespace NextORM.Core;
+
+/// <summary>
+/// Writes the rows of a <see cref="DbDataReader"/> to a <see cref="TextWriter"/> as RFC 4180 CSV. The
+/// projection is read column by column through the reader's typed getters, so no row object is created
+/// and no value is boxed for the field types the provider exposes through a typed accessor; a column
+/// whose provider field type has no dedicated getter is read through <see cref="DbDataReader.GetFieldValue{T}"/>
+/// (which the provider may or may not specialise) or, failing that, <see cref="DbDataReader.GetValue(int)"/>.
+/// Each field is formatted into a stack buffer and written as a span, so no intermediate string is
+/// allocated per cell.
+/// </summary>
+internal sealed class CsvWriter
+{
+    private enum FieldKind : byte
+    {
+        String,
+        Boolean,
+        Byte,
+        SByte,
+        Int16,
+        UInt16,
+        Int32,
+        UInt32,
+        Int64,
+        UInt64,
+        Single,
+        Double,
+        Decimal,
+        Guid,
+        DateTime,
+        DateTimeOffset,
+        TimeSpan,
+        Char,
+        Bytes,
+        Other,
+    }
+
+    private readonly TextWriter _writer;
+    private readonly char _delimiter;
+    private readonly char _quote = '"';
+    private readonly string _nullText;
+    private readonly bool _includeHeader;
+    private readonly bool _quoteAll;
+    private readonly string _lineEnding;
+    private readonly SearchValues<char> _quoteTriggers;
+
+    internal CsvWriter(TextWriter writer, CsvOptions options)
+    {
+        _writer = writer;
+        _delimiter = options.Delimiter;
+        _nullText = options.NullText ?? "";
+        _includeHeader = options.IncludeHeader;
+        _quoteAll = options.QuoteAll;
+        _lineEnding = options.LineEnding;
+
+        if (_delimiter == _quote || _delimiter == '\r' || _delimiter == '\n')
+            throw new ArgumentException("The CSV delimiter cannot be a quote or a line-break character.", nameof(options));
+
+        if (string.IsNullOrEmpty(_lineEnding))
+            throw new ArgumentException("The CSV line ending cannot be null or empty.", nameof(options));
+
+        _quoteTriggers = SearchValues.Create(stackalloc char[] { _delimiter, _quote, '\r', '\n' });
+    }
+
+    /// <summary>Writes the header (when enabled) and every row, returning the number of data rows.</summary>
+    /// <param name="reader">The open, positioned-before-the-first-row reader.</param>
+    /// <param name="cancellationToken">Checked before each row.</param>
+    /// <returns>The number of data rows written (the header is not counted).</returns>
+    internal int Write(DbDataReader reader, CancellationToken cancellationToken)
+    {
+        var kinds = Classify(reader);
+
+        if (_includeHeader)
+            WriteHeader(reader);
+
+        var rows = 0;
+        while (reader.Read())
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            WriteRow(reader, kinds);
+            rows++;
+        }
+
+        return rows;
+    }
+
+    /// <summary>Asynchronous counterpart of <see cref="Write"/>.</summary>
+    /// <param name="reader">The open, positioned-before-the-first-row reader.</param>
+    /// <param name="cancellationToken">Cancels awaiting the next row.</param>
+    /// <returns>A task producing the number of data rows written.</returns>
+    /// <remarks>
+    /// The asynchronous part is awaiting the provider reader; each formatted row is handed to the
+    /// (buffered) <see cref="TextWriter"/> synchronously, so a row never allocates an async state
+    /// machine per field.
+    /// </remarks>
+    internal async Task<int> WriteAsync(DbDataReader reader, CancellationToken cancellationToken)
+    {
+        var kinds = Classify(reader);
+
+        if (_includeHeader)
+            WriteHeader(reader);
+
+        var rows = 0;
+        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            WriteRow(reader, kinds);
+            rows++;
+        }
+
+        return rows;
+    }
+
+    private static FieldKind[] Classify(DbDataReader reader)
+    {
+        var count = reader.FieldCount;
+        var kinds = new FieldKind[count];
+        for (var i = 0; i < count; i++)
+            kinds[i] = Classify(reader.GetFieldType(i));
+        return kinds;
+    }
+
+    private static FieldKind Classify(Type type)
+    {
+        if (type == typeof(string)) return FieldKind.String;
+        if (type == typeof(bool)) return FieldKind.Boolean;
+        if (type == typeof(byte)) return FieldKind.Byte;
+        if (type == typeof(sbyte)) return FieldKind.SByte;
+        if (type == typeof(short)) return FieldKind.Int16;
+        if (type == typeof(ushort)) return FieldKind.UInt16;
+        if (type == typeof(int)) return FieldKind.Int32;
+        if (type == typeof(uint)) return FieldKind.UInt32;
+        if (type == typeof(long)) return FieldKind.Int64;
+        if (type == typeof(ulong)) return FieldKind.UInt64;
+        if (type == typeof(float)) return FieldKind.Single;
+        if (type == typeof(double)) return FieldKind.Double;
+        if (type == typeof(decimal)) return FieldKind.Decimal;
+        if (type == typeof(Guid)) return FieldKind.Guid;
+        if (type == typeof(DateTime)) return FieldKind.DateTime;
+        if (type == typeof(DateTimeOffset)) return FieldKind.DateTimeOffset;
+        if (type == typeof(TimeSpan)) return FieldKind.TimeSpan;
+        if (type == typeof(char)) return FieldKind.Char;
+        if (type == typeof(byte[])) return FieldKind.Bytes;
+        return FieldKind.Other;
+    }
+
+    private void WriteHeader(DbDataReader reader)
+    {
+        var count = reader.FieldCount;
+        for (var i = 0; i < count; i++)
+        {
+            if (i > 0) _writer.Write(_delimiter);
+            WriteText(reader.GetName(i));
+        }
+
+        _writer.Write(_lineEnding);
+    }
+
+    private void WriteRow(DbDataReader reader, FieldKind[] kinds)
+    {
+        for (var i = 0; i < kinds.Length; i++)
+        {
+            if (i > 0) _writer.Write(_delimiter);
+            WriteField(reader, i, kinds[i]);
+        }
+
+        _writer.Write(_lineEnding);
+    }
+
+    private void WriteField(DbDataReader reader, int ordinal, FieldKind kind)
+    {
+        if (reader.IsDBNull(ordinal))
+        {
+            WriteText(_nullText);
+            return;
+        }
+
+        switch (kind)
+        {
+            case FieldKind.String:
+                WriteText(reader.GetString(ordinal));
+                break;
+            case FieldKind.Boolean:
+                WriteText(reader.GetBoolean(ordinal) ? "true" : "false");
+                break;
+            case FieldKind.Byte:
+                WriteFormatted(reader.GetByte(ordinal));
+                break;
+            case FieldKind.SByte:
+                WriteFormatted(reader.GetFieldValue<sbyte>(ordinal));
+                break;
+            case FieldKind.Int16:
+                WriteFormatted(reader.GetInt16(ordinal));
+                break;
+            case FieldKind.UInt16:
+                WriteFormatted(reader.GetFieldValue<ushort>(ordinal));
+                break;
+            case FieldKind.Int32:
+                WriteFormatted(reader.GetInt32(ordinal));
+                break;
+            case FieldKind.UInt32:
+                WriteFormatted(reader.GetFieldValue<uint>(ordinal));
+                break;
+            case FieldKind.Int64:
+                WriteFormatted(reader.GetInt64(ordinal));
+                break;
+            case FieldKind.UInt64:
+                WriteFormatted(reader.GetFieldValue<ulong>(ordinal));
+                break;
+            case FieldKind.Single:
+                WriteFormatted(reader.GetFloat(ordinal));
+                break;
+            case FieldKind.Double:
+                WriteFormatted(reader.GetDouble(ordinal));
+                break;
+            case FieldKind.Decimal:
+                WriteFormatted(reader.GetDecimal(ordinal));
+                break;
+            case FieldKind.Guid:
+                WriteFormatted(reader.GetGuid(ordinal));
+                break;
+            case FieldKind.DateTime:
+                WriteFormatted(reader.GetDateTime(ordinal), "O");
+                break;
+            case FieldKind.DateTimeOffset:
+                WriteFormatted(reader.GetFieldValue<DateTimeOffset>(ordinal), "O");
+                break;
+            case FieldKind.TimeSpan:
+                WriteFormatted(reader.GetFieldValue<TimeSpan>(ordinal), "c");
+                break;
+            case FieldKind.Char:
+                WriteChar(reader.GetChar(ordinal));
+                break;
+            case FieldKind.Bytes:
+                WriteText(Convert.ToBase64String(reader.GetFieldValue<byte[]>(ordinal)));
+                break;
+            default:
+                WriteFieldValue(reader.GetValue(ordinal));
+                break;
+        }
+    }
+
+    /// <summary>
+    /// Formats a value into a stack buffer and writes it through <see cref="WriteText(ReadOnlySpan{char})"/>,
+    /// so a numeric/temporal field does not allocate an intermediate <see cref="string"/> per cell.
+    /// </summary>
+    private void WriteFormatted<T>(T value, ReadOnlySpan<char> format = default)
+        where T : ISpanFormattable
+    {
+        Span<char> buffer = stackalloc char[64];
+        if (value.TryFormat(buffer, out var written, format, CultureInfo.InvariantCulture))
+            WriteText(buffer[..written]);
+        else
+            WriteText(value.ToString(format.IsEmpty ? null : format.ToString(), CultureInfo.InvariantCulture));
+    }
+
+    private void WriteChar(char value)
+    {
+        Span<char> buffer = stackalloc char[1];
+        buffer[0] = value;
+        WriteText(buffer);
+    }
+
+    private void WriteFieldValue(object? value)
+    {
+        if (value is null or DBNull)
+        {
+            WriteText(_nullText);
+            return;
+        }
+
+        var text = value is IFormattable formattable
+            ? formattable.ToString(null, CultureInfo.InvariantCulture)
+            : value.ToString();
+
+        WriteText(text ?? _nullText);
+    }
+
+    private void WriteText(string value) => WriteText(value.AsSpan());
+
+    private void WriteText(ReadOnlySpan<char> value)
+    {
+        if (!_quoteAll && value.IndexOfAny(_quoteTriggers) < 0)
+        {
+            _writer.Write(value);
+            return;
+        }
+
+        _writer.Write(_quote);
+        var start = 0;
+        for (var i = 0; i < value.Length; i++)
+        {
+            if (value[i] != _quote)
+                continue;
+
+            _writer.Write(value[start..i]);
+            _writer.Write(_quote);
+            _writer.Write(_quote);
+            start = i + 1;
+        }
+
+        _writer.Write(value[start..]);
+        _writer.Write(_quote);
+    }
+}
