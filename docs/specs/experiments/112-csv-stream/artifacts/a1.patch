+using System.Text;
+using FluentAssertions;
+using Microsoft.Data.Sqlite;
+using NextORM.Core;
+
+namespace NextORM.Sqlite.Tests;
+
+/// <summary>
+/// End-to-end coverage for the CSV streaming terminals against a real SQLite database. The terminals
+/// read the provider reader directly, so no row object is materialised and the query result reaches the
+/// destination as a plain CSV document.
+/// </summary>
+public class CsvTerminalTests
+{
+    [SqlTable("csv_orders")]
+    private sealed class CsvOrder
+    {
+        public int Id { get; set; }
+        public string? Name { get; set; }
+        public double Amount { get; set; }
+    }
+
+    private sealed class CountingRow
+    {
+        public static int Assignments;
+
+        private int _id;
+
+        public int Id
+        {
+            get => _id;
+            set
+            {
+                _id = value;
+                Assignments++;
+            }
+        }
+
+        public string? Name { get; set; }
+    }
+
+    private static (IDataContext Ctx, string Path) CreateDb()
+    {
+        var path = Path.Combine(Path.GetTempPath(), $"nextorm-csv-{Guid.NewGuid():N}.db");
+        using (var connection = new SqliteConnection($"Data Source={path}"))
+        {
+            connection.Open();
+            using var command = connection.CreateCommand();
+            command.CommandText =
+                "create table csv_orders (id integer, name text, amount real);" +
+                "insert into csv_orders (id, name, amount) values (1, 'alpha,inc', 10.5);" +
+                "insert into csv_orders (id, name, amount) values (2, 'quoted \"x\"', 2);" +
+                "insert into csv_orders (id, name, amount) values (3, null, null);";
+            command.ExecuteNonQuery();
+        }
+
+        return (new SqliteDataContext($"Data Source={path}", new DataContextBuilder()), path);
+    }
+
+    [Fact]
+    public void ToCsv_Projection_ShouldStreamTypedRows()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var command = ctx.From<CsvOrder>().OrderBy(x => x.Id).Select(x => new { x.Id, x.Name, x.Amount });
+            using var stream = new MemoryStream();
+
+            var rows = command.ToCsv(stream);
+
+            rows.Should().Be(3);
+            Read(stream).Should().Be(
+                "id,name,amount\n" +
+                "1,\"alpha,inc\",10.5\n" +
+                "2,\"quoted \"\"x\"\"\",2\n" +
+                "3,,\n");
+        }
+        finally { ctx.Dispose(); File.Delete(path); }
+    }
+
+    [Fact]
+    public async Task ToCsvAsync_Projection_ShouldStreamTypedRows()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var command = ctx.From<CsvOrder>().OrderBy(x => x.Id).Select(x => new { x.Id, x.Name, x.Amount });
+            using var stream = new MemoryStream();
+
+            var rows = await command.ToCsvAsync(stream, cancellationToken: TestContext.Current.CancellationToken);
+
+            rows.Should().Be(3);
+            Read(stream).Should().Be(
+                "id,name,amount\n" +
+                "1,\"alpha,inc\",10.5\n" +
+                "2,\"quoted \"\"x\"\"\",2\n" +
+                "3,,\n");
+        }
+        finally { ctx.Dispose(); File.Delete(path); }
+    }
+
+    [Fact]
+    public void ToCsv_EntityBuilder_ShouldStreamEntityColumns()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            using var stream = new MemoryStream();
+
+            var rows = ctx.From<CsvOrder>().OrderBy(x => x.Id).ToCsv(stream);
+
+            rows.Should().Be(3);
+            var csv = Read(stream);
+            csv.Should().StartWith("id,name,amount\n");
+            csv.Should().Contain("1,\"alpha,inc\",10.5\n");
+            csv.Should().Contain("3,,\n");
+        }
+        finally { ctx.Dispose(); File.Delete(path); }
+    }
+
+    [Fact]
+    public void ToCsv_TextWriter_ShouldWriteToCallerWriter()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var destination = new StringWriter();
+            var command = ctx.From<CsvOrder>().Where(x => x.Id == 1).Select(x => new { x.Id, x.Name });
+
+            var rows = command.ToCsv(destination, new CsvOptions { Delimiter = ";" });
+
+            rows.Should().Be(1);
+            destination.ToString().Should().Be("id;name\n1;alpha,inc\n");
+        }
+        finally { ctx.Dispose(); File.Delete(path); }
+    }
+
+    [Fact]
+    public void ToCsv_ShouldLeaveTheDestinationStreamOpen()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var command = ctx.From<CsvOrder>().Where(x => x.Id == 1).Select(x => new { x.Id });
+            var stream = new MemoryStream();
+
+            command.ToCsv(stream);
+
+            stream.CanRead.Should().BeTrue();
+            stream.CanWrite.Should().BeTrue();
+        }
+        finally { ctx.Dispose(); File.Delete(path); }
+    }
+
+    [Fact]
+    public void ToCsv_ShouldNotEmitByteOrderMark()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var command = ctx.From<CsvOrder>().Where(x => x.Id == 1).Select(x => new { x.Id });
+            using var stream = new MemoryStream();
+
+            command.ToCsv(stream);
+
+            var bytes = stream.ToArray();
+            (bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF)
+                .Should().BeFalse("the UTF-8 output must not carry a byte-order mark");
+        }
+        finally { ctx.Dispose(); File.Delete(path); }
+    }
+
+    [Fact]
+    public void ToCsv_WithoutHeader_ShouldSkipTheHeaderLine()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            var command = ctx.From<CsvOrder>().Where(x => x.Id == 2).Select(x => new { x.Id });
+            using var stream = new MemoryStream();
+
+            command.ToCsv(stream, new CsvOptions { IncludeHeader = false });
+
+            Read(stream).Should().Be("2\n");
+        }
+        finally { ctx.Dispose(); File.Delete(path); }
+    }
+
+    [Fact]
+    public void ToCsv_ShouldNotInvokeTheRowMapper()
+    {
+        var (ctx, path) = CreateDb();
+        try
+        {
+            CountingRow.Assignments = 0;
+            var command = ctx.From<CsvOrder>().OrderBy(x => x.Id).Select(x => new CountingRow { Id = x.Id, Name = x.Name });
+            using var stream = new MemoryStream();
+
+            var rows = command.ToCsv(stream);
+
+            rows.Should().Be(3);
