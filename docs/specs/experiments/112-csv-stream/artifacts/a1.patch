+using FluentAssertions;
+
+namespace NextORM.Core.Tests;
+
+/// <summary>
+/// Coverage for the CSV terminals' provider gate and argument validation: the in-memory provider has no
+/// reader to stream raw columns from, so it rejects the terminal with <see cref="NotSupportedException"/>.
+/// </summary>
+public class CsvTerminalTests
+{
+    [Fact]
+    public void QueryCommandToCsv_OnInMemoryProvider_ShouldThrowNotSupported()
+    {
+        using var ctx = new InMemoryDataContext();
+        ctx.From<SimpleEntity>().WithData([new SimpleEntity { Id = 1 }]);
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+        using var stream = new MemoryStream();
+
+        var act = () => command.ToCsv(stream);
+
+        act.Should().Throw<NotSupportedException>();
+    }
+
+    [Fact]
+    public async Task QueryCommandToCsvAsync_OnInMemoryProvider_ShouldThrowNotSupported()
+    {
+        using var ctx = new InMemoryDataContext();
+        ctx.From<SimpleEntity>().WithData([new SimpleEntity { Id = 1 }]);
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+        using var stream = new MemoryStream();
+
+        var act = async () => await command.ToCsvAsync(stream, cancellationToken: TestContext.Current.CancellationToken);
+
+        await act.Should().ThrowAsync<NotSupportedException>();
+    }
+
+    [Fact]
+    public void EntityBuilderToCsv_OnInMemoryProvider_ShouldThrowNotSupported()
+    {
+        using var ctx = new InMemoryDataContext();
+        ctx.From<SimpleEntity>().WithData([new SimpleEntity { Id = 1 }]);
+        using var stream = new MemoryStream();
+
+        var act = () => ctx.From<SimpleEntity>().ToCsv(stream);
+
+        act.Should().Throw<NotSupportedException>();
+    }
+
+    [Fact]
+    public void QueryCommandToCsv_NullStream_ShouldThrowArgumentNull()
+    {
+        using var ctx = new InMemoryDataContext();
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+
+        var act = () => command.ToCsv((Stream)null!);
+
+        act.Should().Throw<ArgumentNullException>();
+    }
+
+    [Fact]
+    public void QueryCommandToCsv_NullWriter_ShouldThrowArgumentNull()
+    {
+        using var ctx = new InMemoryDataContext();
+        var command = ctx.From<SimpleEntity>().Select(x => new { x.Id });
+
+        var act = () => command.ToCsv((TextWriter)null!);
+
+        act.Should().Throw<ArgumentNullException>();
+    }
+}
