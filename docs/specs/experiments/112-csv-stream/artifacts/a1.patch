+    /// <param name="command">The command to execute.</param>
+    /// <param name="writer">The destination writer; it is flushed but not disposed by this call.</param>
+    /// <param name="options">The CSV formatting options, or <see langword="null"/> for <see cref="CsvOptions.Default"/>.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>The number of rows written (the header line is not counted).</returns>
+    public static long ToCsv<TResult>(this QueryCommand<TResult> command, TextWriter writer, CsvOptions? options = null, params ReadOnlySpan<object?> parameters)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+        ArgumentNullException.ThrowIfNull(writer);
+
+        return WriteCsv(command, writer, options ?? CsvOptions.Default, parameters);
+    }
+
+    /// <summary>
+    /// Asynchronously executes the command and writes the result set as CSV to <paramref name="stream"/>.
+    /// Rows are read straight from the provider reader and written through typed accessors, so no
+    /// <typeparamref name="TResult"/> is created per row and the standard column types are not boxed.
+    /// The stream is left open.
+    /// </summary>
+    /// <typeparam name="TResult">The projected result type; it is not materialised on this path.</typeparam>
+    /// <param name="command">The command to execute.</param>
+    /// <param name="stream">The destination stream; it is not closed or disposed by this call.</param>
+    /// <param name="options">The CSV formatting options, or <see langword="null"/> for <see cref="CsvOptions.Default"/>.</param>
+    /// <param name="cancellationToken">Cancels opening the reader and reading rows.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of rows written (the header line is not counted).</returns>
+    public static async Task<long> ToCsvAsync<TResult>(this QueryCommand<TResult> command, Stream stream, CsvOptions? options = null, CancellationToken cancellationToken = default, params object[] parameters)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+        ArgumentNullException.ThrowIfNull(stream);
+
+        var writer = new StreamWriter(stream, Utf8NoBom, 1024, leaveOpen: true);
+        using (writer)
+        {
+            return await WriteCsvAsync(command, writer, options ?? CsvOptions.Default, parameters, cancellationToken).ConfigureAwait(false);
+        }
+    }
+
+    /// <summary>
+    /// Asynchronously executes the command and writes the result set as CSV to <paramref name="writer"/>.
+    /// Rows are read straight from the provider reader and written through typed accessors, so no
+    /// <typeparamref name="TResult"/> is created per row and the standard column types are not boxed.
+    /// The writer is flushed but not disposed.
+    /// </summary>
+    /// <typeparam name="TResult">The projected result type; it is not materialised on this path.</typeparam>
+    /// <param name="command">The command to execute.</param>
+    /// <param name="writer">The destination writer; it is flushed but not disposed by this call.</param>
+    /// <param name="options">The CSV formatting options, or <see langword="null"/> for <see cref="CsvOptions.Default"/>.</param>
+    /// <param name="cancellationToken">Cancels opening the reader and reading rows.</param>
+    /// <param name="parameters">The positional parameter values bound to the query.</param>
+    /// <returns>A task producing the number of rows written (the header line is not counted).</returns>
+    public static async Task<long> ToCsvAsync<TResult>(this QueryCommand<TResult> command, TextWriter writer, CsvOptions? options = null, CancellationToken cancellationToken = default, params object[] parameters)
+    {
+        ArgumentNullException.ThrowIfNull(command);
+        ArgumentNullException.ThrowIfNull(writer);
+
+        return await WriteCsvAsync(command, writer, options ?? CsvOptions.Default, parameters, cancellationToken).ConfigureAwait(false);
+    }
+
+    private static long WriteCsv<TResult>(QueryCommand<TResult> command, TextWriter writer, CsvOptions options, ReadOnlySpan<object?> parameters)
+    {
+        var context = RequireRelationalContext(command);
+        var prepared = context.GetPreparedRawColumnsCommand(command, CancellationToken.None);
+
+        using var reader = context.OpenRawReader(prepared, parameters);
+        var csv = new CsvWriter(writer, options);
+
+        if (options.IncludeHeader)
+            csv.WriteHeader(reader);
+
+        long rows = 0;
+        while (reader.Read())
+        {
+            csv.WriteRow(reader);
+            rows++;
+        }
+
+        csv.Flush();
+        writer.Flush();
+        return rows;
+    }
+
+    private static async Task<long> WriteCsvAsync<TResult>(QueryCommand<TResult> command, TextWriter writer, CsvOptions options, object[] parameters, CancellationToken cancellationToken)
+    {
+        var context = RequireRelationalContext(command);
+        var prepared = context.GetPreparedRawColumnsCommand(command, cancellationToken);
+
+        using var reader = await context.OpenRawReaderAsync(prepared, parameters, cancellationToken).ConfigureAwait(false);
+        var csv = new CsvWriter(writer, options);
+
+        if (options.IncludeHeader)
+            csv.WriteHeader(reader);
+
+        long rows = 0;
+        while (await reader.ReadAsync(cancellationToken).ConfigureAwait(false))
+        {
+            csv.WriteRow(reader);
+            rows++;
+        }
+
+        csv.Flush();
+        await writer.FlushAsync(cancellationToken).ConfigureAwait(false);
+        return rows;
+    }
+
     internal const string LobDataReaderLocatorMessage =
         "ToDataReader is not supported on providers that append a LOB locator column (SQLite); use ToStream/ToTextReader for a single LOB column.";
 
