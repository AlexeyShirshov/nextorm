new file mode 100644
index 0000000..df992b7
--- /dev/null
+++ b/src/nextorm.core/DataContext/CsvWriter.cs
@@ -0,0 +1,245 @@
+using System.Data.Common;
+using System.Globalization;
+
+namespace NextORM.Core;
+
+/// <summary>
+/// Writes a <see cref="DbDataReader"/> result set as CSV to a <see cref="TextWriter"/> without
+/// materialising a result object per row. Values are read through the reader's typed accessors
+/// (<c>GetInt32</c>, <c>GetDecimal</c>, <c>GetString</c>, ...) so the common column types are never
+/// boxed; only a column whose provider type has no typed accessor falls back to <c>GetValue</c>.
+/// </summary>
+/// <remarks>
+/// The writer owns a reusable character buffer and flushes it to the destination when it fills, so
+/// memory use is O(buffer) regardless of the result-set size. The destination writer is never disposed.
+/// </remarks>
+internal sealed class CsvWriter
+{
+    private const int BufferSize = 4096;
+
+    private readonly TextWriter _writer;
+    private readonly CsvOptions _options;
+    private readonly char[] _buffer = new char[BufferSize];
+    private int _pos;
+
+    internal CsvWriter(TextWriter writer, CsvOptions options)
+    {
+        _writer = writer;
+        _options = options;
+    }
+
+    /// <summary>Writes the header line with the reader's column names.</summary>
+    internal void WriteHeader(DbDataReader reader)
+    {
+        var count = reader.FieldCount;
+        for (var i = 0; i < count; i++)
+        {
+            if (i > 0)
+                Append(_options.Delimiter);
+
+            var name = reader.GetName(i);
+            AppendField(string.IsNullOrEmpty(name) ? "column" + i.ToString(CultureInfo.InvariantCulture) : name);
+        }
+
+        EndRow();
+    }
+
+    /// <summary>Writes the reader's current row.</summary>
+    internal void WriteRow(DbDataReader reader)
+    {
+        var count = reader.FieldCount;
+        for (var i = 0; i < count; i++)
+        {
+            if (i > 0)
+                Append(_options.Delimiter);
+
+            WriteField(reader, i);
+        }
+
+        EndRow();
+    }
+
+    /// <summary>Flushes the internal buffer to the destination writer.</summary>
+    internal void Flush()
+    {
+        if (_pos == 0)
+            return;
+
+        _writer.Write(_buffer, 0, _pos);
+        _pos = 0;
+    }
+
+    private void WriteField(DbDataReader reader, int ordinal)
+    {
+        if (reader.IsDBNull(ordinal))
+        {
+            if (_options.NullText is { } nullText)
+                AppendField(nullText);
+
+            return;
+        }
+
+        var type = reader.GetFieldType(ordinal);
+        switch (Type.GetTypeCode(type))
+        {
+            case TypeCode.Boolean:
+                AppendField(reader.GetBoolean(ordinal) ? _options.TrueText : _options.FalseText);
+                return;
+            case TypeCode.Byte:
+                AppendFormattable(reader.GetByte(ordinal), default);
+                return;
+            case TypeCode.SByte:
+                AppendFormattable(reader.GetFieldValue<sbyte>(ordinal), default);
+                return;
+            case TypeCode.Int16:
+                AppendFormattable(reader.GetInt16(ordinal), default);
+                return;
+            case TypeCode.UInt16:
+                AppendFormattable(reader.GetFieldValue<ushort>(ordinal), default);
+                return;
+            case TypeCode.Int32:
+                AppendFormattable(reader.GetInt32(ordinal), default);
+                return;
+            case TypeCode.UInt32:
+                AppendFormattable(reader.GetFieldValue<uint>(ordinal), default);
+                return;
+            case TypeCode.Int64:
+                AppendFormattable(reader.GetInt64(ordinal), default);
+                return;
+            case TypeCode.UInt64:
+                AppendFormattable(reader.GetFieldValue<ulong>(ordinal), default);
+                return;
+            case TypeCode.Single:
+                AppendFormattable(reader.GetFloat(ordinal), _options.NumberFormat);
+                return;
+            case TypeCode.Double:
+                AppendFormattable(reader.GetDouble(ordinal), _options.NumberFormat);
+                return;
+            case TypeCode.Decimal:
+                AppendFormattable(reader.GetDecimal(ordinal), _options.NumberFormat);
+                return;
+            case TypeCode.DateTime:
+                AppendFormattable(reader.GetDateTime(ordinal), _options.DateTimeFormat);
+                return;
+            case TypeCode.Char:
+                AppendFormattable(reader.GetChar(ordinal), default);
+                return;
+            case TypeCode.String:
+                AppendField(reader.GetString(ordinal));
+                return;
+        }
+
+        if (type == typeof(Guid))
+        {
+            AppendFormattable(reader.GetGuid(ordinal), default);
+            return;
+        }
+
+        if (type == typeof(DateTimeOffset))
+        {
+            AppendFormattable(reader.GetFieldValue<DateTimeOffset>(ordinal), _options.DateTimeOffsetFormat);
+            return;
+        }
+
+        if (type == typeof(TimeSpan))
+        {
+            AppendFormattable(reader.GetFieldValue<TimeSpan>(ordinal), _options.TimeSpanFormat);
+            return;
+        }
+
+        if (type == typeof(byte[]))
+        {
+            AppendField(Convert.ToBase64String(reader.GetFieldValue<byte[]>(ordinal)));
+            return;
+        }
+
+        // Exotic provider type with no typed accessor: read the boxed value and render it. This is the
+        // only path that boxes a value type; every standard column type above is read without boxing.
+        var value = reader.GetValue(ordinal);
+        if (value is null or DBNull)
+            return;
+
+        AppendField(Convert.ToString(value, _options.FormatProvider) ?? string.Empty);
+    }
+
+    private void AppendFormattable<T>(T value, ReadOnlySpan<char> format)
+        where T : struct, ISpanFormattable
+    {
+        Span<char> scratch = stackalloc char[64];
+        if (value.TryFormat(scratch, out var written, format, _options.FormatProvider))
+        {
+            AppendField(scratch[..written]);
+            return;
+        }
+
+        AppendField(value.ToString(format.ToString(), _options.FormatProvider) ?? string.Empty);
+    }
+
+    private void AppendField(string value) => AppendField(value.AsSpan());
+
+    private void AppendField(ReadOnlySpan<char> value)
+    {
+        if (_options.AlwaysQuote || NeedsQuoting(value))
+        {
+            var quote = _options.Quote;
+            Append(quote);
+            for (var i = 0; i < value.Length; i++)
+            {
+                var c = value[i];
+                if (c == quote)
+                    Append(quote);
+
+                Append(c);
+            }
+
+            Append(quote);
+            return;
+        }
+
+        Append(value);
+    }
+
+    private bool NeedsQuoting(ReadOnlySpan<char> value)
+    {
+        if (value.IndexOfAny(_options.Quote, '\r', '\n') >= 0)
+            return true;
+
+        return _options.Delimiter.Length > 0 && value.IndexOf(_options.Delimiter.AsSpan()) >= 0;
+    }
+
+    private void EndRow() => Append(_options.NewLine);
+
+    private void Append(string value)
+    {
+        if (value.Length == 0)
+            return;
+
+        Append(value.AsSpan());
+    }
+
+    private void Append(ReadOnlySpan<char> value)
+    {
+        while (value.Length > 0)
+        {
+            var space = _buffer.Length - _pos;
+            if (space == 0)
+            {
+                Flush();
+                space = _buffer.Length;
+            }
+
+            var take = Math.Min(space, value.Length);
+            value[..take].CopyTo(_buffer.AsSpan(_pos));
+            _pos += take;
+            value = value[take..];
+        }
+    }
+
+    private void Append(char value)
+    {
+        if (_pos == _buffer.Length)
+            Flush();
+
+        _buffer[_pos++] = value;
+    }
+}
