@@ -0,0 +1,73 @@
+using System.Globalization;
+
+namespace NextORM.Core;
+
+/// <summary>
+/// Formatting options for the CSV streaming terminals (<c>ToCsv</c>/<c>ToCsvAsync</c> on
+/// <see cref="QueryCommand{TResult}"/> and <see cref="EntityBuilder{TEntity}"/>). The defaults emit an
+/// RFC 4180-style document: a comma-separated header line followed by one line per row, values quoted
+/// only when they contain the delimiter, the quote character or a line break.
+/// </summary>
+/// <remarks>
+/// The options are immutable; construct a new instance (or mutate a copy-free builder expression) for a
+/// different shape. <see cref="Default"/> is a shared, valid instance and is safe for concurrent use.
+/// </remarks>
+public sealed class CsvOptions
+{
+    /// <summary>Gets the shared default options (header on, comma delimiter, <c>\n</c> line break, invariant formatting).</summary>
+    public static CsvOptions Default { get; } = new();
+
+    /// <summary>
+    /// Gets a value indicating whether a header line with the result-set column names is written before the rows.
+    /// Defaults to <see langword="true"/>.
+    /// </summary>
+    public bool IncludeHeader { get; init; } = true;
+
+    /// <summary>
+    /// Gets the field delimiter. Defaults to <c>","</c>. The value may be a single character (for example
+    /// <c>";"</c>) or a multi-character string (for example <c>"\t"</c>).
+    /// </summary>
+    public string Delimiter { get; init; } = ",";
+
+    /// <summary>Gets the character used to quote a field that contains the delimiter, the quote character or a line break. Defaults to <c>"</c>.</summary>
+    public char Quote { get; init; } = '"';
+
+    /// <summary>
+    /// Gets a value indicating whether every field is quoted, even when it does not require quoting.
+    /// Defaults to <see langword="false"/>.
+    /// </summary>
+    public bool AlwaysQuote { get; init; }
+
+    /// <summary>Gets the line-break sequence written after every row and after the header. Defaults to <c>"\n"</c>.</summary>
+    public string NewLine { get; init; } = "\n";
+
+    /// <summary>
+    /// Gets the format provider used to render numeric and date/time values, or <see langword="null"/> for
+    /// the current culture. Defaults to <see cref="CultureInfo.InvariantCulture"/> so the output is portable.
+    /// </summary>
+    public IFormatProvider? FormatProvider { get; init; } = CultureInfo.InvariantCulture;
+
+    /// <summary>Gets the format string used for <see cref="DateTime"/> columns. Defaults to <c>"O"</c> (round-trip).</summary>
+    public string DateTimeFormat { get; init; } = "O";
+
+    /// <summary>Gets the format string used for <see cref="DateTimeOffset"/> columns. Defaults to <c>"O"</c> (round-trip).</summary>
+    public string DateTimeOffsetFormat { get; init; } = "O";
+
+    /// <summary>Gets the format string used for <see cref="TimeSpan"/> columns. Defaults to <c>"c"</c>.</summary>
+    public string TimeSpanFormat { get; init; } = "c";
+
+    /// <summary>
+    /// Gets the format string used for <see cref="float"/>, <see cref="double"/> and <see cref="decimal"/>
+    /// columns, or an empty string to use the default round-trip format. Defaults to an empty string.
+    /// </summary>
+    public string NumberFormat { get; init; } = string.Empty;
+
+    /// <summary>Gets the text written for a SQL <c>NULL</c> field, or <see langword="null"/> to write an empty field. Defaults to <see langword="null"/>.</summary>
+    public string? NullText { get; init; }
+
+    /// <summary>Gets the text written for a <see langword="true"/> boolean field. Defaults to <c>"true"</c>.</summary>
+    public string TrueText { get; init; } = "true";
+
+    /// <summary>Gets the text written for a <see langword="false"/> boolean field. Defaults to <c>"false"</c>.</summary>
+    public string FalseText { get; init; } = "false";
+}
