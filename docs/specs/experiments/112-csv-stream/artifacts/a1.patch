+using System.Text;
+using FluentAssertions;
+
+namespace NextORM.Integration.Tests;
+
+/// <summary>
+/// Provider-agnostic coverage for the CSV streaming terminals: the query result reaches the
+/// destination as CSV with a header line and one line per row, synchronously and asynchronously, and
+/// the returned count matches the number of rows. The exact column names and the seeded row count are
+/// provider specific, so the assertions derive the expected count from the materialised query and look
+/// at the line shape only.
+/// </summary>
+public abstract partial class CommonTestSuite
+{
+    [Fact]
+    public void ToCsv_ShouldStreamRowsToStream()
+    {
+        var command = _sut.SimpleEntity.OrderBy(x => x.Id).Select(x => new { x.Id });
+        var expected = command.ToList().Count;
+        using var stream = new MemoryStream();
+
+        var rows = command.ToCsv(stream);
+
+        rows.Should().Be(expected);
+        var lines = Lines(stream);
+        lines.Should().HaveCount(expected + 1);
+        lines[0].Should().NotBeEmpty();
+    }
+
+    [Fact]
+    public async Task ToCsvAsync_ShouldStreamRowsToStream()
+    {
+        var command = _sut.SimpleEntity.OrderBy(x => x.Id).Select(x => new { x.Id });
+        var expected = command.ToList().Count;
+        using var stream = new MemoryStream();
+
+        var rows = await command.ToCsvAsync(stream, cancellationToken: TestContext.Current.CancellationToken);
+
+        rows.Should().Be(expected);
+        Lines(stream).Should().HaveCount(expected + 1);
+    }
+
+    [Fact]
+    public void ToCsv_ToTextWriter_ShouldWriteHeaderAndRows()
+    {
+        var command = _sut.SimpleEntity.OrderBy(x => x.Id).Select(x => new { x.Id });
+        var expected = command.ToList().Count;
+        var destination = new StringWriter();
+
+        var rows = command.ToCsv(destination);
+
+        rows.Should().Be(expected);
+        Lines(destination.ToString()).Should().HaveCount(expected + 1);
+    }
+
+    [Fact]
+    public void ToCsv_OnEntityBuilder_ShouldStreamTheEntityColumns()
+    {
+        var expected = _sut.SimpleEntity.Count();
+        using var stream = new MemoryStream();
+
+        var rows = _sut.SimpleEntity.OrderBy(x => x.Id).ToCsv(stream);
+
+        rows.Should().Be(expected);
+        Lines(stream).Should().HaveCount(expected + 1);
+    }
+
+    [Fact]
+    public void ToCsv_WithoutHeader_ShouldEmitDataLinesOnly()
+    {
+        var command = _sut.SimpleEntity.OrderBy(x => x.Id).Select(x => new { x.Id });
+        var expected = command.ToList().Count;
+        using var stream = new MemoryStream();
+
+        var rows = command.ToCsv(stream, new CsvOptions { IncludeHeader = false });
+
+        rows.Should().Be(expected);
+        Lines(stream).Should().HaveCount(expected);
+    }
+
+    private static string[] Lines(MemoryStream stream)
+    {
+        stream.Position = 0;
+        return Lines(Encoding.UTF8.GetString(stream.ToArray()));
+    }
+
+    private static string[] Lines(string text)
+        => text.Replace("\r\n", "\n").Split('\n', StringSplitOptions.RemoveEmptyEntries);
+}
