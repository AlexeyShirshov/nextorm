@@ -0,0 +1,158 @@
+using System.Data;
+using System.Globalization;
+using System.Text;
+using FluentAssertions;
+
+namespace NextORM.Core.Tests;
+
+/// <summary>
+/// Unit coverage for the internal <see cref="CsvWriter"/> using a real <see cref="DataTableReader"/>
+/// (typed accessors, DBNull handling, quoting, custom options and buffer flushing).
+/// </summary>
+public class CsvWriterTests
+{
+    private static readonly DateTime Created = new(2024, 1, 2, 3, 4, 5);
+
+    private static string Write(DataTable table, CsvOptions? options = null)
+    {
+        using var reader = table.CreateDataReader();
+        var destination = new StringWriter();
+        var writer = new CsvWriter(destination, options ?? CsvOptions.Default);
+
+        if ((options ?? CsvOptions.Default).IncludeHeader)
+            writer.WriteHeader(reader);
+
+        while (reader.Read())
+            writer.WriteRow(reader);
+
+        writer.Flush();
+        return destination.ToString();
+    }
+
+    private static DataTable CreateTable()
+    {
+        var table = new DataTable();
+        table.Columns.Add("Id", typeof(int));
+        table.Columns.Add("Name", typeof(string));
+        table.Columns.Add("Amount", typeof(decimal));
+        table.Columns.Add("Active", typeof(bool));
+        table.Columns.Add("Created", typeof(DateTime));
+        table.Columns.Add("Note", typeof(string));
+        return table;
+    }
+
+    [Fact]
+    public void ShouldRenderTypedColumnsWithHeader()
+    {
+        var table = CreateTable();
+        var created = Created;
+        table.Rows.Add(1, "alpha", 10m, true, created, "ok");
+        table.Rows.Add(2, "beta", 2.5m, false, created, DBNull.Value);
+
+        var csv = Write(table);
+
+        var expected =
+            "Id,Name,Amount,Active,Created,Note\n" +
+            $"1,alpha,10,true,{created.ToString("O", CultureInfo.InvariantCulture)},ok\n" +
+            $"2,beta,2.5,false,{created.ToString("O", CultureInfo.InvariantCulture)},\n";
+        csv.Should().Be(expected);
+    }
+
+    [Fact]
+    public void ShouldQuoteFieldsWithDelimiterQuoteOrLineBreak()
+    {
+        var table = CreateTable();
+        table.Rows.Add(1, "a,b", 0m, true, Created, "he said \"hi\"");
+        table.Rows.Add(2, "line\nbreak", 0m, true, Created, "ok");
+
+        var csv = Write(table);
+
+        csv.Should().Contain("1,\"a,b\",0,true,");
+        csv.Should().Contain("he said \"\"hi\"\"");
+        csv.Should().Contain("\"line\nbreak\"");
+    }
+
+    [Fact]
+    public void NullText_ShouldReplaceEmptyNullField()
+    {
+        var table = CreateTable();
+        table.Rows.Add(1, DBNull.Value, 0m, true, Created, DBNull.Value);
+
+        var csv = Write(table, new CsvOptions { NullText = "\\N" });
+
+        csv.Should().Be(
+            "Id,Name,Amount,Active,Created,Note\n" +
+            $"1,\\N,0,true,{Created.ToString("O", CultureInfo.InvariantCulture)},\\N\n");
+    }
+
+    [Fact]
+    public void AlwaysQuote_ShouldQuoteEveryField()
+    {
+        var table = CreateTable();
+        table.Rows.Add(1, "alpha", 0m, true, Created, "ok");
+
+        var csv = Write(table, new CsvOptions { AlwaysQuote = true });
+
+        csv.Should().Be(
+            "\"Id\",\"Name\",\"Amount\",\"Active\",\"Created\",\"Note\"\n" +
+            $"\"1\",\"alpha\",\"0\",\"true\",\"{Created.ToString("O", CultureInfo.InvariantCulture)}\",\"ok\"\n");
+    }
+
+    [Fact]
+    public void CustomDelimiterAndLineBreak_ShouldBeHonoured()
+    {
+        var table = new DataTable();
+        table.Columns.Add("Id", typeof(int));
+        table.Columns.Add("Name", typeof(string));
+        table.Rows.Add(1, "alpha");
+
+        var csv = Write(table, new CsvOptions { Delimiter = ";", NewLine = "\r\n", IncludeHeader = false });
+
+        csv.Should().Be("1;alpha\r\n");
+    }
+
+    [Fact]
+    public void LargeResultSet_ShouldFlushTheBufferWithoutCorruption()
+    {
+        var table = new DataTable();
+        table.Columns.Add("Id", typeof(int));
+        table.Columns.Add("Name", typeof(string));
+        for (var i = 0; i < 2000; i++)
+            table.Rows.Add(i, "name-" + i.ToString(CultureInfo.InvariantCulture));
+
+        var csv = Write(table, new CsvOptions { IncludeHeader = false });
+        var lines = csv.Split('\n', StringSplitOptions.RemoveEmptyEntries);
+
+        lines.Should().HaveCount(2000);
+        lines[0].Should().Be("0,name-0");
+        lines[^1].Should().Be("1999,name-1999");
+    }
+
+    [Fact]
+    public void CustomNumberAndBooleanText_ShouldBeHonoured()
+    {
+        var table = new DataTable();
+        table.Columns.Add("Amount", typeof(double));
+        table.Columns.Add("Active", typeof(bool));
+        table.Rows.Add(1.5, true);
+
+        var csv = Write(table, new CsvOptions { NumberFormat = "0.00", TrueText = "YES", FalseText = "NO", IncludeHeader = false });
+
+        csv.Should().Be("1.50,YES\n");
+    }
+
+    [Fact]
+    public void ShouldRenderGuidAndWiderNumerics()
+    {
+        var table = new DataTable();
+        table.Columns.Add("Big", typeof(long));
+        table.Columns.Add("Token", typeof(Guid));
+        table.Columns.Add("Ratio", typeof(double));
+        var token = Guid.Parse("11111111-2222-3333-4444-555555555555");
+        table.Rows.Add(9_000_000_000L, token, 0.5d);
+
+        var csv = Write(table, new CsvOptions { IncludeHeader = false });
+
+        csv.Should().Be($"9000000000,{token},0.5\n");
+    }
+}
