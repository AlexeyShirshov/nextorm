+        return (DbPreparedQueryCommand<TResult>)_planner.GetPreparedQueryCommand(
+            queryCommand,
+            createEnumerator: false,
+            storeInCache: false,
+            sequentialAccess: false,
+            streamingRowsRequested: false,
+            cancellationToken);
+    }
