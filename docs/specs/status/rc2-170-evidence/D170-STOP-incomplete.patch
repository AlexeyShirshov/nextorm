+/// <summary>
+/// D170 (#170): ClickHouse runtime negative for the one-to-one <c>JoinInto</c> backstop. ClickHouse does
+/// not derive <see cref="CommonTestSuite"/>, so the int-key duplicate-identity case is re-pinned here
+/// against a real server: a parent that matches two distinct children must throw
+/// <see cref="InvalidOperationException"/> at materialization, sync and async, exactly like every other
+/// provider. This is runtime (materialization) evidence, not a SQL-generation or capability-flag check.
+/// The <c>eager_parent</c>/<c>eager_child</c> fixtures and the one-to-one mapping are registered by
+/// <see cref="NavConScenarios.Seed"/>, which mirrors <c>CommonTestSuite.JoinInto</c>.
+/// </summary>
+public sealed class ClickHouseJoinIntoOneToOneTests : ProviderTestSuite
+{
+    protected override ITestProvider Provider => ClickHouseTestProvider.Instance;
+
+    [Fact]
+    public void JoinInto_OneToOne_ShouldThrowWhenAParentMatchesMoreThanOneChild()
+    {
+        var f = NavConScenarios.Seed(_sut.DataProvider);
+
+        Action act = () => _sut.DataProvider.From<JoinIntoParent>()
+            .Where(p => p.Id == f)
+            .JoinInto(_sut.DataProvider.From<JoinIntoChild>(), (p, c) => p.Id == c.ParentId, p => p.PrimaryChild)
+            .ToList();
+
+        act.Should().Throw<InvalidOperationException>()
+            .WithMessage("*more than one distinct*");
+    }
+
+    [Fact]
+    public async Task JoinInto_OneToOne_ShouldThrowWhenAParentMatchesMoreThanOneChildAsync()
+    {
+        var f = NavConScenarios.Seed(_sut.DataProvider);
+
+        Func<Task> act = () => _sut.DataProvider.From<JoinIntoParent>()
+            .Where(p => p.Id == f)
+            .JoinInto(_sut.DataProvider.From<JoinIntoChild>(), (p, c) => p.Id == c.ParentId, p => p.PrimaryChild)
+            .ToListAsync(TestContext.Current.CancellationToken);
+
+        await act.Should().ThrowAsync<InvalidOperationException>()
+            .WithMessage("*more than one distinct*");
+    }
+}
