+    {
+        var plan = Plan(false, new JsonStreamOptions(), Column(type, "Value"));
+
+        JsonNativeStream.IsEligible(plan, plan.Options).Should().BeFalse();
+    }
+
+    [Fact]
+    public void NumericEnum_ShouldStayManaged()
+    {
