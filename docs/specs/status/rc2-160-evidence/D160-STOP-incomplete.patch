+            .CrossApply(s => ctx.From<IComplexEntity>().Where(c => c.Id == s.Id).Select(c => new { c.Id, c.String }), Alias.Applied)
+            .Select(p => new { p.Item1.Id, p.Applied.String }));
+
+        alias.Should().Be(positional);
