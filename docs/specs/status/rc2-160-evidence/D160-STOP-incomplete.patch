index 90d75685..a7959afb 100644
--- a/tests/nextorm.core.tests/RootProjectionTests.cs
+++ b/tests/nextorm.core.tests/RootProjectionTests.cs
@@ -145,6 +145,25 @@ public class RootProjectionTests
             .Should().Be(typeof(System.Linq.Expressions.Expression<>));
     }
 
+    [Fact]
+    public void As_overflow_escape_projects_the_chain_and_continues_from_the_derived_table()
+    {
+        using var ctx = new TestContext();
+        var people = ctx.From<Person>();
+
+        // The documented arity escape is usable, not merely reflected: a joined chain is projected into
+        // a named shape with As<TResult>, and composition continues from the derived table.
+        var derived = ctx.From<Order>()
+            .Join(people, (o, p) => o.BuyerId == p.Id)
+            .As(p => new { OrderId = p.Item1.Id, BuyerId = p.Item2.Id });
