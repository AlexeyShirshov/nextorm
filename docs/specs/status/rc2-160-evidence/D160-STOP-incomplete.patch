diff --git a/tests/nextorm.core.tests/EntityBuilderStateCopyTests.cs b/tests/nextorm.core.tests/EntityBuilderStateCopyTests.cs
new file mode 100644
index 00000000..06c67c40
--- /dev/null
+++ b/tests/nextorm.core.tests/EntityBuilderStateCopyTests.cs
@@ -0,0 +1,416 @@
+using System.Collections;
+using System.ComponentModel.DataAnnotations;
+using System.ComponentModel.DataAnnotations.Schema;
+using System.Data;
+using System.Data.Common;
+using System.Diagnostics.CodeAnalysis;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Text;
+using FluentAssertions;
+using FluentAssertions.Execution;
+using NextORM.Core;
+
+namespace NextORM.Core.Tests;
+
+/// <summary>
+/// F1 (D160.3-1): the <see cref="EntityBuilder{TEntity}"/> query state is transferred by one structural
+/// procedure shared by the root (<c>.WithAlias</c>/<c>AliasRoot</c>) and joined
+/// (<c>CreateAliasJoined</c>) transitions. These tests protect the generic-neutral state carrier
+/// (<see cref="EntityBuilderSharedState"/>) against the hand-maintained field-list omission that caused
+/// the D160-C1 recurrence, and prove a non-default state (a <c>SubQueryHint</c> and an entity type)
+/// survives both transitions into the rendered SQL.
+/// </summary>
+[Collection("Query cache controls")]
+public class EntityBuilderStateCopyTests
+{
+    [SqlTable("orders")]
+    private sealed class Order
+    {
+        [Key]
+        public int Id { get; set; }
+
+        [Column("buyer_id")]
+        public long BuyerId { get; set; }
+    }
+
+    [SqlTable("person")]
+    private sealed class Person
+    {
+        [Key]
+        public long Id { get; set; }
+    }
+
+    private sealed class RootProjection<T> : Projection<T>
+    {
+        [JoinSlot(1)]
+        public T Root => throw new NotSupportedException();
+    }
+
+    private sealed class RootJoinProjection<T1, T2> : Projection<T1, T2>
+    {
+        [JoinSlot(2)]
+        public T2 Buyer => throw new NotSupportedException();
+    }
+
+    // ------------------------------------------------------------------ structural completeness ----
+
+    [Fact]
+    public void Every_EntityBuilder_instance_field_is_copied_or_explicitly_excluded()
+    {
+        var fields = typeof(EntityBuilder<>).GetFields(
+            BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly);
+
+        // Transferred by the single shared CopySharedStateTo procedure: the whole generic-neutral carrier
+        // (a MemberwiseClone) plus the one public mutable struct field kept outside it.
+        var copied = new HashSet<string>(StringComparer.Ordinal) { "_state", "Paging" };
+
+        // Projection-typed or transition-owned state that is deliberately handled outside the carrier.
+        var excluded = new Dictionary<string, string>(StringComparer.Ordinal)
+        {
+            ["_dataProvider"] = "the target's data context is supplied by its factory and never transferred",
+            ["_joins"] = "the join chain is assembled explicitly by each join transition after the copy",
+            ["_condition"] = "projection-typed predicate; rebased by ApplyWhereToAliasJoined/ApplyWhereToJoined",
+            ["_having"] = "projection-typed; rebased by ApplyPreAliasStateToAliasJoined / the AliasRoot rebind step",
+            ["_group"] = "projection-typed; rebased by ApplyPreAliasStateToAliasJoined / the AliasRoot rebind step",
+            ["_preWhere"] = "projection-typed; carried explicitly then rebased by the alias transitions",
+            ["_sorting"] = "projection-typed; rebased by ApplyPreAliasStateToAliasJoined / the AliasRoot rebind step",
+            ["_loadSpecs"] = "eager-load state; join transitions fail closed before any copy",
+            ["_joinIntos"] = "JoinInto state; join transitions fail closed before any copy",
+        };
+
+        var names = fields.Select(f => f.Name).ToHashSet(StringComparer.Ordinal);
+        copied.Concat(excluded.Keys).Should().BeSubsetOf(names,
+            "exclusion entries must stay real fields; a stale entry would hide a rename");
+
+        fields.Select(f => f.Name)
+            .Where(name => !copied.Contains(name) && !excluded.ContainsKey(name))
+            .Should().BeEmpty(
+                "every EntityBuilder<> field must be copied by the single shared CopySharedStateTo procedure " +
+                "(add generic-neutral state to EntityBuilderSharedState) or listed in the explicit exclusion set " +
+                "with a reason; an unlisted field means state can be silently dropped (D160-C1)");
+    }
+
+    [Fact]
+    public void Shared_state_carrier_clone_copies_every_field()
+    {
+        var fields = typeof(EntityBuilderSharedState).GetFields(
+            BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
+        fields.Should().NotBeEmpty();
+
+        // The carrier is a value type: box it once so reflection writes reach the same instance.
+        object source = new EntityBuilderSharedState();
+        var seed = 0;
+        foreach (var field in fields)
+            field.SetValue(source, Probe(field.FieldType, ++seed));
+
+        ((EntityBuilderSharedState)source).FilterScope.Should().NotBeNull(
+            "the carrier must default its filter scope to None, not null");
+
+        var clone = ((EntityBuilderSharedState)source).Clone();
+
+        foreach (var field in fields)
+            field.GetValue(clone).Should().Be(field.GetValue(source),
+                $"carrier field '{field.Name}' must be copied by the structural clone");
+    }
+
+    // ------------------------------------------------------------------ state transfer ---------------
+
+    [Fact]
+    public void Root_alias_preserves_a_subquery_hint_and_the_source_entity_type()
+    {
+        using var ctx = new HintContext();
+        var inner = ctx.From<Order>().Select(o => new { o.Id, o.BuyerId });
+        var source = ctx.From(inner, o => o.WithSubQueryHint("MY_HINT(a)"));
+        source.SourceEntityType = typeof(Order);
+
+        var rooted = source.AliasRoot<EntityBuilder<RootProjection<Order>>, RootProjection<Order>>(
+            static dc => new EntityBuilder<RootProjection<Order>>(dc));
+
+        // Non-default state must survive the root transition, not merely fail to throw.
+        rooted.SubQueryHint.Should().Be("MY_HINT(a)");
+        rooted.SourceEntityType.Should().Be(typeof(Order));
+
+        var sql = SqlOf(ctx, rooted.Select(p => p.Root.Id));
+        sql.Should().StartWith("select /*+ MY_HINT(a) */");
+        sql.Should().Contain(") as 't1'");
+    }
+
+    [Fact]
+    public void Alias_join_transition_preserves_a_subquery_hint_and_the_source_entity_type()
+    {
+        using var ctx = new HintContext();
+        var inner = ctx.From<Order>().Select(o => new { o.Id, o.BuyerId });
+        var source = ctx.From(inner, o => o.WithSubQueryHint("MY_HINT(b)"));
+        source.SourceEntityType = typeof(Order);
+
+        var rooted = source.AliasRoot<EntityBuilder<RootProjection<Order>>, RootProjection<Order>>(
+            static dc => new EntityBuilder<RootProjection<Order>>(dc));
+        var people = ctx.From<Person>();
+
+        var joined = rooted.JoinAlias<EntityBuilder<RootJoinProjection<Order, Person>>, RootJoinProjection<Order, Person>, Person>(
+            static dc => new EntityBuilder<RootJoinProjection<Order, Person>>(dc),
+            people,
+            (a, b) => a.Root.BuyerId == b.Id);
+
+        joined.SubQueryHint.Should().Be("MY_HINT(b)");
+        joined.SourceEntityType.Should().Be(typeof(Order));
+
+        var sql = SqlOf(ctx, joined.Select(p => p.Buyer.Id));
+        sql.Should().StartWith("select /*+ MY_HINT(b) */");
+        sql.Should().Contain("join person as 't2'");
+    }
+
+    // ------------------------------------------------------------------ positional control -----------
+
+    /// <summary>
+    /// W1/W2 control: the r=3 shared <c>CopySharedStateTo</c> is also the positional (<c>CreateJoined</c>)
+    /// transfer. This test pins the baseline (40b1a159) positional behavior, where the hand-maintained
+    /// join transfer carried neither a sub-query hint, nor a tag, nor a command timeout.
+    /// </summary>
+    [Fact]
+    public void Positional_join_control_pins_the_baseline_modifier_behavior()
+    {
+        using var ctx = new HintContext();
+        var inner = ctx.From<Order>().Select(o => new { o.Id, o.BuyerId });
+        var source = ctx.From(inner, o => o.WithSubQueryHint("MY_HINT(positional)"));
+        source.SourceEntityType = typeof(Order);
+        source = source.WithTag("positional-tag").WithCommandTimeout(42);
+
+        var people = ctx.From<Person>();
+        var joined = source.Join(people, (a, b) => a.Id == b.Id);
+
+        var prepared = PreparedOf(ctx, joined.Select(p => new { OrderId = p.Item1.Id, PersonId = p.Item2.Id }));
+        var sql = prepared.DbCommand.CommandText.Replace("\r\n", "\n");
+
+        using (new AssertionScope())
+        {
+            sql.Should().NotStartWith("select /*+ MY_HINT(positional)", "baseline positional join dropped _subQueryHint\n" + sql);
+            sql.Should().NotContain("positional-tag", "baseline positional join dropped _tag\n" + sql);
+            prepared.DbCommand.CommandTimeout.Should().Be(0, "baseline positional join dropped _commandTimeout");
+        }
+    }
+
+    // ------------------------------------------------------------------ helpers ----------------------
+
+    private static string SqlOf<T>(IDataContext ctx, QueryCommand<T> cmd)
+    {
+        return PreparedOf(ctx, cmd).DbCommand.CommandText.Replace("\r\n", "\n");
+    }
+
+    private static DbPreparedQueryCommand<T> PreparedOf<T>(IDataContext ctx, QueryCommand<T> cmd)
+        => (DbPreparedQueryCommand<T>)ctx.GetPreparedQueryCommand(cmd, false, false, CancellationToken.None);
+
+    /// <summary>Builds a distinct non-null probe for a carrier field type, so the clone round-trip is observable.</summary>
+    private static object? Probe(Type type, int seed)
+    {
+        if (type == typeof(string)) return "probe" + seed;
+        if (type == typeof(bool)) return true;
+        if (type == typeof(int)) return seed;
+        if (type == typeof(double)) return seed + 0.5;
+        if (type == typeof(double?)) return (double)seed + 0.5;
+        if (type == typeof(bool?)) return true;
+        if (type == typeof(int?)) return seed;
+        if (type == typeof(Type)) return typeof(Order);
+        if (type == typeof(QueryFilterScope)) return QueryFilterScope.None;
+        if (type.IsEnum) return Enum.ToObject(type, seed);
+        if (type.IsInterface || type.IsAbstract) return null;
+        if (!type.IsValueType) return RuntimeHelpers.GetUninitializedObject(type);
+        return Activator.CreateInstance(type);
+    }
+
+    /// <summary>Provider-free dialect that accepts sub-query hints as an inline comment, like PostgreSQL/MySQL.</summary>
+    private sealed class HintDialect : SqlDialectBase
+    {
+        internal static readonly HintDialect Instance = new();
+
+        public override string MakeParam(string name) => "@" + name;
+
+        public override bool SupportsRawSqlSource => true;
+
+        public override bool SupportsSubQueryHints => true;
+
+        public override bool SupportsInlineHints => true;
+
+        public override bool SupportsQueryHints => true;
+
+        public override string RenderQueryHints(string sql, IReadOnlyList<string> hints, string? maxRecursionOption, KeywordCase keywordCase = KeywordCase.Lower)
+        {
+            var token = keywordCase == KeywordCase.Upper ? "SELECT " : "select ";
+            var index = sql.IndexOf(token, StringComparison.OrdinalIgnoreCase);
+            if (index < 0)
+                return sql;
+
+            var at = index + token.Length;
+            return sql[..at] + "/*+ " + string.Join(" ", hints) + " */ " + sql[at..];
+        }
+
+        public override void MakePage(Paging paging, StringBuilder sqlBuilder, KeywordCase keywordCase = KeywordCase.Lower)
+        {
+        }
+    }
+
+    private sealed class HintContext : DataContext
+    {
+        public HintContext() : base(new DataContextBuilder())
+        {
+        }
+
+        public override ISqlDialect Dialect => HintDialect.Instance;
+
+        public override DbParameter CreateParam(string name, object? value) => new FakeParameter(name) { Value = value };
+
+        protected override DbConnection CreateDbConnection(string? connectionString) => new FakeConnection();
+    }
+
+    private sealed class FakeParameter(string name) : DbParameter
+    {
+        public override DbType DbType { get; set; }
+
+        public override ParameterDirection Direction { get; set; }
+
+        public override bool IsNullable { get; set; }
+
+        [AllowNull]
+        public override string ParameterName { get; set; } = name;
+
+        public override int Size { get; set; }
+
+        [AllowNull]
+        public override string SourceColumn { get; set; } = string.Empty;
+
+        public override bool SourceColumnNullMapping { get; set; }
+
+        public override object? Value { get; set; }
+
+        public override void ResetDbType()
+        {
+        }
+    }
+
+    private sealed class FakeConnection : DbConnection
+    {
+        [AllowNull]
+        public override string ConnectionString { get; set; } = string.Empty;
+
+        public override string Database => string.Empty;
+
+        public override string DataSource => string.Empty;
+
+        public override string ServerVersion => string.Empty;
+
+        public override ConnectionState State => ConnectionState.Closed;
+
+        public override void ChangeDatabase(string databaseName) => throw new NotSupportedException();
+
+        public override void Close()
+        {
+        }
+
+        public override void Open()
+        {
+        }
+
+        protected override DbTransaction BeginDbTransaction(IsolationLevel isolationLevel) => throw new NotSupportedException();
+
+        protected override DbCommand CreateDbCommand() => new FakeCommand();
+    }
+
+    private sealed class FakeCommand : DbCommand
+    {
+        private readonly FakeParameterCollection _parameters = new();
+
+        [AllowNull]
+        protected override DbConnection DbConnection { get; set; } = null!;
+
+        protected override DbParameterCollection DbParameterCollection => _parameters;
+
+        [AllowNull]
+        protected override DbTransaction DbTransaction { get; set; } = null!;
+
+        [AllowNull]
+        public override string CommandText { get; set; } = string.Empty;
+
+        public override int CommandTimeout { get; set; }
+
+        public override CommandType CommandType { get; set; }
+
+        public override bool DesignTimeVisible { get; set; }
+
+        public override UpdateRowSource UpdatedRowSource { get; set; }
+
+        protected override DbParameter CreateDbParameter() => new FakeParameter(string.Empty);
+
+        public override void Cancel()
+        {
+        }
+
+        public override int ExecuteNonQuery() => throw new NotSupportedException();
+
+        public override object ExecuteScalar() => throw new NotSupportedException();
+
+        public override void Prepare()
+        {
+        }
+
+        protected override DbDataReader ExecuteDbDataReader(CommandBehavior behavior) => throw new NotSupportedException();
+    }
+
+    private sealed class FakeParameterCollection : DbParameterCollection
+    {
+        private readonly List<DbParameter> _items = [];
+
+        public override int Count => _items.Count;
+
+        public override object SyncRoot => this;
+
+        public override int Add(object value)
+        {
+            _items.Add((DbParameter)value);
+            return _items.Count - 1;
+        }
+
+        public override void AddRange(Array values)
+        {
+            foreach (var value in values)
+                Add(value!);
+        }
+
+        public override void Clear() => _items.Clear();
+
+        public override bool Contains(object value) => _items.Contains((DbParameter)value);
+
+        public override bool Contains(string? value) => _items.Any(p => p.ParameterName == value);
+
+        public override void CopyTo(Array array, int index) => ((ICollection)_items).CopyTo(array, index);
+
+        public override IEnumerator GetEnumerator() => _items.GetEnumerator();
+
+        public override int IndexOf(object value) => _items.IndexOf((DbParameter)value);
+
+        public override int IndexOf(string? parameterName) => _items.FindIndex(p => p.ParameterName == parameterName);
+
+        public override void Insert(int index, object value) => _items.Insert(index, (DbParameter)value);
+
+        public override void Remove(object value) => _items.Remove((DbParameter)value);
+
+        public override void RemoveAt(int index) => _items.RemoveAt(index);
+
+        public override void RemoveAt(string? parameterName) => _items.RemoveAll(p => p.ParameterName == parameterName);
+
+        protected override DbParameter GetParameter(int index) => _items[index];
+
+        protected override DbParameter GetParameter(string? parameterName) => _items[IndexOf(parameterName)];
+
+        protected override void SetParameter(int index, DbParameter value) => _items[index] = value;
+
+        protected override void SetParameter(string? parameterName, DbParameter value)
+        {
+            var index = IndexOf(parameterName);
+            if (index < 0)
+                Add(value);
+            else
+                _items[index] = value;
+        }
+    }
+}
