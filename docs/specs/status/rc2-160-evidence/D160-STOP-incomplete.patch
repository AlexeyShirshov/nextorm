diff --git a/tests/nextorm.integration.tests/MariaDbJoinAliasIntegrationTests.cs b/tests/nextorm.integration.tests/MariaDbJoinAliasIntegrationTests.cs
new file mode 100644
index 00000000..ff19f5ef
--- /dev/null
+++ b/tests/nextorm.integration.tests/MariaDbJoinAliasIntegrationTests.cs
@@ -0,0 +1,132 @@
+using System.ComponentModel.DataAnnotations;
+using System.ComponentModel.DataAnnotations.Schema;
+using FluentAssertions;
+using NextORM.Core;
+using NextORM.Generated.nextorm_integration_tests;
+using NextORM.MariaDb;
+
+namespace NextORM.Integration.Tests;
+
+/// <summary>
+/// MariaDB-only real-execution coverage for the #160 root alias (<c>.WithAlias</c>) and free
+/// positional/alias mixing. MariaDB has no <see cref="CommonTestSuite"/>-based integration class (it
+/// uses its own <see cref="MariaDbContainer"/> harness), so the shared root-alias/mixed facts are
+/// re-pinned here against a real MariaDB server instead of being left at SQL generation. MySQL is not
+/// substituted for MariaDB.
+/// </summary>
+public sealed class MariaDbJoinAliasIntegrationTests : IDisposable
+{
+    private readonly IDataContext _ctx;
+
+    public MariaDbJoinAliasIntegrationTests()
+    {
+        Assert.SkipUnless(MariaDbContainer.IsAvailable, MariaDbContainer.Failure ?? "MariaDB is not available.");
+
+        _ctx = new MariaDbDataContext(MariaDbContainer.ConnectionString, new DataContextBuilder());
+        Seed();
+    }
+
+    public void Dispose() => _ctx.Dispose();
+
+    [Fact]
+    public void Root_alias_inner_join_returns_matched_rows()
+    {
+        var ids = _ctx.From<IMariaDbAliasOrder>()
+            .WithAlias(Alias.Root)
+            .Join<IMariaDbAliasPerson>(_ctx.From<IMariaDbAliasPerson>(), (o, p) => o.Root.BuyerId == p.Id, Alias.Buyer)
+            .Select(p => p.Buyer.Id)
+            .ToList()
+            .OrderBy(id => id)
+            .ToList();
+
+        ids.Should().Equal(10);
+    }
+
+    [Fact]
+    public void Root_alias_then_mixed_positional_join_executes_and_keeps_slots()
+    {
+        var rows = _ctx.From<IMariaDbAliasOrder>()
+            .WithAlias(Alias.Root)
+            .Join<IMariaDbAliasPerson>(_ctx.From<IMariaDbAliasPerson>(), (o, p) => o.Root.BuyerId == p.Id, Alias.Buyer)
+            .Join(_ctx.From<IMariaDbAliasPerson>(), (p, x) => p.Buyer.Id == x.Id)
+            .Select(p => new { Root = p.Root.Id, Buyer = p.Buyer.Id, Positional = p.Item3.Id })
+            .ToList();
+
+        rows.Should().ContainSingle();
+        rows[0].Root.Should().Be(1);
+        rows[0].Buyer.Should().Be(10);
+        rows[0].Positional.Should().Be(10);
+    }
+
+    [Fact]
+    public void Mixed_positional_then_alias_join_executes_and_keeps_slot_identity()
+    {
+        var rows = _ctx.From<IMariaDbAliasOrder>()
+            .Join(_ctx.From<IMariaDbAliasPerson>(), (o, p) => o.BuyerId == p.Id)
+            .Join<IMariaDbAliasPerson>(_ctx.From<IMariaDbAliasPerson>(), (p, a) => p.Item2.Id == a.Id, Alias.Approver)
+            .Select(p => new { Positional = p.Item2.Id, Alias = p.Approver.Id })
+            .ToList();
+
+        rows.Should().ContainSingle();
+        rows[0].Positional.Should().Be(10);
+        rows[0].Alias.Should().Be(10);
+    }
+
+    [Fact]
+    public void Alternating_alias_positional_alias_executes_and_keeps_slots()
+    {
+        var rows = _ctx.From<IMariaDbAliasOrder>()
+            .Join<IMariaDbAliasPerson>(_ctx.From<IMariaDbAliasPerson>(), (o, p) => o.BuyerId == p.Id, Alias.First)
+            .Join(_ctx.From<IMariaDbAliasPerson>(), (p, x) => p.First.Id == x.Id)
+            .Join<IMariaDbAliasPerson>(_ctx.From<IMariaDbAliasPerson>(), (p, a) => p.Item3.Id == a.Id, Alias.Second)
+            .Select(p => new { First = p.First.Id, Item3 = p.Item3.Id, Second = p.Second.Id })
+            .ToList();
+
+        rows.Should().ContainSingle();
+        rows[0].First.Should().Be(10);
+        rows[0].Item3.Should().Be(10);
+        rows[0].Second.Should().Be(10);
+    }
+
+    private void Seed()
+    {
+        Execute("drop table if exists alias_person");
+        Execute("drop table if exists alias_orders");
+        Execute("create table alias_person (id int not null primary key, name varchar(50))");
+        Execute("create table alias_orders (id int not null primary key, buyer_id int not null, approver_id int not null)");
+        Execute("insert into alias_person (id, name) values (10, 'Buyer'), (20, 'Approver')");
+        Execute("insert into alias_orders (id, buyer_id, approver_id) values (1, 10, 20)");
+    }
+
+    private void Execute(string sql)
+    {
+        ((DataContext)_ctx).EnsureConnectionOpen();
+        using var cmd = ((DataContext)_ctx).CreateCommand(sql);
+        cmd.ExecuteNonQuery();
+    }
+}
+
+[SqlTable("alias_orders")]
+public interface IMariaDbAliasOrder
+{
+    [Key]
+    [Column("id")]
+    int Id { get; set; }
+
+    [Column("buyer_id")]
+    int BuyerId { get; set; }
+
+    [Column("approver_id")]
+    int ApproverId { get; set; }
+}
+
+[SqlTable("alias_person")]
+public interface IMariaDbAliasPerson
+{
+    [Key]
+    [Column("id")]
+    int Id { get; set; }
+
+    [Column("name")]
+    string? Name { get; set; }
+}
