+        alias.Should().Contain("t2.id = cast(t1.id as signed)");
+    }
+
+    [Fact]
+    public void Correlated_builder_outer_apply_alias_matches_positional()
+    {
+        using var ctx = MariaDbTestContext.Create();
+
+        var positional = SqlOf(ctx, ctx.From<ISimpleEntity>()
+            .OuterApply(s => ctx.From<IComplexEntity>().Where(c => c.Id == s.Id))
