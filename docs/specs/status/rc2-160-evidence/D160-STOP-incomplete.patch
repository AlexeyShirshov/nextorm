+                .ToCommand()
+                .AsRecursiveCte("people_nums", self => ctx.From(self)
+                    .WithAlias(Alias.Root)
+                    .Where(p => p.Root.Id < AliasSqliteDatabase.ApproverId)
+                    .Select(p => new Person { Id = p.Root.Id + 10, Name = p.Root.Name }));
+
+            var rows = ctx.From(peopleCte).Limit(10).Select(p => new { p.Id, p.Name }).ToList();
+
+            rows.Select(r => r.Id).OrderBy(id => id)
+                .Should().Equal(AliasSqliteDatabase.BuyerId, AliasSqliteDatabase.ApproverId);
+
+            var last = sql.Statements[^1];
+            last.Should().Contain("with recursive people_nums as (");
+            last.Should().Contain("union all");
+            last.Should().Contain("from people_nums");
+            last.Should().NotContain("join (select");
+        }
+        finally
+        {
+            ctx.Dispose();
+            File.Delete(path);
+        }
+    }
 }
