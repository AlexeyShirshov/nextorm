+    /// <summary>
+    /// Terminal entry: charges the gap since the previous terminal end to <see cref="Construct"/> and
+    /// returns the entry tick that <see cref="OnPrepare"/> consumes.
+    /// </summary>
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
