+    }
+
+    /// <summary>Records the terminal end used by the next <see cref="OnEntry"/> Construct gap.</summary>
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    public static void OnEnd() => _lastEnd = Stopwatch.GetTimestamp();
