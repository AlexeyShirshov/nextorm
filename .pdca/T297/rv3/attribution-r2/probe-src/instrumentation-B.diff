+        Array.Clear(_ticks);
+        Array.Clear(_calls);
+        _lastEnd = 0;
+    }
+
+    /// <summary>Returns a detached copy of the current accumulators.</summary>
+    public static ProbeSnapshot TakeSnapshot() => new((long[])_ticks.Clone(), (long[])_calls.Clone());
