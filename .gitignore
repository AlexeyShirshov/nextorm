# Python bytecode
__pycache__/
*.pyc

# PDCA cycle workspace: everything here is local working material (evidence,
# helper scripts, per-cycle scratch), so the whole tree is ignored. Only the
# cycle status files (.pdca/status/<task>-<N>.md, the source of truth for plan
# and progress) are versioned.
/.pdca/*
/.pdca/scripts/
!/.pdca/status/
