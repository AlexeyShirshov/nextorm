{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "references": {
    "specs": {
      "path": "docs/specs",
      "description": "nextorm internal engineering specs — refactoring plans (plan-baseexpressionvisitor.md, documentation-plan.md), design/API/code-smell reviews (design/*), provider feature backlogs and SQL capability gap analysis (roadmap/*), Russian mirrors (ru/*). Read on demand instead of preloading."
    }
  },
  "permission": {
    "external_directory": {
      "/home/alex/sources/nextorm*/**": "allow",
      "/home/alex/sources/linq2db-*-nextorm/**": "allow",
      "/home/alex/.config/opencode/**": "allow",
      "/tmp/nextorm*/**": "allow"
    }
  },
  "agent": {
    "nextorm-brains": { "model": "openai/gpt-6.1-sol", "variant": "high" },
    "nextorm-scout": { "model": "deepseek/deepseek-flash" },
    "nextorm-db-perf-analyst": { "model": "deepseek/deepseek-flash" },
    "nextorm-inmemory-perf-analyst": { "model": "deepseek/deepseek-flash" }
  }
}
