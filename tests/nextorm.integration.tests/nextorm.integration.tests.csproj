<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="System.Linq.Async" />
    <PackageReference Include="Testcontainers.ClickHouse" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The F18 region container mounts these before start: ClickHouse loads the embedded geobase
         configuration only at startup, so the files must be in the container image filesystem first. -->
    <None Update="ClickHouse\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\nextorm.core\nextorm.core.csproj" />
    <ProjectReference Include="..\..\src\nextorm.sqlite\nextorm.sqlite.csproj" />
    <ProjectReference Include="..\..\src\nextorm.postgres\nextorm.postgres.csproj" />
    <ProjectReference Include="..\..\src\nextorm.sqlserver\nextorm.sqlserver.csproj" />
    <ProjectReference Include="..\..\src\nextorm.mysql\nextorm.mysql.csproj" />
    <ProjectReference Include="..\..\src\nextorm.mariadb\nextorm.mariadb.csproj" />
    <ProjectReference Include="..\..\src\nextorm.clickhouse\nextorm.clickhouse.csproj" />
    <ProjectReference Include="..\..\src\nextorm.entityframeworkcore\nextorm.entityframeworkcore.csproj" />
    <!-- The join-alias generator runs as an analyzer over this test assembly so Alias.Buyer/Approver
         and the generated projection/builder types bind in the shared CommonTestSuite.JoinAlias.cs. -->
    <ProjectReference Include="..\..\src\nextorm.core.sourcegenerator\nextorm.core.sourcegenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- #328 (T328 D1): the ClickHouse timeout/retry helpers are shared with the DB-free core unit
       tests, so the sources live under tests/Shared (outside every project directory) and each
       consumer compiles them explicitly. The types are internal to the consuming assembly. -->
  <ItemGroup>
    <Compile Include="..\Shared\ClickHouseRetry\**\*.cs" Link="ClickHouseRetry\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
