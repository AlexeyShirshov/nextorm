<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Pinned to the last open-source (Apache-2.0) release; 8.x switched to the commercial Xceed license. -->
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\nextorm.core\nextorm.core.csproj" />
    <ProjectReference Include="..\..\src\nextorm.postgres\nextorm.postgres.csproj" />
    <!-- Reference the ClickHouse provider to call its Final/PreWhere/Settings/... extension methods
         when asserting that PostgreSQL rejects them at render time (issue #122). -->
    <ProjectReference Include="..\..\src\nextorm.clickhouse\nextorm.clickhouse.csproj" />
    <!-- Pivot/Unpivot moved to the SQL Server provider; the PostgreSQL generation tests call them as
         public extension methods to assert the cross-dialect rejection. -->
    <ProjectReference Include="..\..\src\nextorm.sqlserver\nextorm.sqlserver.csproj" />
    <!-- The join-alias generator runs as an analyzer over this test assembly so Alias.Buyer and the
         generated projection/builder types bind in JoinAliasSqlGenerationTests. -->
    <ProjectReference Include="..\..\src\nextorm.core.sourcegenerator\nextorm.core.sourcegenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
