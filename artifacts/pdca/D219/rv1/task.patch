+    [InlineData("current_database", "db_name()")]
+    [InlineData("version", "@@version")]
+    public void SessionInfoKeys_ShouldRenderNativeSqlOrFailClosed(string key, string? expected)
+    {
+        if (expected is null)
+        {
+            Session.Supports(key).Should().BeFalse($"SQL Server does not implement {key}");
+            var render = () => Session.Render(key);
