<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="linq2db.SQLite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.Linq.Async" />
    <!-- T217 (#217) E217-14: real-ClickHouse perf probe (DTO vs DateTime reading). -->
    <PackageReference Include="Testcontainers.ClickHouse" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\nextorm.core\nextorm.core.csproj" />
    <ProjectReference Include="..\..\src\nextorm.extensions\nextorm.extensions.csproj" />
    <ProjectReference Include="..\..\tests\nextorm.querycomponents\nextorm.querycomponents.csproj" />
    <ProjectReference Include="..\..\src\nextorm.sqlite\nextorm.sqlite.csproj" />
    <ProjectReference Include="..\..\src\nextorm.sqlserver\nextorm.sqlserver.csproj" />
    <ProjectReference Include="..\..\src\nextorm.clickhouse\nextorm.clickhouse.csproj" />
    <ProjectReference Include="..\..\src\nextorm.postgres\nextorm.postgres.csproj" />
    <ProjectReference Include="..\..\examples\nextorm.examples.postgres.aviasales\nextorm.examples.postgres.aviasales.csproj" />
    <ProjectReference Include="..\..\src\nextorm.entityframeworkcore\nextorm.entityframeworkcore.csproj" />
    <!-- The join-alias generator runs as an analyzer over the benchmark assembly so the alias-mixed
         perf cases (issue #160) compile against the generated Alias.* / AliasJoin_* / WithAlias surface. -->
    <ProjectReference Include="..\..\src\nextorm.core.sourcegenerator\nextorm.core.sourcegenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\test.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    #168 acceptance gate (D4): the acceptance benchmark is only compiled when the harness sets
    -p:AcceptanceBenchmark=true and injects acceptance/AcceptanceHarness.targets via
    -p:CustomAfterMicrosoftCommonTargets. Keeping it out of the normal build stops the gate from
    running under `dotnet build nextorm.slnx` / the other benchmark suites.
  -->
  <ItemGroup>
    <Compile Remove="acceptance/**/*.cs" />
  </ItemGroup>

  <!--
    The postgres example is referenced for its query code only (T269AirportOnTimeProbe). Its
    published `nextorm` package also ships the join-alias source generator, so NuGet would hand this
    project a second copy of the generator next to the explicit `nextorm.core.sourcegenerator`
    ProjectReference above and both copies would emit the same `NextORM.Generated.nextorm_benchmark`
    types (CS0101/CS0111). This compilation's generator comes from the source project only, so drop
    the package copy.
  -->
  <Target Name="DropTransitiveNextormGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'nextorm'" />
    </ItemGroup>
  </Target>
</Project>
