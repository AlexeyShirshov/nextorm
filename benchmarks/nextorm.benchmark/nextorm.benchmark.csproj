<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="linq2db.SQLite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.Linq.Async" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\nextorm.core\nextorm.core.csproj" />
    <ProjectReference Include="..\..\src\nextorm.sqlite\nextorm.sqlite.csproj" />
    <ProjectReference Include="..\..\src\nextorm.sqlserver\nextorm.sqlserver.csproj" />
    <ProjectReference Include="..\..\src\nextorm.clickhouse\nextorm.clickhouse.csproj" />
    <ProjectReference Include="..\..\src\nextorm.postgres\nextorm.postgres.csproj" />
    <ProjectReference Include="..\..\src\nextorm.entityframeworkcore\nextorm.entityframeworkcore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\test.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    #168 acceptance gate (D4): the acceptance benchmark is only compiled when the harness sets
    -p:AcceptanceBenchmark=true and injects acceptance/AcceptanceHarness.targets via
    -p:CustomAfterMicrosoftCommonTargets. Keeping it out of the normal build stops the gate from
    running under `dotnet build nextorm.slnx` / the other benchmark suites.
  -->
  <ItemGroup>
    <Compile Remove="acceptance/**/*.cs" />
  </ItemGroup>
</Project>
