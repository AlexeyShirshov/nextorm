<Project>

  <!--
    WSL and Windows share the same working copy, but their build outputs are not
    compatible (absolute paths, project.assets.json, platform-specific resources).
    Isolate obj/ and bin/ per host OS so builds from either side do not clobber
    each other. This is imported before Microsoft.Common.props computes
    MSBuildProjectExtensionsPath, so restore output is isolated as well.
  -->
  <PropertyGroup>
    <_HostOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_HostOs>
    <_HostOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_HostOs>
    <_HostOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_HostOs>
    <_HostOs Condition="'$(_HostOs)' == ''">unknown</_HostOs>

    <BaseIntermediateOutputPath>obj/$(_HostOs)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(_HostOs)/</BaseOutputPath>

    <!-- Stale artifacts from the old shared obj/ layout must not be globbed as sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Properties shared by every project. Override locally only where a project genuinely differs
    (e.g. the source generator targets netstandard2.0). Packaging metadata for the published
    libraries lives in src/Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Warnings are errors in every project, in every configuration. Nullable and analyzer
    warnings must be fixed or explicitly suppressed via NoWarn, never left to rot.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Nothing is packable unless it opts in (src/Directory.Build.props does for the libraries),
    so tests, benchmarks and examples cannot be published by accident.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Single version for every project in the repository; bump it here, not per .csproj.
    The packaging CI job overrides it with -p:Version=<git tag> on the release tag.
  -->
  <PropertyGroup>
    <Version>1.0.6-alpha</Version>
  </PropertyGroup>

</Project>
