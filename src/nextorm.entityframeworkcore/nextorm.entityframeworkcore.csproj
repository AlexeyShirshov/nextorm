<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>nextorm.entityframeworkcore</PackageId>
    <Title>Nextorm Entity Framework Core integration</Title>
    <Description>Entity Framework Core integration for Nextorm, a zero-SQL ORM for .NET: run nextorm queries and commands over an existing DbContext connection and transaction, reusing the EF model mapping. Adds CreateNextOrmContext().</Description>
    <PackageTags>$(PackageTags);entity-framework-core;ef-core;efcore;entity-framework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\nextorm.core\nextorm.core.csproj" />
    <ProjectReference Include="..\nextorm.postgres\nextorm.postgres.csproj" />
    <ProjectReference Include="..\nextorm.sqlite\nextorm.sqlite.csproj" />
    <ProjectReference Include="..\nextorm.sqlserver\nextorm.sqlserver.csproj" />
    <ProjectReference Include="..\nextorm.mysql\nextorm.mysql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
