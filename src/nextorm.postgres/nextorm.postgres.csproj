<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>nextorm.postgres</PackageId>
    <Title>Nextorm PostgreSQL provider</Title>
    <Description>PostgreSQL provider for Nextorm, a zero-SQL ORM for .NET: adds the PostgreSQL dialect (native DISTINCT ON fast paths, COPY bulk insert, version-gated syntax) and UsePostgres() over Npgsql.</Description>
    <PackageTags>$(PackageTags);postgresql;postgres;npgsql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\nextorm.core\nextorm.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
