<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>nextorm.mariadb</PackageId>
    <Title>Nextorm MariaDB provider</Title>
    <Description>MariaDB provider for Nextorm, a zero-SQL ORM for .NET: adds MariaDB's dialect differences (no source-level row locks, version-gated UPDATE ... RETURNING) and UseMariaDb() over MySqlConnector.</Description>
    <PackageTags>$(PackageTags);mariadb;mysql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\nextorm.mysql\nextorm.mysql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Public API tracking (issue #53, IF6). Every change to the public surface must be declared in
      PublicAPI.Unshipped.txt: RS0016 (member missing from the file) and RS0017 (stale entry) are
      build errors here, because the repository treats warnings as errors everywhere.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
