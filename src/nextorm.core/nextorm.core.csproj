<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>nextorm</PackageId>
    <Title>Nextorm</Title>
    <Description>A high performance ORM (object-relational mapping) library supporting PostgreSQL, SQL Server, MySQL, Sqlite</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="OneOf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The streaming wrappers (LobStream/LobTextReader) and CommandReaderOwner are internal; the
         core tests exercise the wrapper operations and the reader/command lifecycle directly. -->
    <InternalsVisibleTo Include="nextorm.core.tests" />
    <!-- The SQLite SQL-generation tests build the internal SqlBuilder/SqlBuildContext directly to
         assert the sequential-access locator seam (trailing rowid) without opening a connection. -->
    <InternalsVisibleTo Include="nextorm.sqlite.tests" />
  </ItemGroup>
</Project>
