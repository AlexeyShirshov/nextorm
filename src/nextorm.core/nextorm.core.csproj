<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>nextorm</PackageId>
    <Title>Nextorm</Title>
    <Description>A high performance ORM (object-relational mapping) library supporting PostgreSQL, SQL Server, MySQL, Sqlite</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="OneOf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The streaming wrappers (LobStream/LobTextReader) and CommandReaderOwner are internal; the
         core tests exercise the wrapper operations and the reader/command lifecycle directly. -->
    <InternalsVisibleTo Include="nextorm.core.tests" />
    <!-- The SQLite SQL-generation tests build the internal SqlBuilder/SqlBuildContext directly to
         assert the sequential-access locator seam (trailing rowid) without opening a connection. -->
    <InternalsVisibleTo Include="nextorm.sqlite.tests" />
    <!-- The ClickHouse SQL-generation tests render the internal JoinInto pair command so the
         parent-paging subquery (not just the denormalized query) is asserted. -->
    <InternalsVisibleTo Include="nextorm.clickhouse.tests" />
    <!-- The PostgreSQL/MySQL/SQL Server JoinInto SQL-generation tests render the internal pair command
         to assert the many-to-many derived junction shape without opening a connection. -->
    <InternalsVisibleTo Include="nextorm.postgres.tests" />
    <InternalsVisibleTo Include="nextorm.mysql.tests" />
    <InternalsVisibleTo Include="nextorm.sqlserver.tests" />
    <!-- The integration suite exercises the key form (BuildEntityCommand/UpdateEntity/DeleteEntity) of
         the DML builders, which is internal; the filter scope of the key form is asserted end to end. -->
    <InternalsVisibleTo Include="nextorm.integration.tests" />
    <!-- The ClickHouse provider re-exposes the ClickHouse-only fluent members (Final/PreWhere/Settings/
         LimitBy/WithTotals/ArrayJoin*/Semi|Anti|PasteJoin, FromOptions.Sample, JoinOptions.Global)
         as public extension methods over the now-internal instance members. -->
    <InternalsVisibleTo Include="nextorm.clickhouse" />
    <!-- The EF Core bridge stages its whole import and publishes it under the shared metadata
         registration gate, so a concurrent auto/configured registration or junction publication
         cannot clobber a bridged entry (and vice versa). -->
    <InternalsVisibleTo Include="nextorm.entityframeworkcore" />
  </ItemGroup>
</Project>
