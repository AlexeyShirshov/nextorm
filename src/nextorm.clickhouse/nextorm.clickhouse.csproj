<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>nextorm.clickhouse</PackageId>
    <Title>Nextorm ClickHouse provider</Title>
    <Description>ClickHouse provider for Nextorm, a zero-SQL ORM for .NET: adds the ClickHouse dialect (argMin/argMax fast paths) plus ClickHouse-only fluent members (Final, PreWhere, Sample, LimitBy) and UseClickHouse() over ClickHouse.Driver.</Description>
    <PackageTags>$(PackageTags);clickhouse;olap;analytics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\nextorm.core\nextorm.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Public API tracking (issue #53, IF6). Every change to the public surface must be declared in
      PublicAPI.Unshipped.txt: RS0016 (member missing from the file) and RS0017 (stale entry) are
      build errors here, because the repository treats warnings as errors everywhere.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
