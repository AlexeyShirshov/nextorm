<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>nextorm.clickhouse</PackageId>
    <Title>Nextorm ClickHouse provider</Title>
    <Description>ClickHouse provider for Nextorm, a zero-SQL ORM for .NET: adds the ClickHouse dialect (argMin/argMax fast paths) plus ClickHouse-only fluent members (Final, PreWhere, Sample, LimitBy) and UseClickHouse() over ClickHouse.Driver.</Description>
    <PackageTags>$(PackageTags);clickhouse;olap;analytics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\nextorm.core\nextorm.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
