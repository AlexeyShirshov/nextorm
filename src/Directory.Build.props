<Project>

  <!--
    A nested Directory.Build.props stops MSBuild's automatic upward search, so the repository-wide
    file must be imported explicitly. Everything below applies to the published libraries only.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Package validation is the packaged-output half of the API gate (issue #53): it compares the
      package's own assets (net10.0 vs net11.0) and, once a stable baseline exists, the published
      package it replaces. The source-tree half is PublicAPI.Shipped/Unshipped.txt next to each
      library .csproj. Baseline validation is skipped for prerelease baselines, so
      PackageValidationBaselineVersion is added when the first stable release (1.0.9) is on
      nuget.org: the next release is then gated against it.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Published packages ship one asset per supported consumer runtime. A net10.0 asset is also
      loadable from a net11.0 application, but multi-targeting keeps the packages buildable against
      future runtime-specific APIs and lets each consumer resolve its own nearest asset.
    -->
    <TargetFrameworks>$(NextormSupportedTargetFrameworks)</TargetFrameworks>
    <!--
      Search keywords for nuget.org. Providers append their own below with
      <PackageTags>$(PackageTags);...</PackageTags>, so keep the shared set here.
    -->
    <PackageTags>orm;sql;linq;micro-orm;data-access;query-builder;performance</PackageTags>
    <Authors>Alexey Shirshov</Authors>
    <Copyright>Alexey Shirshov</Copyright>
    <PackageReleaseNotes>https://github.com/AlexeyShirshov/nextorm/releases</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/AlexeyShirshov/nextorm</PackageProjectUrl>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <!-- Shared package icon; the file lives in assets/promo and is packed under its own name. -->
    <PackageIcon>nextorm-icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AlexeyShirshov/nextorm</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../assets/promo/nextorm-icon.png"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

</Project>
