<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>nextorm.sqlite</PackageId>
    <Title>Nextorm SQLite provider</Title>
    <Description>SQLite provider for Nextorm, a zero-SQL ORM for .NET: adds the SQLite dialect ($name parameters, limit/offset paging, custom aggregates) and UseSqlite() over Microsoft.Data.Sqlite.</Description>
    <PackageTags>$(PackageTags);sqlite;sqlite3;microsoft.data.sqlite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\nextorm.core\nextorm.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
