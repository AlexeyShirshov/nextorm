<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\nextorm.core\nextorm.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="nextorm.sqlserver.tests" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>nextorm.sqlserver</PackageId>
    <Title>Nextorm SQL Server provider</Title>
    <Description>Microsoft SQL Server and Azure SQL provider for Nextorm, a zero-SQL ORM for .NET: adds the T-SQL dialect (bracket-quoted identifiers, top/offset-fetch paging), MERGE and native SqlBulkCopy, and UseSqlServer() over Microsoft.Data.SqlClient.</Description>
    <PackageTags>$(PackageTags);sqlserver;mssql;t-sql;azure-sql</PackageTags>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
</Project>
